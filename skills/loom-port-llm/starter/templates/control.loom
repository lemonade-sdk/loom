func.def @check(%condition: i1) {
  %value = scalar.extui %condition : i1 to i32
  %error = global.load @invalid : buffer
  func.call @require(%value, %error) : (i32, buffer)
  func.return
}

func.def @equal(%a: buffer, %b: buffer) -> (i1) {
  %a_length = buffer.length %a
  %b_length = buffer.length %b
  %same_length = index.cmp eq, %a_length, %b_length : offset
  %same = scf.if %same_length -> (i1) {
    %c0 = index.constant 0 : offset
    %compared = buffer.compare %a[%c0], %b[%c0], %a_length
    %c0_i32 = scalar.constant 0 : i32
    %matches = scalar.cmpi eq, %compared, %c0_i32 : i32
    scf.yield %matches : i1
  } else {
    %false = scalar.constant false : i1
    scf.yield %false : i1
  }
  func.return %same : i1
}

func.def @join(%a: buffer, %b: buffer) -> (buffer) {
  %c0 = index.constant 0 : offset
  %a_length = buffer.length %a
  %b_length = buffer.length %b
  %length = index.add %a_length, %b_length : offset
  %output = buffer.alloca<private> align(1) %length : buffer
  buffer.copy %a[%c0], %output[%c0], %a_length
  buffer.copy %b[%c0], %output[%a_length], %b_length
  func.return %output : buffer
}

func.def @join4(%a: buffer, %b: buffer, %c: buffer, %d: buffer) -> (buffer) {
  %ab = func.call @join(%a, %b) : (buffer, buffer) -> (buffer)
  %cd = func.call @join(%c, %d) : (buffer, buffer) -> (buffer)
  %all = func.call @join(%ab, %cd) : (buffer, buffer) -> (buffer)
  func.return %all : buffer
}

func.def inline @tool_append(%output: buffer, %position: offset, %text: buffer) -> (offset) {
  %c0 = index.constant 0 : offset
  %length = buffer.length %text
  buffer.copy %text[%c0], %output[%position], %length
  %end = index.add %position, %length : offset
  func.return %end : offset
}

// Copy of text[begin, end).
func.def inline @slice(%text: buffer, %begin: offset, %end: offset) -> (buffer) {
  %c0 = index.constant 0 : offset
  %size = index.sub %end, %begin : offset
  %result = buffer.alloca<private> align(1) %size : buffer
  buffer.copy %text[%begin], %result[%c0], %size
  func.return %result : buffer
}

func.def @json_range(%text: buffer, %begin: i64, %length: i64) -> (buffer) {
  %bounded_begin = scalar.assume %begin [range(%begin, 0, 9223372036854775807)] : i64
  %bounded_length = scalar.assume %length [range(%length, 0, 9223372036854775807)] : i64
  %start = index.cast %bounded_begin : i64 to offset
  %size = index.cast %bounded_length : i64 to offset
  %c0 = index.constant 0 : offset
  %result = buffer.alloca<private> align(1) %size : buffer
  buffer.copy %text[%start], %result[%c0], %size
  func.return %result : buffer
}

// Decodes a JSON string range (without quotes).
func.def @json_key(%source: buffer, %begin: i64, %length: i64) -> (buffer) {
  %c0_i64 = scalar.constant 0 : i64
  %bounded_length = scalar.assume %length [range(%length, 0, 9223372036854775807)] : i64
  %size = index.cast %bounded_length : i64 to offset
  %storage = buffer.alloca<private> align(1) %size : buffer
  %decoded_length = func.call @unescape(%source, %begin, %length, %storage, %c0_i64) : (buffer, i64, i64, buffer, i64) -> (i64)
  %result = func.call @json_range(%storage, %c0_i64, %decoded_length) : (buffer, i64, i64) -> (buffer)
  func.return %result : buffer
}

func.def inline @text_is_space(%text: buffer, %position: offset) -> (i1) {
  %byte = buffer.load.i8.u %text[%position]
  %space = scalar.constant 32 : i32
  %tab = scalar.constant 9 : i32
  %carriage_return = scalar.constant 13 : i32
  %is_space = scalar.cmpi eq, %byte, %space : i32
  %after_tab = scalar.cmpi uge, %byte, %tab : i32
  %before_return = scalar.cmpi ule, %byte, %carriage_return : i32
  %control = scalar.andi %after_tab, %before_return : i1
  %result = scalar.ori %is_space, %control : i1
  func.return %result : i1
}

// First position >= %from where %marker starts and fits before %end; %end if none.
func.def inline @find(%text: buffer, %from: offset, %end: offset, %marker: buffer) -> (offset) {
  %c0 = index.constant 0 : offset
  %c1 = index.constant 1 : offset
  %zero = scalar.constant 0 : i32
  %false = scalar.constant false : i1
  %marker_length = buffer.length %marker
  %found = scf.while(%position = %from : offset) -> (offset) {
    %stop = index.add %position, %marker_length : offset
    %fits = index.cmp ule, %stop, %end : offset
    %continue = scf.if %fits -> (i1) {
      %compared = buffer.compare %text[%position], %marker[%c0], %marker_length
      %differs = scalar.cmpi ne, %compared, %zero : i32
      scf.yield %differs : i1
    } else {
      scf.yield %false : i1
    }
    scf.condition %continue, %position : i1, offset
  } do(%position: offset) {
    %next = index.add %position, %c1 : offset
    scf.yield %next : offset
  }
  %stop = index.add %found, %marker_length : offset
  %hit = index.cmp ule, %stop, %end : offset
  %result = scf.select %hit, %found, %end : offset
  func.return %result : offset
}

func.def inline @skip_space(%text: buffer, %from: offset, %end: offset) -> (offset) {
  %c1 = index.constant 1 : offset
  %false = scalar.constant false : i1
  %result = scf.while(%position = %from : offset) -> (offset) {
    %inside = index.cmp ult, %position, %end : offset
    %space = scf.if %inside -> (i1) {
      %value = func.call @text_is_space(%text, %position) : (buffer, offset) -> (i1)
      scf.yield %value : i1
    } else {
      scf.yield %false : i1
    }
    scf.condition %space, %position : i1, offset
  } do(%position: offset) {
    %next = index.add %position, %c1 : offset
    scf.yield %next : offset
  }
  func.return %result : offset
}

// End of trailing whitespace trimming: largest e in [begin, end] with text[e-1] not space.
func.def inline @trim_end(%text: buffer, %begin: offset, %end: offset) -> (offset) {
  %c1 = index.constant 1 : offset
  %false = scalar.constant false : i1
  %result = scf.while(%position = %end : offset) -> (offset) {
    %more = index.cmp ugt, %position, %begin : offset
    %space = scf.if %more -> (i1) {
      %last = index.sub %position, %c1 : offset
      %value = func.call @text_is_space(%text, %last) : (buffer, offset) -> (i1)
      scf.yield %value : i1
    } else {
      scf.yield %false : i1
    }
    scf.condition %space, %position : i1, offset
  } do(%position: offset) {
    %next = index.sub %position, %c1 : offset
    scf.yield %next : offset
  }
  func.return %result : offset
}

func.def inline @trim(%text: buffer) -> (buffer) {
  %c0 = index.constant 0 : offset
  %length = buffer.length %text
  %begin = func.call @skip_space(%text, %c0, %length) : (buffer, offset, offset) -> (offset)
  %end = func.call @trim_end(%text, %begin, %length) : (buffer, offset, offset) -> (offset)
  %result = func.call @slice(%text, %begin, %end) : (buffer, offset, offset) -> (buffer)
  func.return %result : buffer
}

func.def inline @byte_is(%text: buffer, %position: offset, %end: offset, %value: i32) -> (i1) {
  %inside = index.cmp ult, %position, %end : offset
  %result = scf.if %inside -> (i1) {
    %byte = buffer.load.i8.u %text[%position]
    %same = scalar.cmpi eq, %byte, %value : i32
    scf.yield %same : i1
  } else {
    %false = scalar.constant false : i1
    scf.yield %false : i1
  }
  func.return %result : i1
}

func.def public @model_name() -> (buffer) {
  %name = global.load @name : buffer
  func.return %name : buffer
}

