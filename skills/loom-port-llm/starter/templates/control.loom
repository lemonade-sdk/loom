// (reasoning supported, selectable efforts bitmap, default effort):
// efforts none=0 ... high=4; a toggleable thinking model offers none|high.
func.def public @chat_reasoning() -> (i32, i32, i32) {
  %supported = scalar.constant @@REASONING_SUPPORTED@@ : i32
  %efforts = scalar.constant @@REASONING_EFFORTS@@ : i32
  %default = scalar.constant @@REASONING_DEFAULT@@ : i32
  func.return %supported, %efforts, %default : i32, i32, i32
}

func.def public @chat_image_limits() -> (i64, i64, i64, i64, i64) {
  %maximum_count = scalar.constant 4 : i64
  %compressed_bytes = scalar.constant 1048576 : i64
  %width = scalar.constant 4096 : i64
  %height = scalar.constant 4096 : i64
  %pixels = scalar.constant 16777216 : i64
  func.return %maximum_count, %compressed_bytes, %width, %height, %pixels : i64, i64, i64, i64, i64
}

// Chat template, from the config "chat" block (build.py fills these):
// @@CHAT_COMMENT@@
global.rodata.def @system_prefix = bytes("@@HEX_SYSTEM_PREFIX@@")

global.rodata.def @user_prefix = bytes("@@HEX_USER_PREFIX@@")

global.rodata.def @assistant_prefix = bytes("@@HEX_ASSISTANT_PREFIX@@")

global.rodata.def @message_suffix = bytes("@@HEX_SUFFIX@@")

global.rodata.def @think_open = bytes("@@HEX_THINK_OPEN@@")

global.rodata.def @think_close = bytes("@@HEX_THINK_CLOSE@@")

global.rodata.def @generation_think = bytes("@@HEX_GENERATION_PROMPT@@")

global.rodata.def @generation_plain = bytes("@@HEX_GENERATION_PROMPT_PLAIN@@")

global.rodata.def @default_system = bytes("@@HEX_DEFAULT_SYSTEM@@")

global.rodata.def @bos = bytes("@@HEX_BOS@@")

global.rodata.def @tools_prefix = bytes("@@HEX_TOOLS_PREFIX@@")

global.rodata.def @tools_suffix = bytes("@@HEX_TOOLS_SUFFIX@@")

global.rodata.def @tool_line_prefix = bytes("@@HEX_TOOL_LINE_PREFIX@@")

global.rodata.def @tools_system_separator = bytes("@@HEX_TOOLS_SYSTEM_SEPARATOR@@")

global.rodata.def @tool_turn_prefix = bytes("@@HEX_TOOL_TURN_PREFIX@@")

global.rodata.def @tool_item_prefix = bytes("@@HEX_TOOL_ITEM_PREFIX@@")

global.rodata.def @tool_item_suffix = bytes("@@HEX_TOOL_ITEM_SUFFIX@@")

global.rodata.def @tool_turn_suffix = bytes("@@HEX_TOOL_TURN_SUFFIX@@")

global.rodata.def @content_call_separator = bytes("@@HEX_CONTENT_CALL_SEPARATOR@@")

global.rodata.def @call_separator = bytes("@@HEX_CALL_SEPARATOR@@")

// The tools JSON array as the template prints it: each tool object (or its
// "function" member when TOOLS_FUNCTION_ONLY), one per line.
global.rodata.def @function_key = bytes("66756e6374696f6e")

func.def @tool_printed(%tool: buffer) -> (buffer) {
  %only = scalar.constant @@TOOLS_FUNCTION_ONLY@@ : i1
  %result = scf.if %only -> (buffer) {
    %origin = index.constant 0 : offset
    %c0 = index.constant 0 : index
    %c1 = index.constant 1 : index
    %fields, %type, %count = func.call @members(%tool) : (buffer) -> (buffer, i32, i64)
    %bounded_count = scalar.assume %count [range(%count, 0, 2147483647)] : i64
    %extent = index.cast %bounded_count : i64 to index
    %records = buffer.view %fields[%origin] : buffer -> view<[%extent]x5xi64>
    %function_key = global.load @function_key : buffer
    %selected = scf.for %i = [%c0 to %extent step %c1](%current = %tool : buffer) -> (buffer) {
      %key_origin = view.load %records[%i, 0] : view<[%extent]x5xi64> -> i64
      %key_length = view.load %records[%i, 1] : view<[%extent]x5xi64> -> i64
      %key = func.call @json_key(%tool, %key_origin, %key_length) : (buffer, i64, i64) -> (buffer)
      %is_function = func.call @equal(%key, %function_key) : (buffer, buffer) -> (i1)
      %next = scf.if %is_function -> (buffer) {
        %value_origin = view.load %records[%i, 2] : view<[%extent]x5xi64> -> i64
        %value_length = view.load %records[%i, 3] : view<[%extent]x5xi64> -> i64
        %value = func.call @json_range(%tool, %value_origin, %value_length) : (buffer, i64, i64) -> (buffer)
        scf.yield %value : buffer
      } else {
        scf.yield %current : buffer
      }
      scf.yield %next : buffer
    }
    scf.yield %selected : buffer
  } else {
    scf.yield %tool : buffer
  }
  func.return %result : buffer
}

func.def @tools_body(%tools: buffer, %tool_fields: buffer, %tool_count: i64) -> (buffer) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %count = scalar.assume %tool_count [range(%tool_count, 1, 4096)] : i64
  %extent = index.cast %count : i64 to index
  %records = buffer.view %tool_fields[%origin] : buffer -> view<[%extent]x5xi64>
  %prefix = global.load @tools_prefix : buffer
  %suffix = global.load @tools_suffix : buffer
  %newline = global.load @tool_line_prefix : buffer
  %body = scf.for %i = [%c0 to %extent step %c1](%text = %prefix : buffer) -> (buffer) {
    %value_origin = view.load %records[%i, 2] : view<[%extent]x5xi64> -> i64
    %value_length = view.load %records[%i, 3] : view<[%extent]x5xi64> -> i64
    %value = func.call @json_range(%tools, %value_origin, %value_length) : (buffer, i64, i64) -> (buffer)
    %printed = func.call @tool_printed(%value) : (buffer) -> (buffer)
    %line = func.call @join(%newline, %printed) : (buffer, buffer) -> (buffer)
    %next = func.call @join(%text, %line) : (buffer, buffer) -> (buffer)
    scf.yield %next : buffer
  }
  %result = func.call @join(%body, %suffix) : (buffer, buffer) -> (buffer)
  func.return %result : buffer
}

// Returns (found, value range begin, length, type) of %key in the object at
// %text[begin, begin + length).
func.def @json_lookup(%text: buffer, %begin: i64, %length: i64, %key: buffer) -> (i1, i64, i64, i64) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %zero64 = scalar.constant 0 : i64
  %false = scalar.constant false : i1
  %fields, %type, %count = func.call @members_range(%text, %begin, %length) : (buffer, i64, i64) -> (buffer, i32, i64)
  %object = scalar.constant 2 : i32
  %is_object = scalar.cmpi eq, %type, %object : i32
  %usable_count = scf.select %is_object, %count, %zero64 : i64
  %bounded_count = scalar.assume %usable_count [range(%usable_count, 0, 2147483647)] : i64
  %extent = index.cast %bounded_count : i64 to index
  %records = buffer.view %fields[%origin] : buffer -> view<[%extent]x5xi64>
  %found, %value_begin, %value_length, %value_type = scf.for %i = [%c0 to %extent step %c1](%f = %false : i1, %b = %zero64 : i64, %l = %zero64 : i64, %t = %zero64 : i64) -> (i1, i64, i64, i64) {
    %key_origin = view.load %records[%i, 0] : view<[%extent]x5xi64> -> i64
    %key_length = view.load %records[%i, 1] : view<[%extent]x5xi64> -> i64
    %name = func.call @json_key(%text, %key_origin, %key_length) : (buffer, i64, i64) -> (buffer)
    %match = func.call @equal(%name, %key) : (buffer, buffer) -> (i1)
    %vb = view.load %records[%i, 2] : view<[%extent]x5xi64> -> i64
    %vl = view.load %records[%i, 3] : view<[%extent]x5xi64> -> i64
    %vt = view.load %records[%i, 4] : view<[%extent]x5xi64> -> i64
    %nf = scalar.ori %f, %match : i1
    %nb = scf.select %match, %vb, %b : i64
    %nl = scf.select %match, %vl, %l : i64
    %nt = scf.select %match, %vt, %t : i64
    scf.yield %nf, %nb, %nl, %nt : i1, i64, i64, i64
  }
  func.return %found, %value_begin, %value_length, %value_type : i1, i64, i64, i64
}

// Thinking selection from a value: true/false, or a reasoning_effort string.
func.def @thinking_value(%request: buffer, %found: i1, %begin: i64, %length: i64, %type: i64, %effort: i1, %current: i1) -> (i1) {
  %result = scf.if %found -> (i1) {
    %selected = scf.if %effort -> (i1) {
      %value = func.call @json_key(%request, %begin, %length) : (buffer, i64, i64) -> (buffer)
      %none = global.load @effort_none : buffer
      %is_none = func.call @equal(%value, %none) : (buffer, buffer) -> (i1)
      %false = scalar.constant false : i1
      %on = scalar.cmpi eq, %is_none, %false : i1
      scf.yield %on : i1
    } else {
      %true_type = scalar.constant 4 : i64
      %on = scalar.cmpi eq, %type, %true_type : i64
      scf.yield %on : i1
    }
    scf.yield %selected : i1
  } else {
    scf.yield %current : i1
  }
  func.return %result : i1
}

// 1 + index of the last "user" message in the request's messages array (0: none).
func.def @last_user(%request: buffer, %begin: i64, %length: i64) -> (i64) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %zero64 = scalar.constant 0 : i64
  %one64 = scalar.constant 1 : i64
  %elements, %type, %count = func.call @members_range(%request, %begin, %length) : (buffer, i64, i64) -> (buffer, i32, i64)
  %bounded_count = scalar.assume %count [range(%count, 0, 2147483647)] : i64
  %extent = index.cast %bounded_count : i64 to index
  %records = buffer.view %elements[%origin] : buffer -> view<[%extent]x5xi64>
  %role_key = global.load @role_key : buffer
  %user_role = global.load @user : buffer
  %object_type = scalar.constant 2 : i64
  %result = scf.for %i = [%c0 to %extent step %c1](%last = %zero64 : i64) -> (i64) {
    %mb = view.load %records[%i, 2] : view<[%extent]x5xi64> -> i64
    %ml = view.load %records[%i, 3] : view<[%extent]x5xi64> -> i64
    %mt = view.load %records[%i, 4] : view<[%extent]x5xi64> -> i64
    %is_object = scalar.cmpi eq, %mt, %object_type : i64
    %next = scf.if %is_object -> (i64) {
      %fr, %br, %lr, %tr = func.call @json_lookup(%request, %mb, %ml, %role_key) : (buffer, i64, i64, buffer) -> (i1, i64, i64, i64)
      %role = func.call @json_key(%request, %br, %lr) : (buffer, i64, i64) -> (buffer)
      %is_user = func.call @equal(%role, %user_role) : (buffer, buffer) -> (i1)
      %index = index.cast %i : index to i64
      %ordinal = scalar.addi %index, %one64 : i64
      %value = scf.select %is_user, %ordinal, %last : i64
      scf.yield %value : i64
    } else {
      scf.yield %last : i64
    }
    scf.yield %next : i64
  }
  func.return %result : i64
}

// State bits carried through chat_message (opaque to the host):
//   0-1 previous role (0 none, 1 user, 2 assistant, 3 tool)
//   2   the first system message was already rendered by chat_begin
//   4   thinking enabled for the generation prompt
//   8+  1 + index of the last user message (0: none); reasoning is rendered
//       only after it when HISTORY_THINK_AFTER_QUERY (Qwen-style templates)
// chat_begin renders the system block whenever tools are present or the
// template has a default system prompt, merging the first system message's
// text in the template's order.
func.def public @chat_begin(%request: buffer, %tools: buffer) -> (buffer, i64) {
  %origin = index.constant 0 : offset
  %zero64 = scalar.constant 0 : i64
  %four64 = scalar.constant 4 : i64
  %sixteen64 = scalar.constant 16 : i64
  %false = scalar.constant false : i1
  %empty = global.load @empty : buffer
  %request_bytes = buffer.length %request
  %request_length = index.cast %request_bytes : offset to i64
  // Thinking: default, then enable_thinking, chat_template_kwargs.enable_thinking, reasoning_effort.
  %toggle = scalar.constant @@THINK_TOGGLE@@ : i1
  %think_default = scalar.constant @@THINK_DEFAULT@@ : i1
  %thinking_key = global.load @thinking_key : buffer
  %kwargs_key = global.load @kwargs_key : buffer
  %effort_key = global.load @effort_key : buffer
  %f1, %b1, %l1, %t1 = func.call @json_lookup(%request, %zero64, %request_length, %thinking_key) : (buffer, i64, i64, buffer) -> (i1, i64, i64, i64)
  %think1 = func.call @thinking_value(%request, %f1, %b1, %l1, %t1, %false, %think_default) : (buffer, i1, i64, i64, i64, i1, i1) -> (i1)
  %fk, %bk, %lk, %tk = func.call @json_lookup(%request, %zero64, %request_length, %kwargs_key) : (buffer, i64, i64, buffer) -> (i1, i64, i64, i64)
  %think2 = scf.if %fk -> (i1) {
    %f2, %b2, %l2, %t2 = func.call @json_lookup(%request, %bk, %lk, %thinking_key) : (buffer, i64, i64, buffer) -> (i1, i64, i64, i64)
    %value = func.call @thinking_value(%request, %f2, %b2, %l2, %t2, %false, %think1) : (buffer, i1, i64, i64, i64, i1, i1) -> (i1)
    scf.yield %value : i1
  } else {
    scf.yield %think1 : i1
  }
  %fe, %be, %le, %te = func.call @json_lookup(%request, %zero64, %request_length, %effort_key) : (buffer, i64, i64, buffer) -> (i1, i64, i64, i64)
  %string_type = scalar.constant 0 : i64
  %effort_string = scalar.cmpi eq, %te, %string_type : i64
  %use_effort = scalar.andi %fe, %effort_string : i1
  %true = scalar.constant true : i1
  %think3 = func.call @thinking_value(%request, %use_effort, %be, %le, %te, %true, %think2) : (buffer, i1, i64, i64, i64, i1, i1) -> (i1)
  %thinking = scf.select %toggle, %think3, %think_default : i1
  // First message: is it a system message with plain text content?
  %messages_key = global.load @messages_key : buffer
  %fm, %bm, %lm, %tm = func.call @json_lookup(%request, %zero64, %request_length, %messages_key) : (buffer, i64, i64, buffer) -> (i1, i64, i64, i64)
  %array_type = scalar.constant 3 : i64
  %is_array = scalar.cmpi eq, %tm, %array_type : i64
  %has_messages = scalar.andi %fm, %is_array : i1
  %first_system, %system_text = scf.if %has_messages -> (i1, buffer) {
    %elements, %etype, %ecount = func.call @members_range(%request, %bm, %lm) : (buffer, i64, i64) -> (buffer, i32, i64)
    %nonempty = scalar.cmpi ne, %ecount, %zero64 : i64
    %fs, %text = scf.if %nonempty -> (i1, buffer) {
      %records = buffer.view %elements[%origin] : buffer -> view<1x5xi64>
      %mb = view.load %records[0, 2] : view<1x5xi64> -> i64
      %ml = view.load %records[0, 3] : view<1x5xi64> -> i64
      %role_key = global.load @role_key : buffer
      %content_key = global.load @content_key : buffer
      %fr, %br, %lr, %tr = func.call @json_lookup(%request, %mb, %ml, %role_key) : (buffer, i64, i64, buffer) -> (i1, i64, i64, i64)
      %fc, %bc, %lc, %tc = func.call @json_lookup(%request, %mb, %ml, %content_key) : (buffer, i64, i64, buffer) -> (i1, i64, i64, i64)
      %role = func.call @json_key(%request, %br, %lr) : (buffer, i64, i64) -> (buffer)
      %system_role = global.load @system : buffer
      %is_system = func.call @equal(%role, %system_role) : (buffer, buffer) -> (i1)
      %content_string = scalar.cmpi eq, %tc, %string_type : i64
      %plain = scalar.andi %fc, %content_string : i1
      %system_plain = scalar.andi %is_system, %plain : i1
      %value = scf.if %system_plain -> (buffer) {
        %decoded = func.call @json_key(%request, %bc, %lc) : (buffer, i64, i64) -> (buffer)
        scf.yield %decoded : buffer
      } else {
        scf.yield %empty : buffer
      }
      scf.yield %system_plain, %value : i1, buffer
    } else {
      scf.yield %false, %empty : i1, buffer
    }
    scf.yield %fs, %text : i1, buffer
  } else {
    scf.yield %false, %empty : i1, buffer
  }
  %last_query = scf.if %has_messages -> (i64) {
    %value = func.call @last_user(%request, %bm, %lm) : (buffer, i64, i64) -> (i64)
    scf.yield %value : i64
  } else {
    scf.yield %zero64 : i64
  }
  %trim_content = scalar.constant @@TRIM_CONTENT@@ : i1
  %trimmed_system = scf.if %trim_content -> (buffer) {
    %value = func.call @trim(%system_text) : (buffer) -> (buffer)
    scf.yield %value : buffer
  } else {
    scf.yield %system_text : buffer
  }
  %default_system = global.load @default_system : buffer
  %default_length = buffer.length %default_system
  %has_default = index.cmp ne, %default_length, %origin : offset
  %not_first_system = scalar.cmpi eq, %first_system, %false : i1
  %use_default = scalar.andi %not_first_system, %has_default : i1
  %system_body = scf.select %use_default, %default_system, %trimmed_system : buffer
  %tool_fields, %tool_type, %tool_count = func.call @members(%tools) : (buffer) -> (buffer, i32, i64)
  %has_tools = scalar.cmpi ne, %tool_count, %zero64 : i64
  %system_prefix = global.load @system_prefix : buffer
  %suffix = global.load @message_suffix : buffer
  %rendered = scf.if %has_tools -> (buffer) {
    %tools_text = func.call @tools_body(%tools, %tool_fields, %tool_count) : (buffer, buffer, i64) -> (buffer)
    %body_length = buffer.length %system_body
    %has_body = index.cmp ne, %body_length, %origin : offset
    %separator_value = global.load @tools_system_separator : buffer
    %separator = scf.select %has_body, %separator_value, %empty : buffer
    %after_system = scalar.constant @@TOOLS_AFTER_SYSTEM@@ : i1
    %merged = scf.if %after_system -> (buffer) {
      %value = func.call @join4(%system_body, %separator, %tools_text, %empty) : (buffer, buffer, buffer, buffer) -> (buffer)
      scf.yield %value : buffer
    } else {
      %value = func.call @join4(%tools_text, %separator, %system_body, %empty) : (buffer, buffer, buffer, buffer) -> (buffer)
      scf.yield %value : buffer
    }
    %block = func.call @join4(%system_prefix, %merged, %suffix, %empty) : (buffer, buffer, buffer, buffer) -> (buffer)
    scf.yield %block : buffer
  } else {
    %block = scf.if %use_default -> (buffer) {
      %value = func.call @join4(%system_prefix, %default_system, %suffix, %empty) : (buffer, buffer, buffer, buffer) -> (buffer)
      scf.yield %value : buffer
    } else {
      scf.yield %empty : buffer
    }
    scf.yield %block : buffer
  }
  %bos = global.load @bos : buffer
  %prefixed = func.call @join(%bos, %rendered) : (buffer, buffer) -> (buffer)
  %consumed = scalar.andi %has_tools, %first_system : i1
  %consumed_bit = scf.select %consumed, %four64, %zero64 : i64
  %thinking_bit = scf.select %thinking, %sixteen64, %zero64 : i64
  %flags = scalar.ori %consumed_bit, %thinking_bit : i64
  %shift = scalar.constant 8 : i64
  %query_bits = scalar.shli %last_query, %shift : i64
  %state = scalar.ori %flags, %query_bits : i64
  func.return %prefixed, %state : buffer, i64
}

// Text-only content parts (kind 0) are concatenated; image parts are rejected.
func.def @text_parts(%content: buffer, %parts: buffer, %part_count: i64) -> (buffer) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %text_kind = scalar.constant 0 : i32
  %bounded_count = scalar.assume %part_count [range(%part_count, 1, 4096)] : i64
  %count = index.cast %bounded_count : i64 to index
  %records = buffer.view %parts[%origin] : buffer -> view<[%count]x6xi32>
  %empty = global.load @empty : buffer
  %result = scf.for %i = [%c0 to %count step %c1](%text = %empty : buffer) -> (buffer) {
    %kind = view.load %records[%i, 0] : view<[%count]x6xi32> -> i32
    %is_text = scalar.cmpi eq, %kind, %text_kind : i32
    func.call @check(%is_text) : (i1)
    %source32 = view.load %records[%i, 1] : view<[%count]x6xi32> -> i32
    %length32 = view.load %records[%i, 2] : view<[%count]x6xi32> -> i32
    %source64 = scalar.extui %source32 : i32 to i64
    %length64 = scalar.extui %length32 : i32 to i64
    %piece = func.call @json_range(%content, %source64, %length64) : (buffer, i64, i64) -> (buffer)
    %next = func.call @join(%text, %piece) : (buffer, buffer) -> (buffer)
    scf.yield %next : buffer
  }
  func.return %result : buffer
}

// Renders one message. Host field bits: 1 reasoning_content, 2 tool_calls
// (assistant only), 4 tool_call_id (tool only). %calls holds the
// concatenated render_tool output of the assistant's tool calls.
func.def public @chat_message(%raw: buffer, %role: buffer, %content: buffer, %parts: buffer, %frames: buffer, %reasoning: buffer, %calls: buffer, %state: i64, %ordinal: i64, %fields: i64, %part_count: i64) -> (buffer, i64, buffer, i64) {
  %c0 = index.constant 0 : offset
  %zero64 = scalar.constant 0 : i64
  %one64 = scalar.constant 1 : i64
  %two64 = scalar.constant 2 : i64
  %three64 = scalar.constant 3 : i64
  %four64 = scalar.constant 4 : i64
  %keep_mask = scalar.constant -4 : i64
  %false = scalar.constant false : i1
  %assistant_role = global.load @assistant : buffer
  %user_role = global.load @user : buffer
  %system_role = global.load @system : buffer
  %tool_role = global.load @tool_role : buffer
  %assistant = func.call @equal(%role, %assistant_role) : (buffer, buffer) -> (i1)
  %user = func.call @equal(%role, %user_role) : (buffer, buffer) -> (i1)
  %system = func.call @equal(%role, %system_role) : (buffer, buffer) -> (i1)
  %tool = func.call @equal(%role, %tool_role) : (buffer, buffer) -> (i1)
  %ordinary = scalar.ori %user, %system : i1
  %speaker = scalar.ori %assistant, %tool : i1
  %supported = scalar.ori %ordinary, %speaker : i1
  %assistant_fields = scalar.andi %fields, %three64 : i64
  %has_assistant_fields = scalar.cmpi ne, %assistant_fields, %zero64 : i64
  %not_assistant_fields = scalar.cmpi eq, %has_assistant_fields, %false : i1
  %valid_assistant_fields = scalar.ori %assistant, %not_assistant_fields : i1
  %valid = scalar.andi %supported, %valid_assistant_fields : i1
  func.call @check(%valid) : (i1)
  %has_parts = scalar.cmpi ne, %part_count, %zero64 : i64
  %raw_text = scf.if %has_parts -> (buffer) {
    %joined = func.call @text_parts(%content, %parts, %part_count) : (buffer, buffer, i64) -> (buffer)
    scf.yield %joined : buffer
  } else {
    scf.yield %content : buffer
  }
  %trim_content = scalar.constant @@TRIM_CONTENT@@ : i1
  %text = scf.if %trim_content -> (buffer) {
    %value = func.call @trim(%raw_text) : (buffer) -> (buffer)
    scf.yield %value : buffer
  } else {
    scf.yield %raw_text : buffer
  }
  %empty = global.load @empty : buffer
  %prior_role = scalar.andi %state, %three64 : i64
  %prior_tool = scalar.cmpi eq, %prior_role, %three64 : i64
  %not_tool = scalar.cmpi eq, %tool, %false : i1
  %close_tools = scalar.andi %prior_tool, %not_tool : i1
  %tool_turn_suffix = global.load @tool_turn_suffix : buffer
  %before = scf.select %close_tools, %tool_turn_suffix, %empty : buffer
  %first = scalar.cmpi eq, %ordinal, %zero64 : i64
  %consumed_bit = scalar.andi %state, %four64 : i64
  %consumed = scalar.cmpi ne, %consumed_bit, %zero64 : i64
  %first_system = scalar.andi %first, %system : i1
  %skip = scalar.andi %first_system, %consumed : i1
  %suffix = global.load @message_suffix : buffer
  %body = scf.if %skip -> (buffer) {
    scf.yield %empty : buffer
  } else {
    %rendered = scf.if %tool -> (buffer) {
      %turn = global.load @tool_turn_prefix : buffer
      %open = scf.select %prior_tool, %empty, %turn : buffer
      %item_prefix = global.load @tool_item_prefix : buffer
      %item_suffix = global.load @tool_item_suffix : buffer
      %value = func.call @join4(%open, %item_prefix, %text, %item_suffix) : (buffer, buffer, buffer, buffer) -> (buffer)
      scf.yield %value : buffer
    } else {
      %value = scf.if %assistant -> (buffer) {
        %prefix = global.load @assistant_prefix : buffer
        %thought = func.call @trim(%reasoning) : (buffer) -> (buffer)
        %thought_length = buffer.length %thought
        %has_thought = index.cmp ne, %thought_length, %c0 : offset
        %always = scalar.constant @@HISTORY_THINK_ALWAYS@@ : i1
        %wanted = scalar.ori %always, %has_thought : i1
        %shift = scalar.constant 8 : i64
        %last_query = scalar.shrui %state, %shift : i64
        %after_query = scalar.cmpi sge, %ordinal, %last_query : i64
        %scope_all = scalar.constant @@HISTORY_THINK_ALL@@ : i1
        %in_scope = scalar.ori %scope_all, %after_query : i1
        %show = scalar.andi %wanted, %in_scope : i1
        %think = scf.if %show -> (buffer) {
          %open = global.load @think_open : buffer
          %close = global.load @think_close : buffer
          %block = func.call @join4(%open, %thought, %close, %empty) : (buffer, buffer, buffer, buffer) -> (buffer)
          scf.yield %block : buffer
        } else {
          scf.yield %empty : buffer
        }
        %text_length = buffer.length %text
        %has_text = index.cmp ne, %text_length, %c0 : offset
        %calls_length = buffer.length %calls
        %has_calls = index.cmp ne, %calls_length, %c0 : offset
        %separate = scalar.andi %has_text, %has_calls : i1
        %separator_value = global.load @content_call_separator : buffer
        %separator = scf.select %separate, %separator_value, %empty : buffer
        %head = func.call @join4(%prefix, %think, %text, %separator) : (buffer, buffer, buffer, buffer) -> (buffer)
        %message = func.call @join4(%head, %calls, %suffix, %empty) : (buffer, buffer, buffer, buffer) -> (buffer)
        scf.yield %message : buffer
      } else {
        %system_prefix = global.load @system_prefix : buffer
        %user_prefix = global.load @user_prefix : buffer
        %prefix = scf.select %user, %user_prefix, %system_prefix : buffer
        %message = func.call @join4(%prefix, %text, %suffix, %empty) : (buffer, buffer, buffer, buffer) -> (buffer)
        scf.yield %message : buffer
      }
      scf.yield %value : buffer
    }
    scf.yield %rendered : buffer
  }
  %fragment = func.call @join(%before, %body) : (buffer, buffer) -> (buffer)
  %role_tool = scf.select %tool, %three64, %zero64 : i64
  %role_assistant = scf.select %assistant, %two64, %role_tool : i64
  %new_role = scf.select %user, %one64, %role_assistant : i64
  %kept = scalar.andi %state, %keep_mask : i64
  %next = scalar.ori %kept, %new_role : i64
  func.return %fragment, %next, %empty, %zero64 : buffer, i64, buffer, i64
}

// Output state 1 = inside the reasoning block, 0 = answer text.
func.def public @chat_end(%state: i64) -> (buffer, i64) {
  %zero64 = scalar.constant 0 : i64
  %three64 = scalar.constant 3 : i64
  %sixteen64 = scalar.constant 16 : i64
  %empty = global.load @empty : buffer
  %prior_role = scalar.andi %state, %three64 : i64
  %prior_tool = scalar.cmpi eq, %prior_role, %three64 : i64
  %tool_turn_suffix = global.load @tool_turn_suffix : buffer
  %before = scf.select %prior_tool, %tool_turn_suffix, %empty : buffer
  %thinking_bit = scalar.andi %state, %sixteen64 : i64
  %thinking = scalar.cmpi ne, %thinking_bit, %zero64 : i64
  %think_prompt = global.load @generation_think : buffer
  %plain_prompt = global.load @generation_plain : buffer
  %prompt = scf.select %thinking, %think_prompt, %plain_prompt : buffer
  %starts = scalar.constant @@START_STATE@@ : i64
  %output_state = scf.select %thinking, %starts, %zero64 : i64
  %result = func.call @join(%before, %prompt) : (buffer, buffer) -> (buffer)
  func.return %result, %output_state : buffer, i64
}

// ---- Tool calls --------------------------------------------------------------
// CALL_FORMAT: 1 = Hermes JSON (Qwen2.5/Qwen3: <tool_call>\n{"name": ..., "arguments": {...}}\n</tool_call>)
//              2 = Qwen XML (Qwen3-Coder/Qwen3.5: <tool_call>\n<function=NAME>\n<parameter=K>\nV\n</parameter>\n</function>\n</tool_call>)
//              3 = GLM (GLM-4.5+/Flint: <tool_call>NAME<arg_key>K</arg_key><arg_value>V</arg_value></tool_call>)
global.rodata.def @call_open = bytes("3c746f6f6c5f63616c6c3e")

global.rodata.def @call_close = bytes("3c2f746f6f6c5f63616c6c3e")

// '<tool_call>\n{"name": "', '", "arguments": ', '}\n</tool_call>'
global.rodata.def @hermes_open = bytes("3c746f6f6c5f63616c6c3e0a7b226e616d65223a2022")

global.rodata.def @hermes_middle = bytes("222c2022617267756d656e7473223a20")

global.rodata.def @hermes_close = bytes("7d0a3c2f746f6f6c5f63616c6c3e")

// '"name"', '"arguments"'
global.rodata.def @name_field = bytes("226e616d6522")

global.rodata.def @arguments_field = bytes("22617267756d656e747322")

// '<tool_call>\n<function=', '>\n', '<parameter=', '\n</parameter>\n', '</function>\n</tool_call>'
global.rodata.def @xml_call_open = bytes("3c746f6f6c5f63616c6c3e0a3c66756e6374696f6e3d")

global.rodata.def @xml_tag_end = bytes("3e0a")

global.rodata.def @xml_parameter_open = bytes("3c706172616d657465723d")

global.rodata.def @xml_parameter_close = bytes("0a3c2f706172616d657465723e0a")

global.rodata.def @xml_call_close = bytes("3c2f66756e6374696f6e3e0a3c2f746f6f6c5f63616c6c3e")

// '<arg_key>', '</arg_key>', '<arg_value>', '</arg_value>'
global.rodata.def @key_open = bytes("3c6172675f6b65793e")

global.rodata.def @key_close = bytes("3c2f6172675f6b65793e")

global.rodata.def @value_open = bytes("3c6172675f76616c75653e")

global.rodata.def @value_close = bytes("3c2f6172675f76616c75653e")

// '{"type":"function","function":{"name":"', '","arguments":"', '"}}'
global.rodata.def @record_open = bytes("7b2274797065223a2266756e6374696f6e222c2266756e6374696f6e223a7b226e616d65223a22")

global.rodata.def @record_middle = bytes("222c22617267756d656e7473223a22")

global.rodata.def @record_close = bytes("227d7d")

// Renders one call as the template prints it; %ordinal > 0 adds the separator
// between consecutive calls. Returns the buffer and its used length.
func.def public @render_tool(%name: buffer, %arguments: buffer, %ordinal: i64) -> (buffer, i64) {
  %zero64 = scalar.constant 0 : i64
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %format = scalar.constant @@CALL_FORMAT@@ : i32
  %hermes = scalar.constant 1 : i32
  %glm = scalar.constant 3 : i32
  %is_hermes = scalar.cmpi eq, %format, %hermes : i32
  %is_glm = scalar.cmpi eq, %format, %glm : i32
  %has_prior = scalar.cmpi ne, %ordinal, %zero64 : i64
  %separator_value = global.load @call_separator : buffer
  %empty = global.load @empty : buffer
  %separator = scf.select %has_prior, %separator_value, %empty : buffer
  %result = scf.if %is_hermes -> (buffer) {
    // Arguments are printed as the client sent them (the template prints a
    // string argument verbatim), so generated calls round-trip byte-exactly.
    %open = global.load @hermes_open : buffer
    %middle = global.load @hermes_middle : buffer
    %close = global.load @hermes_close : buffer
    %head = func.call @join4(%separator, %open, %name, %middle) : (buffer, buffer, buffer, buffer) -> (buffer)
    %value = func.call @join4(%head, %arguments, %close, %empty) : (buffer, buffer, buffer, buffer) -> (buffer)
    scf.yield %value : buffer
  } else {
    // Clients may reserialize arguments; compact keeps the history key stable.
    %compacted = func.call @compact(%arguments) : (buffer) -> (buffer)
    %members, %type, %count = func.call @members(%compacted) : (buffer) -> (buffer, i32, i64)
    %object = scalar.constant 2 : i32
    %is_object = scalar.cmpi eq, %type, %object : i32
    func.call @check(%is_object) : (i1)
    %bounded_count = scalar.assume %count [range(%count, 0, 33554431)] : i64
    %extent = index.cast %bounded_count : i64 to index
    %fields = buffer.view %members[%origin] : buffer -> view<[%extent]x5xi64>
    %xml_open = global.load @xml_call_open : buffer
    %tag_end = global.load @xml_tag_end : buffer
    %xml_key = global.load @xml_parameter_open : buffer
    %xml_value_close = global.load @xml_parameter_close : buffer
    %xml_close = global.load @xml_call_close : buffer
    %glm_open = global.load @call_open : buffer
    %glm_close = global.load @call_close : buffer
    %glm_key = global.load @key_open : buffer
    %glm_key_close = global.load @key_close : buffer
    %glm_value = global.load @value_open : buffer
    %glm_value_close = global.load @value_close : buffer
    %call_open = scf.select %is_glm, %glm_open, %xml_open : buffer
    %name_end = scf.select %is_glm, %empty, %tag_end : buffer
    %key_open = scf.select %is_glm, %glm_key, %xml_key : buffer
    %glm_key_end = func.call @join(%glm_key_close, %glm_value) : (buffer, buffer) -> (buffer)
    %key_end = scf.select %is_glm, %glm_key_end, %tag_end : buffer
    %value_end = scf.select %is_glm, %glm_value_close, %xml_value_close : buffer
    %call_close = scf.select %is_glm, %glm_close, %xml_close : buffer
    %head = func.call @join4(%separator, %call_open, %name, %name_end) : (buffer, buffer, buffer, buffer) -> (buffer)
    %body = scf.for %i = [%c0 to %extent step %c1](%text = %head : buffer) -> (buffer) {
      %key_begin = view.load %fields[%i, 0] : view<[%extent]x5xi64> -> i64
      %key_length = view.load %fields[%i, 1] : view<[%extent]x5xi64> -> i64
      %value_begin = view.load %fields[%i, 2] : view<[%extent]x5xi64> -> i64
      %value_length = view.load %fields[%i, 3] : view<[%extent]x5xi64> -> i64
      %value_type = view.load %fields[%i, 4] : view<[%extent]x5xi64> -> i64
      %key = func.call @json_key(%compacted, %key_begin, %key_length) : (buffer, i64, i64) -> (buffer)
      %is_string = scalar.cmpi eq, %value_type, %zero64 : i64
      %value = scf.if %is_string -> (buffer) {
        %decoded = func.call @json_key(%compacted, %value_begin, %value_length) : (buffer, i64, i64) -> (buffer)
        scf.yield %decoded : buffer
      } else {
        %raw = func.call @json_range(%compacted, %value_begin, %value_length) : (buffer, i64, i64) -> (buffer)
        scf.yield %raw : buffer
      }
      %opened = func.call @join4(%text, %key_open, %key, %key_end) : (buffer, buffer, buffer, buffer) -> (buffer)
      %next = func.call @join4(%opened, %value, %value_end, %empty) : (buffer, buffer, buffer, buffer) -> (buffer)
      scf.yield %next : buffer
    }
    %value = func.call @join(%body, %call_close) : (buffer, buffer) -> (buffer)
    scf.yield %value : buffer
  }
  %length_bytes = buffer.length %result
  %length = index.cast %length_bytes : offset to i64
  func.return %result, %length : buffer, i64
}

// Text after the last complete </tool_call> belongs to no call; like common
// OpenAI-compatible parsers, it is dropped instead of failing the turn.
func.def @through_last_call(%response: buffer) -> (buffer) {
  %origin = index.constant 0 : offset
  %close = global.load @call_close : buffer
  %close_length = buffer.length %close
  %length = buffer.length %response
  %scanned, %last = scf.while(%state = %origin : offset, %found = %origin : offset) -> (offset, offset) {
    %position = func.call @find(%response, %state, %length, %close) : (buffer, offset, offset, buffer) -> (offset)
    %hit = index.cmp ult, %position, %length : offset
    %after = index.add %position, %close_length : offset
    %next_found = scf.select %hit, %after, %found : offset
    scf.condition %hit, %after, %next_found : i1, offset, offset
  } do(%state: offset, %found: offset) {
    scf.yield %state, %found : offset, offset
  }
  %matched = index.cmp ne, %last, %origin : offset
  %result = scf.if %matched -> (buffer) {
    %prefix = func.call @slice(%response, %origin, %last) : (buffer, offset, offset) -> (buffer)
    scf.yield %prefix : buffer
  } else {
    scf.yield %response : buffer
  }
  func.return %result : buffer
}

// Appends text[begin, end) as JSON string content.
func.def @json_escape(%text: buffer, %begin: offset, %end: offset, %output: buffer, %position: offset) -> (offset) {
  %c1 = index.constant 1 : offset
  %c2 = index.constant 2 : offset
  %quote = scalar.constant 34 : i32
  %backslash = scalar.constant 92 : i32
  %newline = scalar.constant 10 : i32
  %return = scalar.constant 13 : i32
  %tab = scalar.constant 9 : i32
  %space = scalar.constant 32 : i32
  %letter_n = scalar.constant 110 : i32
  %letter_r = scalar.constant 114 : i32
  %letter_t = scalar.constant 116 : i32
  %final_in, %final_out = scf.while(%in = %begin : offset, %out = %position : offset) -> (offset, offset) {
    %more = index.cmp ult, %in, %end : offset
    scf.condition %more, %in, %out : i1, offset, offset
  } do(%in: offset, %out: offset) {
    %byte = buffer.load.i8.u %text[%in]
    %is_quote = scalar.cmpi eq, %byte, %quote : i32
    %is_backslash = scalar.cmpi eq, %byte, %backslash : i32
    %is_newline = scalar.cmpi eq, %byte, %newline : i32
    %is_return = scalar.cmpi eq, %byte, %return : i32
    %is_tab = scalar.cmpi eq, %byte, %tab : i32
    %is_control = scalar.cmpi ult, %byte, %space : i32
    %literal = scalar.ori %is_quote, %is_backslash : i1
    %letter_rt = scf.select %is_return, %letter_r, %letter_t : i32
    %letter = scf.select %is_newline, %letter_n, %letter_rt : i32
    %named_a = scalar.ori %is_newline, %is_return : i1
    %named = scalar.ori %named_a, %is_tab : i1
    %escaped = scalar.ori %literal, %named : i1
    %second = scf.select %literal, %byte, %letter : i32
    %written = scf.if %escaped -> (offset) {
      buffer.store.i8 %backslash, %output[%out]
      %next_out = index.add %out, %c1 : offset
      buffer.store.i8 %second, %output[%next_out]
      %after = index.add %out, %c2 : offset
      scf.yield %after : offset
    } else {
      // Other control bytes are invalid in JSON text; they become spaces.
      %plain = scf.select %is_control, %space, %byte : i32
      buffer.store.i8 %plain, %output[%out]
      %after = index.add %out, %c1 : offset
      scf.yield %after : offset
    }
    %next_in = index.add %in, %c1 : offset
    scf.yield %next_in, %written : offset, offset
  }
  func.return %final_out : offset
}

// End (exclusive) of the JSON string whose content starts at %from.
func.def inline @string_end(%text: buffer, %from: offset, %end: offset) -> (offset) {
  %c1 = index.constant 1 : offset
  %c2 = index.constant 2 : offset
  %quote = scalar.constant 34 : i32
  %backslash = scalar.constant 92 : i32
  %result = scf.while(%position = %from : offset) -> (offset) {
    %inside = index.cmp ult, %position, %end : offset
    %continue = scf.if %inside -> (i1) {
      %byte = buffer.load.i8.u %text[%position]
      %closing = scalar.cmpi eq, %byte, %quote : i32
      %false = scalar.constant false : i1
      %open = scalar.cmpi eq, %closing, %false : i1
      scf.yield %open : i1
    } else {
      %false = scalar.constant false : i1
      scf.yield %false : i1
    }
    scf.condition %continue, %position : i1, offset
  } do(%position: offset) {
    %byte = buffer.load.i8.u %text[%position]
    %escape = scalar.cmpi eq, %byte, %backslash : i32
    %step = scf.select %escape, %c2, %c1 : offset
    %next = index.add %position, %step : offset
    scf.yield %next : offset
  }
  %bounded = index.cmp ult, %result, %end : offset
  %final = scf.select %bounded, %result, %end : offset
  func.return %final : offset
}

// Hermes JSON calls, scanned without a JSON parser so a malformed call never
// fails the request: arguments are returned as generated (possibly invalid
// JSON) for the harness to handle. Unfinished calls are omitted.
func.def @hermes_calls(%response: buffer) -> (buffer) {
  %origin = index.constant 0 : offset
  %c1 = index.constant 1 : offset
  %c64 = index.constant 64 : offset
  %colon = scalar.constant 58 : i32
  %quote = scalar.constant 34 : i32
  %brace = scalar.constant 125 : i32
  %false = scalar.constant false : i1
  %true = scalar.constant true : i1
  %length = buffer.length %response
  %twice = index.add %length, %length : offset
  %scaled = index.add %twice, %twice : offset
  %capacity = index.add %scaled, %c64 : offset
  %output = buffer.alloca<private> align(1) %capacity : buffer
  %open_bracket = scalar.constant 91 : i32
  %close_bracket = scalar.constant 93 : i32
  %comma = scalar.constant 44 : i32
  buffer.store.i8 %open_bracket, %output[%origin]
  %call_open = global.load @call_open : buffer
  %call_close = global.load @call_close : buffer
  %open_length = buffer.length %call_open
  %close_length = buffer.length %call_close
  %name_field = global.load @name_field : buffer
  %arguments_field = global.load @arguments_field : buffer
  %name_field_length = buffer.length %name_field
  %arguments_field_length = buffer.length %arguments_field
  %record_open = global.load @record_open : buffer
  %record_middle = global.load @record_middle : buffer
  %record_close = global.load @record_close : buffer
  %final_position, %final_out, %final_first = scf.while(%position = %origin : offset, %out = %c1 : offset, %first = %true : i1) -> (offset, offset, i1) {
    %start = func.call @find(%response, %position, %length, %call_open) : (buffer, offset, offset, buffer) -> (offset)
    %has_start = index.cmp ult, %start, %length : offset
    %body_begin = index.add %start, %open_length : offset
    %body_from = scf.select %has_start, %body_begin, %length : offset
    %stop = func.call @find(%response, %body_from, %length, %call_close) : (buffer, offset, offset, buffer) -> (offset)
    %has_stop = index.cmp ult, %stop, %length : offset
    %complete = scalar.andi %has_start, %has_stop : i1
    scf.condition %complete, %position, %out, %first : i1, offset, offset, i1
  } do(%position: offset, %out: offset, %first: i1) {
    %start = func.call @find(%response, %position, %length, %call_open) : (buffer, offset, offset, buffer) -> (offset)
    %body_begin = index.add %start, %open_length : offset
    %stop = func.call @find(%response, %body_begin, %length, %call_close) : (buffer, offset, offset, buffer) -> (offset)
    // "name": "<value>"
    %name_key = func.call @find(%response, %body_begin, %stop, %name_field) : (buffer, offset, offset, buffer) -> (offset)
    %after_name_key = index.add %name_key, %name_field_length : offset
    %name_colon = func.call @skip_space(%response, %after_name_key, %stop) : (buffer, offset, offset) -> (offset)
    %has_name_colon = func.call @byte_is(%response, %name_colon, %stop, %colon) : (buffer, offset, offset, i32) -> (i1)
    %after_name_colon = index.add %name_colon, %c1 : offset
    %name_quote = func.call @skip_space(%response, %after_name_colon, %stop) : (buffer, offset, offset) -> (offset)
    %has_name_quote = func.call @byte_is(%response, %name_quote, %stop, %quote) : (buffer, offset, offset, i32) -> (i1)
    %name_begin = index.add %name_quote, %c1 : offset
    %name_end = func.call @string_end(%response, %name_begin, %stop) : (buffer, offset, offset) -> (offset)
    %name_ok_a = scalar.andi %has_name_colon, %has_name_quote : i1
    %name_closed = index.cmp ult, %name_end, %stop : offset
    %name_ok = scalar.andi %name_ok_a, %name_closed : i1
    // "arguments": <value> up to the object's closing brace.
    %arguments_key = func.call @find(%response, %body_begin, %stop, %arguments_field) : (buffer, offset, offset, buffer) -> (offset)
    %after_arguments_key = index.add %arguments_key, %arguments_field_length : offset
    %arguments_colon = func.call @skip_space(%response, %after_arguments_key, %stop) : (buffer, offset, offset) -> (offset)
    %has_arguments_colon = func.call @byte_is(%response, %arguments_colon, %stop, %colon) : (buffer, offset, offset, i32) -> (i1)
    %after_arguments_colon = index.add %arguments_colon, %c1 : offset
    %value_begin = func.call @skip_space(%response, %after_arguments_colon, %stop) : (buffer, offset, offset) -> (offset)
    %body_end = func.call @trim_end(%response, %value_begin, %stop) : (buffer, offset, offset) -> (offset)
    %last = index.sub %body_end, %c1 : offset
    %ends_object = func.call @byte_is(%response, %last, %stop, %brace) : (buffer, offset, offset, i32) -> (i1)
    %inner_end = scf.select %ends_object, %last, %body_end : offset
    %value_end = func.call @trim_end(%response, %value_begin, %inner_end) : (buffer, offset, offset) -> (offset)
    %has_value = index.cmp ult, %value_begin, %value_end : offset
    %arguments_ok_a = scalar.andi %has_arguments_colon, %has_value : i1
    %arguments_ok = scalar.andi %arguments_ok_a, %ends_object : i1
    %ok = scalar.andi %name_ok, %arguments_ok : i1
    %written, %next_first = scf.if %ok -> (offset, i1) {
      %separated = scf.if %first -> (offset) {
        scf.yield %out : offset
      } else {
        buffer.store.i8 %comma, %output[%out]
        %after = index.add %out, %c1 : offset
        scf.yield %after : offset
      }
      %after_open = func.call @tool_append(%output, %separated, %record_open) : (buffer, offset, buffer) -> (offset)
      // The name is already JSON string content.
      %name_bytes = index.sub %name_end, %name_begin : offset
      buffer.copy %response[%name_begin], %output[%after_open], %name_bytes
      %after_name = index.add %after_open, %name_bytes : offset
      %after_middle = func.call @tool_append(%output, %after_name, %record_middle) : (buffer, offset, buffer) -> (offset)
      // A string-valued "arguments" is already escaped JSON text.
      %string_value = func.call @byte_is(%response, %value_begin, %value_end, %quote) : (buffer, offset, offset, i32) -> (i1)
      %after_value = scf.if %string_value -> (offset) {
        %inner_begin = index.add %value_begin, %c1 : offset
        %inner_stop = index.sub %value_end, %c1 : offset
        %inner_bytes = index.sub %inner_stop, %inner_begin : offset
        buffer.copy %response[%inner_begin], %output[%after_middle], %inner_bytes
        %moved = index.add %after_middle, %inner_bytes : offset
        scf.yield %moved : offset
      } else {
        %moved = func.call @json_escape(%response, %value_begin, %value_end, %output, %after_middle) : (buffer, offset, offset, buffer, offset) -> (offset)
        scf.yield %moved : offset
      }
      %after_record = func.call @tool_append(%output, %after_value, %record_close) : (buffer, offset, buffer) -> (offset)
      scf.yield %after_record, %false : offset, i1
    } else {
      scf.yield %out, %first : offset, i1
    }
    %next_position = index.add %stop, %close_length : offset
    scf.yield %next_position, %written, %next_first : offset, offset, i1
  }
  buffer.store.i8 %close_bracket, %output[%final_out]
  %used = index.add %final_out, %c1 : offset
  %result = func.call @slice(%output, %origin, %used) : (buffer, offset, offset) -> (buffer)
  func.return %result : buffer
}

// GLM spelling -> the host XML grammar: <tool_call>NAME<arg_key>K</arg_key>
// <arg_value>V</arg_value></tool_call> becomes <tool_call>\n<function=NAME>\n
// <parameter=K>\nV\n</parameter>\n</function>\n</tool_call>.
func.def inline @starts_at(%text: buffer, %position: offset, %marker: buffer) -> (i1) {
  %c0 = index.constant 0 : offset
  %length = buffer.length %text
  %marker_length = buffer.length %marker
  %stop = index.add %position, %marker_length : offset
  %inside = index.cmp ule, %stop, %length : offset
  %result = scf.if %inside -> (i1) {
    %compared = buffer.compare %text[%position], %marker[%c0], %marker_length
    %zero = scalar.constant 0 : i32
    %same = scalar.cmpi eq, %compared, %zero : i32
    scf.yield %same : i1
  } else {
    %false = scalar.constant false : i1
    scf.yield %false : i1
  }
  func.return %result : i1
}

func.def @glm_calls_to_xml(%response: buffer) -> (buffer) {
  %origin = index.constant 0 : offset
  %c1 = index.constant 1 : offset
  %c64 = index.constant 64 : offset
  %false = scalar.constant false : i1
  %true = scalar.constant true : i1
  %length = buffer.length %response
  %twice = index.add %length, %length : offset
  %scaled = index.add %twice, %length : offset
  %capacity = index.add %scaled, %c64 : offset
  %output = buffer.alloca<private> align(1) %capacity : buffer
  %call_open = global.load @call_open : buffer
  %call_close = global.load @call_close : buffer
  %key_open = global.load @key_open : buffer
  %key_close = global.load @key_close : buffer
  %value_open = global.load @value_open : buffer
  %value_close = global.load @value_close : buffer
  %xml_open = global.load @xml_call_open : buffer
  %tag_end = global.load @xml_tag_end : buffer
  %xml_key = global.load @xml_parameter_open : buffer
  %xml_value_close = global.load @xml_parameter_close : buffer
  %xml_close = global.load @xml_call_close : buffer
  %end, %written, %naming = scf.while(%position = %origin : offset, %out = %origin : offset, %open = %false : i1) -> (offset, offset, i1) {
    %more = index.cmp ult, %position, %length : offset
    scf.condition %more, %position, %out, %open : i1, offset, offset, i1
  } do(%position: offset, %out: offset, %open: i1) {
    %is_call_open = func.call @starts_at(%response, %position, %call_open) : (buffer, offset, buffer) -> (i1)
    %is_call_close = func.call @starts_at(%response, %position, %call_close) : (buffer, offset, buffer) -> (i1)
    %is_key_open = func.call @starts_at(%response, %position, %key_open) : (buffer, offset, buffer) -> (i1)
    %is_key_close = func.call @starts_at(%response, %position, %key_close) : (buffer, offset, buffer) -> (i1)
    %is_value_open = func.call @starts_at(%response, %position, %value_open) : (buffer, offset, buffer) -> (i1)
    %is_value_close = func.call @starts_at(%response, %position, %value_close) : (buffer, offset, buffer) -> (i1)
    // A function name is closed before its first parameter or the call end.
    %closes_name_a = scalar.ori %is_call_close, %is_key_open : i1
    %closes_name = scalar.andi %closes_name_a, %open : i1
    %named = scf.if %closes_name -> (offset) {
      %after = func.call @tool_append(%output, %out, %tag_end) : (buffer, offset, buffer) -> (offset)
      scf.yield %after : offset
    } else {
      scf.yield %out : offset
    }
    %p, %o, %n = scf.if %is_call_open -> (offset, offset, i1) {
      %after = func.call @tool_append(%output, %named, %xml_open) : (buffer, offset, buffer) -> (offset)
      %skip = buffer.length %call_open
      %next = index.add %position, %skip : offset
      scf.yield %next, %after, %true : offset, offset, i1
    } else {
      %p1, %o1, %n1 = scf.if %is_call_close -> (offset, offset, i1) {
        %after = func.call @tool_append(%output, %named, %xml_close) : (buffer, offset, buffer) -> (offset)
        %skip = buffer.length %call_close
        %next = index.add %position, %skip : offset
        scf.yield %next, %after, %false : offset, offset, i1
      } else {
        %p2, %o2, %n2 = scf.if %is_key_open -> (offset, offset, i1) {
          %after = func.call @tool_append(%output, %named, %xml_key) : (buffer, offset, buffer) -> (offset)
          %skip = buffer.length %key_open
          %next = index.add %position, %skip : offset
          scf.yield %next, %after, %false : offset, offset, i1
        } else {
          %p3, %o3, %n3 = scf.if %is_key_close -> (offset, offset, i1) {
            %after = func.call @tool_append(%output, %out, %tag_end) : (buffer, offset, buffer) -> (offset)
            %skip = buffer.length %key_close
            %next = index.add %position, %skip : offset
            scf.yield %next, %after, %open : offset, offset, i1
          } else {
            %p4, %o4, %n4 = scf.if %is_value_open -> (offset, offset, i1) {
              %skip = buffer.length %value_open
              %next = index.add %position, %skip : offset
              scf.yield %next, %out, %open : offset, offset, i1
            } else {
              %p5, %o5, %n5 = scf.if %is_value_close -> (offset, offset, i1) {
                %after = func.call @tool_append(%output, %out, %xml_value_close) : (buffer, offset, buffer) -> (offset)
                %skip = buffer.length %value_close
                %next = index.add %position, %skip : offset
                scf.yield %next, %after, %open : offset, offset, i1
              } else {
                // Ordinary byte: names drop whitespace, everything else copies.
                %space = func.call @text_is_space(%response, %position) : (buffer, offset) -> (i1)
                %drop = scalar.andi %space, %open : i1
                %next = index.add %position, %c1 : offset
                %after = scf.if %drop -> (offset) {
                  scf.yield %out : offset
                } else {
                  buffer.copy %response[%position], %output[%out], %c1
                  %moved = index.add %out, %c1 : offset
                  scf.yield %moved : offset
                }
                scf.yield %next, %after, %open : offset, offset, i1
              }
              scf.yield %p5, %o5, %n5 : offset, offset, i1
            }
            scf.yield %p4, %o4, %n4 : offset, offset, i1
          }
          scf.yield %p3, %o3, %n3 : offset, offset, i1
        }
        scf.yield %p2, %o2, %n2 : offset, offset, i1
      }
      scf.yield %p1, %o1, %n1 : offset, offset, i1
    }
    scf.yield %p, %o, %n : offset, offset, i1
  }
  %result = func.call @slice(%output, %origin, %written) : (buffer, offset, offset) -> (buffer)
  func.return %result : buffer
}

// The host supplies the reserved suffix that starts at the first call marker.
// %truncated is 1 when generation hit its token limit without EOS.
func.def public @parse_tools(%schemas: buffer, %response: buffer, %truncated: i64) -> (buffer) {
  %c0 = index.constant 0 : offset
  %zero64 = scalar.constant 0 : i64
  %length = buffer.length %response
  %has_text = index.cmp ne, %length, %c0 : offset
  %schema_fields, %schema_type, %schema_count = func.call @members(%schemas) : (buffer) -> (buffer, i32, i64)
  %has_tools = scalar.cmpi ne, %schema_count, %zero64 : i64
  %parse = scalar.andi %has_text, %has_tools : i1
  %calls = scf.if %parse -> (buffer) {
    %format = scalar.constant @@CALL_FORMAT@@ : i32
    %hermes = scalar.constant 1 : i32
    %glm = scalar.constant 3 : i32
    %is_hermes = scalar.cmpi eq, %format, %hermes : i32
    %is_glm = scalar.cmpi eq, %format, %glm : i32
    %parsed = scf.if %is_hermes -> (buffer) {
      %records = func.call @hermes_calls(%response) : (buffer) -> (buffer)
      scf.yield %records : buffer
    } else {
      %complete = func.call @through_last_call(%response) : (buffer) -> (buffer)
      %xml = scf.if %is_glm -> (buffer) {
        %converted = func.call @glm_calls_to_xml(%complete) : (buffer) -> (buffer)
        scf.yield %converted : buffer
      } else {
        scf.yield %complete : buffer
      }
      %records = func.call @parse_xml(%schemas, %xml, %truncated) : (buffer, buffer, i64) -> (buffer)
      scf.yield %records : buffer
    }
    scf.yield %parsed : buffer
  } else {
    %none = global.load @no_tools : buffer
    scf.yield %none : buffer
  }
  func.return %calls : buffer
}

// The host supplies the previous raw prediction separately. On EOS it replaces
// the first assistant delimiter in this suffix; an open response consumes its
// last ordinary token before that delimiter. Full replay encodes both normally.
// Encodes the rendered conversation with special-token matching enabled.
func.def public @prepare_input(%text: buffer, %markers: buffer, %marker_count: i64, %format: i32, %boundary: i32, %capacity: i64) -> (buffer, i64, buffer) {
  %c0 = index.constant 0 : offset
  %c0_i32 = scalar.constant 0 : i32
  %c0_i64 = scalar.constant 0 : i64
  %c1_i64 = scalar.constant 1 : i64
  %no_markers = scalar.cmpi eq, %marker_count, %c0_i64 : i64
  func.call @check(%no_markers) : (i1)
  %probe = scalar.addi %capacity, %c1_i64 : i64
  %tokens, %count = func.call @encode(%text, %c0_i32, %probe) : (buffer, i32, i64) -> (buffer, i64)
  %fits = scalar.cmpi ule, %count, %capacity : i64
  %fits32 = scalar.extui %fits : i1 to i32
  %error = global.load @overflow : buffer
  func.call @require(%fits32, %error) : (i32, buffer)
  %spans = buffer.alloca<private> align(4) %c0 : buffer
  func.return %tokens, %count, %spans : buffer, i64, buffer
}

global.rodata.def @text_think_end = bytes("@@HEX_THINK_END@@")

global.rodata.def @text_tool_marker = bytes("@@HEX_CALL_MARKER@@")

func.def @text_until(%response: buffer, %marker: buffer, %previous: i64, %phase: i32) -> (i64) {
  %c0 = index.constant 0 : offset
  %c1 = index.constant 1 : offset
  %zero32 = scalar.constant 0 : i32
  %false = scalar.constant false : i1
  %length = buffer.length %response
  %marker_length = buffer.length %marker
  // The owner supplies the last extent returned for this growing response.
  %previous_value = scalar.assume %previous [range(%previous, 0, 9223372036854775807)] : i64
  %start = index.cast %previous_value : i64 to offset
  %streaming = scalar.cmpi eq, %phase, %zero32 : i32
  %end = scf.while(%position = %start : offset) -> (offset) {
    %has_bytes = index.cmp ult, %position, %length : offset
    %advance = scf.if %has_bytes -> (i1) {
      %remaining = index.sub %length, %position : offset
      %short = index.cmp ult, %remaining, %marker_length : offset
      %count = scf.select %short, %remaining, %marker_length : offset
      %comparison = buffer.compare %response[%position], %marker[%c0], %count
      %mismatch = scalar.cmpi ne, %comparison, %zero32 : i32
      %complete_marker = index.cmp uge, %remaining, %marker_length : offset
      %withhold = scalar.ori %streaming, %complete_marker : i1
      %release_fragment = scalar.cmpi eq, %withhold, %false : i1
      %advance = scalar.ori %mismatch, %release_fragment : i1
      scf.yield %advance : i1
    } else {
      scf.yield %false : i1
    }
    scf.condition %advance, %position : i1, offset
  } do(%position: offset) {
    %next = index.add %position, %c1 : offset
    scf.yield %next : offset
  }
  %result = index.cast %end : offset to i64
  func.return %result : i64
}

// State 1 is an open reasoning block; state 2 consumes its trailing whitespace.
// Content (state 0) stops at the call marker: the rest goes to parse_tools.
// (Adapted from hrx-loom-library program/text/qwen3_8/chat.loom.)
func.def public @output_next(%response: buffer, %previous: i64, %state: i64, %phase: i32) -> (i64, i64, i64, i64) {
  %c0_i64 = scalar.constant 0 : i64
  %c1_i64 = scalar.constant 1 : i64
  %c2_i64 = scalar.constant 2 : i64
  %origin = index.constant 0 : offset
  %step = index.constant 1 : offset
  %thinking = scalar.cmpi eq, %state, %c1_i64 : i64
  %spacing = scalar.cmpi eq, %state, %c2_i64 : i64
  %kind, %begin, %end, %next = scf.if %spacing -> (i64, i64, i64, i64) {
    %start_value = scalar.assume %previous [range(%previous, 0, 9223372036854775807)] : i64
    %start = index.cast %start_value : i64 to offset
    %length = buffer.length %response
    %false = scalar.constant false : i1
    %stop = scf.while(%position = %start : offset) -> (offset) {
      %available = index.cmp ult, %position, %length : offset
      %space = scf.if %available -> (i1) {
        %value = func.call @text_is_space(%response, %position) : (buffer, offset) -> (i1)
        scf.yield %value : i1
      } else {
        scf.yield %false : i1
      }
      scf.condition %space, %position : i1, offset
    } do(%position: offset) {
      %following = index.add %position, %step : offset
      scf.yield %following : offset
    }
    %start_text = index.cast %stop : offset to i64
    %marker = global.load @text_tool_marker : buffer
    %end = func.call @text_until(%response, %marker, %start_text, %phase) : (buffer, buffer, i64, i32) -> (i64)
    %has_text = scalar.cmpi ne, %end, %start_text : i64
    %next = scf.select %has_text, %c0_i64, %state : i64
    scf.yield %c1_i64, %start_text, %end, %next : i64, i64, i64, i64
  } else {
    %think_marker = global.load @text_think_end : buffer
    %tool_marker = global.load @text_tool_marker : buffer
    %marker = scf.select %thinking, %think_marker, %tool_marker : buffer
    %stop = func.call @text_until(%response, %marker, %previous, %phase) : (buffer, buffer, i64, i32) -> (i64)
    %at_marker = scalar.cmpi eq, %stop, %previous : i64
    %length_offset = buffer.length %response
    %length = index.cast %length_offset : offset to i64
    %remaining = scalar.subi %length, %stop : i64
    %marker_length_offset = buffer.length %marker
    %marker_length = index.cast %marker_length_offset : offset to i64
    %complete = scalar.cmpi uge, %remaining, %marker_length : i64
    %thinking_marker = scalar.andi %thinking, %at_marker : i1
    %consume = scalar.andi %thinking_marker, %complete : i1
    %after = scalar.addi %stop, %marker_length : i64
    %end = scf.select %consume, %after, %stop : i64
    %next = scf.select %consume, %c2_i64, %state : i64
    %channel = scf.select %thinking, %c2_i64, %c1_i64 : i64
    %kind = scf.select %consume, %c0_i64, %channel : i64
    scf.yield %kind, %previous, %end, %next : i64, i64, i64, i64
  }
  func.return %kind, %begin, %end, %next : i64, i64, i64, i64
}

// Canonical history of this turn, as chat_message would render it: prompt +
// [trimmed reasoning + think close] + content + [separator] + calls + suffix.
// Device state is reusable only when the generated part (without the suffix,
// which the next input appends) is byte-identical to the actual output and the
// response did not end inside reasoning. (Adapted from qwen3_8/chat.loom.)
func.def public @complete_text(%prompt: buffer, %response: buffer, %content: buffer, %reasoning: buffer, %tools: buffer, %initial_state: i64, %final_state: i64) -> (buffer, i32) {
  %c0 = index.constant 0 : offset
  %c1_i64 = scalar.constant 1 : i64
  %empty = global.load @empty : buffer
  %thinking = scalar.cmpi eq, %initial_state, %c1_i64 : i64
  %prefix = scf.if %thinking -> (buffer) {
    %thought = func.call @trim(%reasoning) : (buffer) -> (buffer)
    %close = global.load @think_close : buffer
    %value = func.call @join4(%prompt, %thought, %close, %empty) : (buffer, buffer, buffer, buffer) -> (buffer)
    scf.yield %value : buffer
  } else {
    scf.yield %prompt : buffer
  }
  %content_length = buffer.length %content
  %has_content = index.cmp ne, %content_length, %c0 : offset
  %tools_length = buffer.length %tools
  %has_calls = index.cmp ne, %tools_length, %c0 : offset
  %separate = scalar.andi %has_content, %has_calls : i1
  %separator_value = global.load @content_call_separator : buffer
  %separator = scf.select %separate, %separator_value, %empty : buffer
  %suffix = global.load @message_suffix : buffer
  %answer = func.call @join4(%prefix, %content, %separator, %tools) : (buffer, buffer, buffer, buffer) -> (buffer)
  %result = func.call @join(%answer, %suffix) : (buffer, buffer) -> (buffer)
  %closed = scalar.cmpi ne, %final_state, %c1_i64 : i64
  %prompt_length = buffer.length %prompt
  %answer_length = buffer.length %answer
  %generated_length = index.sub %answer_length, %prompt_length : offset
  %response_length = buffer.length %response
  %same_length = index.cmp eq, %generated_length, %response_length : offset
  %identical = scf.if %same_length -> (i1) {
    %zero32 = scalar.constant 0 : i32
    %order = buffer.compare %answer[%prompt_length], %response[%c0], %response_length
    %equal = scalar.cmpi eq, %order, %zero32 : i32
    scf.yield %equal : i1
  } else {
    %false = scalar.constant false : i1
    scf.yield %false : i1
  }
  %compatible = scalar.andi %closed, %identical : i1
  %reusable = scalar.extui %compatible : i1 to i32
  func.return %result, %reusable : buffer, i32
}

func.def public @encode_state(%bindings: buffer, %count: i32, %origins: buffer) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %bounded_count = scalar.assume %count [range(%count, 1, 2147483647)] : i32
  %length = index.cast %bounded_count : i32 to index
  %origin_length = buffer.length %origins
  %origin_length64 = index.cast %origin_length : offset to i64
  %stride = scalar.constant 40 : i64
  %capacity64 = scalar.divui %origin_length64, %stride : i64
  %bounded_capacity = scalar.assume %capacity64 [range(%capacity64, 1, 2147483647)] : i64
  %capacity = index.cast %bounded_capacity : i64 to index
  %records = buffer.view %bindings[%origin] : buffer -> view<[%length]x4xi64>
  %rows = buffer.view %origins[%origin] : buffer -> view<[%capacity]x5xi64>
  scf.for %i = [%c0 to %length step %c1] {
    %row64 = view.load %records[%i, 0] : view<[%length]x4xi64> -> i64
    %row_bound = scalar.assume %row64 [range(%row64, 0, 2147483646)] : i64
    %row_value = index.cast %row_bound : i64 to index
    %row = index.assume %row_value [lt(%row_value, %capacity)] : index
    %read = view.load %records[%i, 1] : view<[%length]x4xi64> -> i64
    %write = view.load %records[%i, 2] : view<[%length]x4xi64> -> i64
    %position = view.load %records[%i, 3] : view<[%length]x4xi64> -> i64
    view.store %read, %rows[%row, 0] : i64, view<[%capacity]x5xi64>
    view.store %write, %rows[%row, 1] : i64, view<[%capacity]x5xi64>
    view.store %position, %rows[%row, 3] : i64, view<[%capacity]x5xi64>
  }
  func.return
}

// Opaque output deliberately gathers the two halves of each retained hidden
// word in reverse order. Native serving preserves bytes, not tensor types.
func.def public @capture_epoch(%state: buffer, %shape: i32, %count: i32, %plan: buffer) -> (buffer) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %bounded = scalar.assume %count [range(%count, 1, 2147483647)] : i32
  %spans = index.cast %bounded : i32 to index
  %count64 = scalar.extui %bounded : i32 to i64
  %record_bytes = scalar.constant 48 : i64
  %bytes64 = scalar.muli %count64, %record_bytes : i64
  %bounded_bytes = scalar.assume %bytes64 [range(%bytes64, 48, 103079215056)] : i64
  %length = index.cast %bounded_bytes : i64 to offset
  %storage = buffer.alloca<private> align(8) %length : buffer
  %records = buffer.view %storage[%origin] : buffer -> view<[%spans]x2x3xi64>
  %half = scalar.constant 2 : i64
  %word = scalar.constant 4 : i64
  scf.for %i = [%c0 to %spans step %c1] {
    %span = index.cast %i : index to i64
    %low = scalar.muli %span, %word : i64
    %high = scalar.addi %low, %half : i64
    view.store %span, %records[%i, 0, 0] : i64, view<[%spans]x2x3xi64>
    view.store %high, %records[%i, 0, 1] : i64, view<[%spans]x2x3xi64>
    view.store %half, %records[%i, 0, 2] : i64, view<[%spans]x2x3xi64>
    view.store %span, %records[%i, 1, 0] : i64, view<[%spans]x2x3xi64>
    view.store %low, %records[%i, 1, 1] : i64, view<[%spans]x2x3xi64>
    view.store %half, %records[%i, 1, 2] : i64, view<[%spans]x2x3xi64>
  }
  func.return %storage : buffer
}

func.def @plan_capacity(%plan: buffer) -> (index) {
  %bytes = buffer.length %plan
  %bytes64 = index.cast %bytes : offset to i64
  %stride = scalar.constant 36 : i64
  %records = scalar.divui %bytes64, %stride : i64
  %bounded = scalar.assume %records [range(%records, 1, 2147483647)] : i64
  %capacity = index.cast %bounded : i64 to index
  func.return %capacity : index
}

func.def @encode_mixed_plan(%plan: buffer, %inputs: buffer, %record_begin: index, %span_count: i32, %input_count: i32, %packet_capacity: i32, %packet: buffer) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %bounded_span_count = scalar.assume %span_count [range(%span_count, 0, 2147483647)] : i32
  %span_extent = index.cast %bounded_span_count : i32 to index
  %bounded_input_count = scalar.assume %input_count [range(%input_count, 1, 524288)] : i32
  %input_extent = index.cast %bounded_input_count : i32 to index
  %bounded_packet_capacity = scalar.assume %packet_capacity [range(%packet_capacity, 1, 524288)] : i32
  %packet_extent = index.cast %bounded_packet_capacity : i32 to index
  %plan_extent = func.call @plan_capacity(%plan) : (buffer) -> (index)
  %requests = buffer.view %plan[%origin] : buffer -> view<[%plan_extent]x9xi32>
  %ids = buffer.view %inputs[%origin] : buffer -> view<[%input_extent]xi32>
  %records = buffer.view %packet[%origin] : buffer -> view<[%packet_extent]x8xi32>
  scf.for %i = [%c0 to %span_extent step %c1] {
    %request_value = index.add %record_begin, %i : index
    %request = index.assume %request_value [range(%request_value, 0, 2147483646), lt(%request_value, %plan_extent)] : index
    %input_begin32 = view.load %requests[%request, 4] : view<[%plan_extent]x9xi32> -> i32
    %input_length32 = view.load %requests[%request, 5] : view<[%plan_extent]x9xi32> -> i32
    %bounded_begin = scalar.assume %input_begin32 [range(%input_begin32, 0, 524287)] : i32
    %bounded_length = scalar.assume %input_length32 [range(%input_length32, 0, 524288)] : i32
    %input_begin = index.cast %bounded_begin : i32 to index
    %input_length = index.cast %bounded_length : i32 to index
    scf.for %j = [%c0 to %input_length step %c1] {
      %position = index.add %input_begin, %j : index
      %input_position = index.assume %position [lt(%position, %input_extent)] : index
      %packet_position = index.assume %position [lt(%position, %packet_extent)] : index
      %token = view.load %ids[%input_position] : view<[%input_extent]xi32> -> i32
      view.store %token, %records[%packet_position, 0] : i32, view<[%packet_extent]x8xi32>
    }
  }
  func.return
}

func.def @encode_mixed_media(%plan: buffer, %media_plan: buffer, %media_count: i32, %packet_capacity: i32, %packet: buffer) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %bounded_media_count = scalar.assume %media_count [range(%media_count, 1, 524288)] : i32
  %media_extent = index.cast %bounded_media_count : i32 to index
  %bounded_packet_capacity = scalar.assume %packet_capacity [range(%packet_capacity, 1, 524288)] : i32
  %packet_extent = index.cast %bounded_packet_capacity : i32 to index
  %plan_extent = func.call @plan_capacity(%plan) : (buffer) -> (index)
  %requests = buffer.view %plan[%origin] : buffer -> view<[%plan_extent]x9xi32>
  %media = buffer.view %media_plan[%origin] : buffer -> view<[%media_extent]x7xi32>
  %records = buffer.view %packet[%origin] : buffer -> view<[%packet_extent]x8xi32>
  scf.for %i = [%c0 to %media_extent step %c1] {
    %plan_index32 = view.load %media[%i, 0] : view<[%media_extent]x7xi32> -> i32
    %relative32 = view.load %media[%i, 1] : view<[%media_extent]x7xi32> -> i32
    %feature_offset = view.load %media[%i, 2] : view<[%media_extent]x7xi32> -> i32
    %feature_length = view.load %media[%i, 3] : view<[%media_extent]x7xi32> -> i32
    %feature_index = view.load %media[%i, 6] : view<[%media_extent]x7xi32> -> i32
    %plan_index_bound = scalar.assume %plan_index32 [range(%plan_index32, 0, 2147483646)] : i32
    %plan_index_value = index.cast %plan_index_bound : i32 to index
    %bounded_relative = scalar.assume %relative32 [range(%relative32, 0, 524287)] : i32
    %plan_index = index.assume %plan_index_value [lt(%plan_index_value, %plan_extent)] : index
    %relative = index.cast %bounded_relative : i32 to index
    %input_begin32 = view.load %requests[%plan_index, 4] : view<[%plan_extent]x9xi32> -> i32
    %bounded_begin = scalar.assume %input_begin32 [range(%input_begin32, 0, 524287)] : i32
    %input_begin = index.cast %bounded_begin : i32 to index
    %position = index.add %input_begin, %relative : index
    %packet_position = index.assume %position [lt(%position, %packet_extent)] : index
    view.store %feature_offset, %records[%packet_position, 1] : i32, view<[%packet_extent]x8xi32>
    view.store %feature_length, %records[%packet_position, 2] : i32, view<[%packet_extent]x8xi32>
    view.store %feature_index, %records[%packet_position, 3] : i32, view<[%packet_extent]x8xi32>
  }
  func.return
}

// Device packets retain the first cohort's nine-field plan records. Feedback
// slots are span-indexed, including unselected input-only spans.
func.def public @encode_epoch(%control_state: buffer, %plan: buffer, %inputs: buffer, %media_plan: buffer, %first_count: i32, %next_count: i32, %input_count: i32, %first_media_count: i32, %next_media_count: i32, %first_packet_capacity: i32, %next_packet_capacity: i32, %eos: i32, %metadata: buffer, %tokens: buffer) -> (i32, buffer, i64, i64) {
  %origin = index.constant 0 : offset
  %header_bytes = index.constant 16 : offset
  %count64 = scalar.extui %first_count : i32 to i64
  %record_bytes = scalar.constant 36 : i64
  %plan_length = scalar.muli %count64, %record_bytes : i64
  %plan_bytes = index.cast %plan_length : i64 to offset
  %header = buffer.view %metadata[%origin] : buffer -> view<4xi32>
  %c0 = scalar.constant 0 : i32
  view.store %first_count, %header[0] : i32, view<4xi32>
  view.store %eos, %header[1] : i32, view<4xi32>
  view.store %c0, %header[2] : i32, view<4xi32>
  view.store %c0, %header[3] : i32, view<4xi32>
  buffer.copy %plan[%origin], %metadata[%header_bytes], %plan_bytes
  %media_count = scalar.addi %first_media_count, %next_media_count : i32
  %has_media = scalar.cmpi ne, %media_count, %c0 : i32
  %input_count64 = scalar.extui %input_count : i32 to i64
  %token_stride = scalar.constant 4 : i64
  %packet_stride = scalar.constant 32 : i64
  %stride = scf.select %has_media, %packet_stride, %token_stride : i64
  %input_length = scalar.muli %input_count64, %stride : i64
  %input_bytes = index.cast %input_length : i64 to offset
  scf.if %has_media {
    // Ordinary records need zero feature fields; inactive capacity is not read.
    buffer.fill %c0, %tokens[%origin], %input_bytes : i32
    %packet_capacity = scalar.addi %first_packet_capacity, %next_packet_capacity : i32
    %c0_index = index.constant 0 : index
    func.call @encode_mixed_plan(%plan, %inputs, %c0_index, %first_count, %input_count, %packet_capacity, %tokens) : (buffer, buffer, index, i32, i32, i32, buffer)
    %has_next = scalar.cmpi ne, %next_count, %c0 : i32
    scf.if %has_next {
      %bounded_first = scalar.assume %first_count [range(%first_count, 1, 2147483647)] : i32
      %next_begin = index.cast %bounded_first : i32 to index
      func.call @encode_mixed_plan(%plan, %inputs, %next_begin, %next_count, %input_count, %packet_capacity, %tokens) : (buffer, buffer, index, i32, i32, i32, buffer)
    }
    func.call @encode_mixed_media(%plan, %media_plan, %media_count, %packet_capacity, %tokens) : (buffer, buffer, i32, i32, buffer)
  } else {
    buffer.copy %inputs[%origin], %tokens[%origin], %input_bytes
  }
  %transfer_offset = index.constant 8 : offset
  %transfers = buffer.view %control_state[%transfer_offset] : buffer -> view<2x5xi64>
  %zero64 = scalar.constant 0 : i64
  %one64 = scalar.constant 1 : i64
  %header_length = scalar.constant 16 : i64
  %metadata_length = scalar.addi %header_length, %plan_length : i64
  view.store %zero64, %transfers[0, 0] : i64, view<2x5xi64>
  view.store %zero64, %transfers[0, 1] : i64, view<2x5xi64>
  view.store %zero64, %transfers[0, 2] : i64, view<2x5xi64>
  view.store %zero64, %transfers[0, 3] : i64, view<2x5xi64>
  view.store %metadata_length, %transfers[0, 4] : i64, view<2x5xi64>
  view.store %one64, %transfers[1, 0] : i64, view<2x5xi64>
  view.store %zero64, %transfers[1, 1] : i64, view<2x5xi64>
  view.store %one64, %transfers[1, 2] : i64, view<2x5xi64>
  view.store %zero64, %transfers[1, 3] : i64, view<2x5xi64>
  view.store %input_length, %transfers[1, 4] : i64, view<2x5xi64>
  %transfer_begin = scalar.constant 8 : i64
  %transfer_length = scalar.constant 80 : i64
  func.return %first_count, %control_state, %transfer_begin, %transfer_length : i32, buffer, i64, i64
}

func.def public @publish_epoch(%plan: buffer, %media_plan: buffer, %count: i32, %first_media_count: i32, %next_media_count: i32, %verified: i32, %continues: i32, %next_speculative: buffer, %ordinary: buffer, %first_results: buffer, %next_results: buffer, %progress: buffer) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %c2_i32 = scalar.constant 2 : i32
  %progress_bytes = buffer.length %progress
  buffer.fill %c0_i32, %progress[%origin], %progress_bytes : i32
  %bounded_count = scalar.assume %count [range(%count, 1, 2147483647)] : i32
  %length = index.cast %bounded_count : i32 to index
  %plan_extent = func.call @plan_capacity(%plan) : (buffer) -> (index)
  %requests = buffer.view %plan[%origin] : buffer -> view<[%plan_extent]x9xi32>
  %outputs = buffer.view %ordinary[%origin] : buffer -> view<[%length]xi32>
  %published = buffer.view %progress[%origin] : buffer -> view<[%length]x21xi32>
  scf.for %i = [%c0 to %length step %c1] {
    %request = index.assume %i [lt(%i, %plan_extent)] : index
    %consumed = view.load %requests[%request, 0] : view<[%plan_extent]x9xi32> -> i32
    %source_position = view.load %requests[%request, 2] : view<[%plan_extent]x9xi32> -> i32
    %source_advance = scalar.muli %consumed, %c2_i32 : i32
    %next_source_position = scalar.addi %source_position, %source_advance : i32
    %flags = view.load %requests[%request, 6] : view<[%plan_extent]x9xi32> -> i32
    %bits = scalar.andi %flags, %c1_i32 : i32
    %selected = scalar.cmpi ne, %bits, %c0_i32 : i32
    %selected_count = scalar.extui %selected : i1 to i32
    view.store %consumed, %published[%i, 0] : i32, view<[%length]x21xi32>
    view.store %consumed, %published[%i, 1] : i32, view<[%length]x21xi32>
    view.store %selected_count, %published[%i, 2] : i32, view<[%length]x21xi32>
    view.store %next_source_position, %published[%i, 4] : i32, view<[%length]x21xi32>
    scf.if %selected {
      %token = view.load %outputs[%i] : view<[%length]xi32> -> i32
      view.store %token, %published[%i, 5] : i32, view<[%length]x21xi32>
    }
  }
  func.return
}

func.def public @step(%state: buffer, %initialize: i32, %source_position: i32, %input_count: i32, %residual: hal.buffer, %control: hal.buffer, %recurrent: hal.buffer, %attention: hal.buffer, %tokens: hal.buffer, %progress: hal.buffer) -> (i64, i32) {
  %c0 = scalar.constant 0 : i32
  %c2 = scalar.constant 2 : i32
  %c0_i64 = scalar.constant 0 : i64
  %source_advance = scalar.muli %input_count, %c2 : i32
  %next_source_position = scalar.addi %source_position, %source_advance : i32
  %error = global.load @unsupported : buffer
  func.call @require(%c0, %error) : (i32, buffer)
  func.return %c0_i64, %next_source_position : i64, i32
}

// Selects the stage compiled for this packing shape.
func.def public @epoch(%control_state: buffer, %shape: i32, %proposes: i32, %verifies: i32, %span_count: i32, %output_count: i32, %epoch_count: i32, %continuation_shape: i32, %continuation_proposes: i32, %first_media_count: i32, %next_media_count: i32, %residual: hal.buffer, %metadata: hal.buffer, %origins: hal.buffer, %state: hal.buffer, %tokens: hal.buffer, %outputs: hal.buffer, %carry: hal.buffer, %committed: hal.buffer, %results: hal.buffer, %draft_cache: hal.buffer, %draft_origins: hal.buffer, %next_results: hal.buffer) -> (i64) {
  %stage_origin = index.constant 128 : offset
  %bounded_shape = scalar.assume %shape [range(%shape, 0, 127)] : i32
  %shape_index = index.cast %bounded_shape : i32 to index
  %stages = buffer.view %control_state[%stage_origin] : buffer -> view<128xi32>
  %stage = view.load %stages[%shape_index] : view<128xi32> -> i32
  %completion = func.call @execute_6(%stage, %residual, %metadata, %origins, %state, %tokens, %outputs) : (i32, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer) -> (i64)
  %c0 = scalar.constant 0 : i32
  %c0_i64 = scalar.constant 0 : i64
  %c4_i64 = scalar.constant 4 : i64
  %count64 = scalar.extui %span_count : i32 to i64
  %length = scalar.muli %count64, %c4_i64 : i64
  %feedback = func.call @feedback(%c0, %outputs, %c0_i64, %length) : (i32, hal.buffer, i64, i64) -> (i64)
  func.return %completion : i64
}

func.decl @llm_storage(%maximum: i64, %span_capacity: i64, %context: i64, %pool: i64, %rows: i64, %pins: i64) -> (buffer, buffer, buffer, buffer, buffer)

func.def public @resize_state(%state: buffer, %rows: i64) -> (buffer, buffer, buffer, buffer, buffer, buffer) {
  %layout_origin = index.constant 88 : offset
  %layout = buffer.view %state[%layout_origin] : buffer -> view<5xi64>
  %maximum = view.load %layout[0] : view<5xi64> -> i64
  %span_capacity = view.load %layout[1] : view<5xi64> -> i64
  %context = view.load %layout[2] : view<5xi64> -> i64
  %pool = view.load %layout[3] : view<5xi64> -> i64
  %pins = view.load %layout[4] : view<5xi64> -> i64
  %allocations, %views, %origins, %draft, %geometry = func.call @llm_storage(%maximum, %span_capacity, %context, %pool, %rows, %pins) : (i64, i64, i64, i64, i64, i64) -> (buffer, buffer, buffer, buffer, buffer)
  func.return %state, %allocations, %views, %origins, %draft, %geometry : buffer, buffer, buffer, buffer, buffer, buffer
}
