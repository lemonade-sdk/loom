    %q1 = vector.load %q_view[%token, %head, %c1, %c0] : view<[%tokens]x32x4x32xf32> -> vector<32xf32>
    %c3 = index.constant 3 : index
    %q2 = vector.load %q_view[%token, %head, %c2, %c0] : view<[%tokens]x32x4x32xf32> -> vector<32xf32>
    %q3 = vector.load %q_view[%token, %head, %c3, %c0] : view<[%tokens]x32x4x32xf32> -> vector<32xf32>
    // Phase 1: one visible position per lane per iteration.
    %local_max = scf.for %j = [%local to %visible step %c256](%m = %neg_inf : f32) -> (f32) {
      %key_position = index.add %window_low, %j : index
      %k_offset = func.call @flint_kv_offset(%origins, %row, %key_position, %blocks, %k_plane, %pool) : (buffer, index, index, index, index, index) -> (offset)
      %k_cache = buffer.view %arena[%k_offset] : buffer -> view<4x4x32xf32>
      %k0 = vector.load %k_cache[%kv_head, %c0, %c0] : view<4x4x32xf32> -> vector<32xf32>
      %k1 = vector.load %k_cache[%kv_head, %c1, %c0] : view<4x4x32xf32> -> vector<32xf32>
      %k2 = vector.load %k_cache[%kv_head, %c2, %c0] : view<4x4x32xf32> -> vector<32xf32>
      %k3 = vector.load %k_cache[%kv_head, %c3, %c0] : view<4x4x32xf32> -> vector<32xf32>
      %p0 = vector.mulf %q0, %k0 : vector<32xf32>
      %p1 = vector.fmaf %q1, %k1, %p0 : vector<32xf32>
      %p2 = vector.fmaf %q2, %k2, %p1 : vector<32xf32>
      %p3 = vector.fmaf %q3, %k3, %p2 : vector<32xf32>
      %dot = vector.reduce<addf> %p3, %zero_f : vector<32xf32>, f32
      %score = scalar.mulf %dot, %scale : f32
      %bounded_j = index.assume %j [lt(%j, %c4096)] : index
      view.store %score, %score_view[%bounded_j] : f32, view<4096xf32>
      %bigger = scalar.maxnumf %m, %score : f32
      scf.yield %bigger : f32
    }
    %sink_view = buffer.view %sinks[%zero] : buffer -> view<32xf32>
    %sink = view.load %sink_view[%head] : view<32xf32> -> f32
    %block_max = kernel.workgroup.reduce<maxnumf> %local_max : f32
    %maximum = scalar.maxnumf %block_max, %sink : f32
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    // Phase 2: exponentiate in place and reduce the denominator.
    %local_sum = scf.for %j = [%local to %visible step %c256](%s = %zero_f : f32) -> (f32) {
      %bounded_j = index.assume %j [lt(%j, %c4096)] : index
      %score = view.load %score_view[%bounded_j] : view<4096xf32> -> f32
      %shifted = scalar.subf %score, %maximum : f32
      %p = scalar.expf<afn> %shifted : f32
      view.store %p, %score_view[%bounded_j] : f32, view<4096xf32>
