// Flint transformer kernels (everything except the quantized linear layers).
//
// Token rows are packed epoch input positions. A token-info record
// [row, position, live, span] maps each packed token to its retained session
// row and causal position; padding tokens beyond the live input are not live
// and never touch retained KV storage.
//
// KV storage: 98 planes (layer-major, K then V) in the state arena starting at
// byte 0. Each plane holds `pool` positions in 16-position pages; one position
// stores 4 KV heads x 128 F16 values (1024 bytes). Logical positions resolve
// through each row's page map in the origin table, exactly like the text
// service fixture.

func.def inline @flint_kv_offset(%origins: buffer, %row: index, %position: index, %blocks: index, %plane: index, %pool: index) -> (offset) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c16 = index.constant 16 : index
  %record_stride = index.constant 40 : offset
  %word = index.constant 4 : offset
  %position_bytes = index.constant 1024 : offset
  %bounded_row = index.assume %row [range(%row, 0, 2147483646)] : index
  %bounded_position = index.assume %position [range(%position, 0, 262143)] : index
  %record_offset = index.scale %bounded_row, %record_stride : index, offset -> offset
  %records = buffer.view %origins[%record_offset] : buffer -> view<5xi64>
  %map64 = view.load %records[4] : view<5xi64> -> i64
  %map_bound = scalar.assume %map64 [range(%map64, 0, 9223372036854775807)] : i64
  %map_origin = index.cast %map_bound : i64 to offset
  %page_value = index.div %bounded_position, %c16 : index
  %last = index.sub %blocks, %c1 : index
  %page = index.assume %page_value [range(%page_value, 0, %last), lt(%page_value, %blocks)] : index
  %map = buffer.view %origins[%map_origin] : buffer -> view<[%blocks]xi32>
  %physical32 = view.load %map[%page] : view<[%blocks]xi32> -> i32
  %bounded_physical = scalar.assume %physical32 [range(%physical32, 0, 1048575)] : i32
  %physical = index.cast %bounded_physical : i32 to index
  %page_base = index.mul %physical, %c16 : index
  %within = index.rem %bounded_position, %c16 : index
  %slot = index.add %page_base, %within : index
  %plane_slot = index.madd %plane, %pool, %slot : index
  %bytes = index.scale %plane_slot, %position_bytes : index, offset -> offset
  func.return %bytes : offset
}

// Embedding lookup from the Q8_0 token table. One 64-lane workgroup per token;
// each lane dequantizes one 32-value block of the 2048-wide row.
kernel.def export("flint_embed") @flint_embed(%tokens: index) {
  %c1 = index.constant 1 : index
  %c64 = index.constant 64 : index
  kernel.launch.config workgroups(%tokens, %c1, %c1) workgroup_size(%c64, %c1, %c1) : index
} launch(%tokens_arg: index, %ids: buffer, %w: buffer, %x: buffer) {
  %tokens = index.assume %tokens_arg [range(%tokens_arg, 1, 8192)] : index
  %token_id = kernel.workgroup.id<x> : index
  %token = index.assume %token_id [lt(%token_id, %tokens)] : index
  %lane_id = kernel.workitem.id<x> : index
  %lane = index.assume %lane_id [range(%lane_id, 0, 63)] : index
  %zero = index.constant 0 : offset
  %two = index.constant 2 : offset
  %c0 = index.constant 0 : index
  %ids_view = buffer.view %ids[%zero] : buffer -> view<[%tokens]xi32>
  %raw = view.load %ids_view[%token] : view<[%tokens]xi32> -> i32
  %c0_i32 = scalar.constant 0 : i32
  %vocab_last = scalar.constant 150143 : i32
  %low = scalar.maxsi %raw, %c0_i32 : i32
  %clamped = scalar.minsi %low, %vocab_last : i32
  %bounded = scalar.assume %clamped [range(%clamped, 0, 150143)] : i32
  %id = index.cast %bounded : i32 to index
  %row_bytes = index.constant 2176 : offset
  %block_bytes = index.constant 34 : offset
  %row_origin = index.scale %id, %row_bytes : index, offset -> offset
  %block_add = index.scale %lane, %block_bytes : index, offset -> offset
  %block_origin = index.add %row_origin, %block_add : offset
  %code_origin = index.add %block_origin, %two : offset
  %scale_view = buffer.view %w[%block_origin] : buffer -> view<1xf16>
  %code_view = buffer.view %w[%code_origin] : buffer -> view<32xi8>
  %scale_half = view.load %scale_view[0] : view<1xf16> -> f16
  %scale = scalar.extf %scale_half : f16 to f32
  %codes = vector.load %code_view[0] : view<32xi8> -> vector<32xi8>
  %values = vector.sitofp %codes : vector<32xi8> to vector<32xf32>
  %scales = vector.splat %scale : vector<32xf32>
  %scaled = vector.mulf %values, %scales : vector<32xf32>
  %x_view = buffer.view %x[%zero] : buffer -> view<[%tokens]x64x32xf32>
  vector.store %scaled, %x_view[%token, %lane, %c0] : vector<32xf32>, view<[%tokens]x64x32xf32>
  kernel.return
}

// Maps each packed token to [row, position, live, span] from the epoch's
// nine-field span records.
kernel.def export("flint_token_info") @flint_token_info(%tokens: index) {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%tokens, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%tokens_arg: index, %spans_arg: index, %metadata: buffer, %info: buffer) {
  %tokens = index.assume %tokens_arg [range(%tokens_arg, 1, 8192)] : index
  %spans = index.assume %spans_arg [range(%spans_arg, 1, 8192)] : index
  %token_id = kernel.workgroup.id<x> : index
  %token = index.assume %token_id [lt(%token_id, %tokens)] : index
  %zero = index.constant 0 : offset
  %c16 = index.constant 16 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %header = buffer.view %metadata[%zero] : buffer -> view<4xi32>
  %count32 = view.load %header[0] : view<4xi32> -> i32
  %count_bound = scalar.assume %count32 [range(%count32, 0, 8192)] : i32
  %count_value = index.cast %count_bound : i32 to index
  %fewer = index.cmp ult, %count_value, %spans : index
  %count = scf.select %fewer, %count_value, %spans : index
  %packets = buffer.view %metadata[%c16] : buffer -> view<[%spans]x9xi32>
  %token32 = index.cast %token : index to i32
  %minus_one = scalar.constant -1 : i32
  %row, %position, %live, %span = scf.for %s = [%c0 to %count step %c1](%r = %minus_one : i32, %p = %c0_i32 : i32, %l = %c0_i32 : i32, %found = %minus_one : i32) -> (i32, i32, i32, i32) {
    %bounded_s = index.assume %s [lt(%s, %spans)] : index
    %length32 = view.load %packets[%bounded_s, 0] : view<[%spans]x9xi32> -> i32
    %position32 = view.load %packets[%bounded_s, 1] : view<[%spans]x9xi32> -> i32
    %row32 = view.load %packets[%bounded_s, 3] : view<[%spans]x9xi32> -> i32
    %input32 = view.load %packets[%bounded_s, 4] : view<[%spans]x9xi32> -> i32
    %end32 = scalar.addi %input32, %length32 : i32
    %after_begin = scalar.cmpi sge, %token32, %input32 : i32
    %before_end = scalar.cmpi slt, %token32, %end32 : i32
    %inside = scalar.andi %after_begin, %before_end : i1
    %relative = scalar.subi %token32, %input32 : i32
    %absolute = scalar.addi %position32, %relative : i32
    %s32 = index.cast %bounded_s : index to i32
    %next_r = scf.select %inside, %row32, %r : i32
    %next_p = scf.select %inside, %absolute, %p : i32
    %next_l = scf.select %inside, %c1_i32, %l : i32
    %next_s = scf.select %inside, %s32, %found : i32
    scf.yield %next_r, %next_p, %next_l, %next_s : i32, i32, i32, i32
  }
  %info_view = buffer.view %info[%zero] : buffer -> view<[%tokens]x4xi32>
  view.store %row, %info_view[%token, 0] : i32, view<[%tokens]x4xi32>
  view.store %position, %info_view[%token, 1] : i32, view<[%tokens]x4xi32>
  view.store %live, %info_view[%token, 2] : i32, view<[%tokens]x4xi32>
  view.store %span, %info_view[%token, 3] : i32, view<[%tokens]x4xi32>
  kernel.return
}

// y[t] = x[t] / rms(x[t]) * w over 2048 channels; 256 lanes x 8 values.
kernel.def export("flint_rmsnorm") @flint_rmsnorm(%tokens: index) {
  %c1 = index.constant 1 : index
  %c256 = index.constant 256 : index
  kernel.launch.config workgroups(%tokens, %c1, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%tokens_arg: index, %x: buffer, %w: buffer, %y: buffer) {
  %tokens = index.assume %tokens_arg [range(%tokens_arg, 1, 8192)] : index
  %token_id = kernel.workgroup.id<x> : index
  %token = index.assume %token_id [lt(%token_id, %tokens)] : index
  %lane_id = kernel.workitem.id<x> : index
  %lane = index.assume %lane_id [range(%lane_id, 0, 255)] : index
  %zero = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %zero_f = scalar.constant 0.0 : f32
  %x_view = buffer.view %x[%zero] : buffer -> view<[%tokens]x256x8xf32>
  %w_view = buffer.view %w[%zero] : buffer -> view<256x8xf32>
  %y_view = buffer.view %y[%zero] : buffer -> view<[%tokens]x256x8xf32>
  %values = vector.load %x_view[%token, %lane, %c0] : view<[%tokens]x256x8xf32> -> vector<8xf32>
  %squares = vector.mulf %values, %values : vector<8xf32>
  %local = vector.reduce<addf> %squares, %zero_f : vector<8xf32>, f32
  %sum = kernel.workgroup.reduce<addf> %local : f32
  %count = scalar.constant 2048.0 : f32
  %eps = scalar.constant 1.0e-6 : f32
  %mean = scalar.divf %sum, %count : f32
  %stable = scalar.addf %mean, %eps : f32
  %inverse = scalar.rsqrtf %stable : f32
  %inverses = vector.splat %inverse : vector<8xf32>
  %weights = vector.load %w_view[%lane, %c0] : view<256x8xf32> -> vector<8xf32>
  %normalized = vector.mulf %values, %inverses : vector<8xf32>
  %result = vector.mulf %normalized, %weights : vector<8xf32>
  vector.store %result, %y_view[%token, %lane, %c0] : vector<8xf32>, view<[%tokens]x256x8xf32>
  kernel.return
}

// Per-head RMSNorm + NeoX RoPE for 32 query and 4 key heads; keys and values
// are written into the paged KV planes of `layer`. Workgroup (token, head)
// with 64 lanes; lane d owns rotary pair (d, d + 64).
kernel.def export("flint_qk_rope_store") @flint_qk_rope_store(%tokens: index) {
  %c1 = index.constant 1 : index
  %c36 = index.constant 36 : index
  %c64 = index.constant 64 : index
  kernel.launch.config workgroups(%tokens, %c36, %c1) workgroup_size(%c64, %c1, %c1) : index
} launch(%tokens_arg: index, %layer_arg: index, %rope: i32, %context_arg: index, %pool_arg: index, %q: buffer, %k: buffer, %v: buffer, %q_norm: buffer, %k_norm: buffer, %info: buffer, %origins: buffer, %arena: buffer) {
  %tokens = index.assume %tokens_arg [range(%tokens_arg, 1, 8192)] : index
  %layer = index.assume %layer_arg [range(%layer_arg, 0, 48)] : index
  %context = index.assume %context_arg [range(%context_arg, 16, 262144)] : index
  %pool = index.assume %pool_arg [range(%pool_arg, 16, 1048576)] : index
  %token_id = kernel.workgroup.id<x> : index
  %token = index.assume %token_id [lt(%token_id, %tokens)] : index
  %head_id = kernel.workgroup.id<y> : index
  %head = index.assume %head_id [range(%head_id, 0, 35)] : index
  %lane_id = kernel.workitem.id<x> : index
  %lane = index.assume %lane_id [range(%lane_id, 0, 63)] : index
  %zero = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c15 = index.constant 15 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c64 = index.constant 64 : index
  %c128 = index.constant 128 : index
  %c0_i32 = scalar.constant 0 : i32
  %info_view = buffer.view %info[%zero] : buffer -> view<[%tokens]x4xi32>
  %row32 = view.load %info_view[%token, 0] : view<[%tokens]x4xi32> -> i32
  %position32 = view.load %info_view[%token, 1] : view<[%tokens]x4xi32> -> i32
  %live32 = view.load %info_view[%token, 2] : view<[%tokens]x4xi32> -> i32
  %live = scalar.cmpi ne, %live32, %c0_i32 : i32
  %position_low = scalar.maxsi %position32, %c0_i32 : i32
  %is_query = index.cmp ult, %head, %c32 : index
  %kv_head = index.sub %head, %c32 : index
  // Query heads read q[t, head]; key heads read k[t, head - 32].
  %q_view = buffer.view %q[%zero] : buffer -> view<[%tokens]x32x2x64xf32>
  %k_view = buffer.view %k[%zero] : buffer -> view<[%tokens]x4x2x64xf32>
  %low, %high = scf.if %is_query -> (f32, f32) {
    %bounded_head = index.assume %head [lt(%head, %c32)] : index
    %a = view.load %q_view[%token, %bounded_head, %c0, %lane] : view<[%tokens]x32x2x64xf32> -> f32
    %b = view.load %q_view[%token, %bounded_head, %c1, %lane] : view<[%tokens]x32x2x64xf32> -> f32
    scf.yield %a, %b : f32, f32
  } else {
    %bounded_kv = index.assume %kv_head [range(%kv_head, 0, 3)] : index
    %a = view.load %k_view[%token, %bounded_kv, %c0, %lane] : view<[%tokens]x4x2x64xf32> -> f32
    %b = view.load %k_view[%token, %bounded_kv, %c1, %lane] : view<[%tokens]x4x2x64xf32> -> f32
    scf.yield %a, %b : f32, f32
  }
  %low_sq = scalar.mulf %low, %low : f32
  %square_sum = scalar.fmaf %high, %high, %low_sq : f32
  %sum = kernel.workgroup.reduce<addf> %square_sum : f32
  %dims = scalar.constant 128.0 : f32
  %eps = scalar.constant 1.0e-6 : f32
  %mean = scalar.divf %sum, %dims : f32
  %stable = scalar.addf %mean, %eps : f32
  %inverse = scalar.rsqrtf %stable : f32
  %qn_view = buffer.view %q_norm[%zero] : buffer -> view<2x64xf32>
  %kn_view = buffer.view %k_norm[%zero] : buffer -> view<2x64xf32>
  %w_low, %w_high = scf.if %is_query -> (f32, f32) {
    %a = view.load %qn_view[%c0, %lane] : view<2x64xf32> -> f32
    %b = view.load %qn_view[%c1, %lane] : view<2x64xf32> -> f32
    scf.yield %a, %b : f32, f32
  } else {
    %a = view.load %kn_view[%c0, %lane] : view<2x64xf32> -> f32
    %b = view.load %kn_view[%c1, %lane] : view<2x64xf32> -> f32
    scf.yield %a, %b : f32, f32
  }
  %n_low0 = scalar.mulf %low, %inverse : f32
  %n_high0 = scalar.mulf %high, %inverse : f32
  %n_low = scalar.mulf %n_low0, %w_low : f32
  %n_high = scalar.mulf %n_high0, %w_high : f32
  %apply_rope = scalar.cmpi ne, %rope, %c0_i32 : i32
  %r_low, %r_high = scf.if %apply_rope -> (f32, f32) {
    // theta = position * 10000^(-2d/128) = position * exp2(-d * log2(10000) / 64)
    %lane32 = index.cast %lane : index to i32
    %lane_f = scalar.sitofp %lane32 : i32 to f32
    %log2_base_over_64 = scalar.constant 0.20762050593046014 : f32
    %neg = scalar.constant -1.0 : f32
    %exponent0 = scalar.mulf %lane_f, %log2_base_over_64 : f32
    %exponent = scalar.mulf %exponent0, %neg : f32
    %ln2 = scalar.constant 0.6931471805599453 : f32
    %natural = scalar.mulf %exponent, %ln2 : f32
    %inv_freq = scalar.expf<afn> %natural : f32
    %position_f = scalar.sitofp %position_low : i32 to f32
    %raw_angle = scalar.mulf %position_f, %inv_freq : f32
    // Reduce to [-pi, pi) before the approximate trig functions.
    %inv_two_pi = scalar.constant 0.15915494309189535 : f32
    %two_pi = scalar.constant 6.283185307179586 : f32
    %half = scalar.constant 0.5 : f32
    %turns_raw = scalar.mulf %raw_angle, %inv_two_pi : f32
    %turns_shifted = scalar.addf %turns_raw, %half : f32
    %turns_i = scalar.fptosi %turns_shifted : f32 to i32
    %turns = scalar.sitofp %turns_i : i32 to f32
    %wrapped = scalar.mulf %turns, %two_pi : f32
    %angle = scalar.subf %raw_angle, %wrapped : f32
    %cos = scalar.cosf<afn> %angle : f32
    %sin = scalar.sinf<afn> %angle : f32
    %a_cos = scalar.mulf %n_low, %cos : f32
    %b_sin = scalar.mulf %n_high, %sin : f32
    %rotated_low = scalar.subf %a_cos, %b_sin : f32
    %b_cos = scalar.mulf %n_high, %cos : f32
    %a_sin = scalar.mulf %n_low, %sin : f32
    %rotated_high = scalar.addf %b_cos, %a_sin : f32
    scf.yield %rotated_low, %rotated_high : f32, f32
  } else {
    scf.yield %n_low, %n_high : f32, f32
  }
  scf.if %is_query {
    %bounded_head = index.assume %head [lt(%head, %c32)] : index
    view.store %r_low, %q_view[%token, %bounded_head, %c0, %lane] : f32, view<[%tokens]x32x2x64xf32>
    view.store %r_high, %q_view[%token, %bounded_head, %c1, %lane] : f32, view<[%tokens]x32x2x64xf32>
  } else {
    scf.if %live {
      %bounded_kv = index.assume %kv_head [range(%kv_head, 0, 3)] : index
      %row_bound = scalar.assume %row32 [range(%row32, 0, 2147483646)] : i32
      %row = index.cast %row_bound : i32 to index
      %position_bound = scalar.assume %position_low [range(%position_low, 0, 262143)] : i32
      %position = index.cast %position_bound : i32 to index
      %padded = index.add %context, %c15 : index
      %blocks = index.div %padded, %c16 : index
      %k_plane = index.mul %layer, %c2 : index
      %v_plane = index.add %k_plane, %c1 : index
      %k_offset = func.call @flint_kv_offset(%origins, %row, %position, %blocks, %k_plane, %pool) : (buffer, index, index, index, index, index) -> (offset)
      %v_offset = func.call @flint_kv_offset(%origins, %row, %position, %blocks, %v_plane, %pool) : (buffer, index, index, index, index, index) -> (offset)
      %k_cache = buffer.view %arena[%k_offset] : buffer -> view<4x2x64xf16>
      %v_cache = buffer.view %arena[%v_offset] : buffer -> view<4x2x64xf16>
      %r_low_h = scalar.fptrunc %r_low : f32 to f16
      %r_high_h = scalar.fptrunc %r_high : f32 to f16
      view.store %r_low_h, %k_cache[%bounded_kv, %c0, %lane] : f16, view<4x2x64xf16>
      view.store %r_high_h, %k_cache[%bounded_kv, %c1, %lane] : f16, view<4x2x64xf16>
      %v_view = buffer.view %v[%zero] : buffer -> view<[%tokens]x4x2x64xf32>
      %v_low = view.load %v_view[%token, %bounded_kv, %c0, %lane] : view<[%tokens]x4x2x64xf32> -> f32
      %v_high = view.load %v_view[%token, %bounded_kv, %c1, %lane] : view<[%tokens]x4x2x64xf32> -> f32
      %v_low_h = scalar.fptrunc %v_low : f32 to f16
      %v_high_h = scalar.fptrunc %v_high : f32 to f16
      view.store %v_low_h, %v_cache[%bounded_kv, %c0, %lane] : f16, view<4x2x64xf16>
      view.store %v_high_h, %v_cache[%bounded_kv, %c1, %lane] : f16, view<4x2x64xf16>
    }
  }
  kernel.return
}

// Causal GQA attention with learned sinks over the paged KV planes.
// Workgroup (token, head) with 256 lanes. Scores for at most 4096 visible
// positions live in workgroup memory; sliding layers see the last 513
// positions including the current one. The value pass splits positions over
// eight subgroups; each lane owns four of the 128 output dimensions.
kernel.def export("flint_attention") @flint_attention(%tokens: index) {
  %c1 = index.constant 1 : index
  %c32 = index.constant 32 : index
  %c256 = index.constant 256 : index
  kernel.launch.config workgroups(%tokens, %c32, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%tokens_arg: index, %layer_arg: index, %sliding: i32, %context_arg: index, %pool_arg: index, %skip_uniform: i32, %q: buffer, %sinks: buffer, %info: buffer, %origins: buffer, %arena: buffer, %out: buffer) {
  %tokens = index.assume %tokens_arg [range(%tokens_arg, 1, 8192)] : index
  %layer = index.assume %layer_arg [range(%layer_arg, 0, 48)] : index
  %context = index.assume %context_arg [range(%context_arg, 16, 4096)] : index
  %pool = index.assume %pool_arg [range(%pool_arg, 16, 1048576)] : index
  %token_id = kernel.workgroup.id<x> : index
  %token = index.assume %token_id [lt(%token_id, %tokens)] : index
  %head_id = kernel.workgroup.id<y> : index
  %head = index.assume %head_id [range(%head_id, 0, 31)] : index
  %local_id = kernel.workitem.id<x> : index
  %local = index.assume %local_id [range(%local_id, 0, 255)] : index
  // With skip_uniform, tokens in tiles handled by flint_attention_flash exit.
  %c16_skip = index.constant 16 : index
  %c0_skip = scalar.constant 0 : i32
  %skip_enabled = scalar.cmpi ne, %skip_uniform, %c0_skip : i32
  %covered = scf.if %skip_enabled -> (i1) {
    %tile_of = index.div %token, %c16_skip : index
    %tile_first = index.mul %tile_of, %c16_skip : index
    %uniform, %r_unused, %p_unused = func.call @flint_tile_uniform(%info, %tokens, %tile_first) : (buffer, index, index) -> (i1, i32, i32)
    scf.yield %uniform : i1
  } else {
    %false_skip = scalar.constant false : i1
    scf.yield %false_skip : i1
  }
  %work = scalar.cmpi eq, %covered, %covered : i1
  %needed = scalar.xori %covered, %work : i1
  scf.if %needed {
  %zero = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c15 = index.constant 15 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c128 = index.constant 128 : index
  %c256 = index.constant 256 : index
  %c512 = index.constant 512 : index
  %c4096 = index.constant 4096 : index
  %c0_i32 = scalar.constant 0 : i32
  %zero_f = scalar.constant 0.0 : f32
  %info_view = buffer.view %info[%zero] : buffer -> view<[%tokens]x4xi32>
  %row32 = view.load %info_view[%token, 0] : view<[%tokens]x4xi32> -> i32
  %position32 = view.load %info_view[%token, 1] : view<[%tokens]x4xi32> -> i32
  %live32 = view.load %info_view[%token, 2] : view<[%tokens]x4xi32> -> i32
  %live = scalar.cmpi ne, %live32, %c0_i32 : i32
  %out_view = buffer.view %out[%zero] : buffer -> view<[%tokens]x32x32x4xf32>
  %scores_bytes = index.constant 16384 : offset
  %scores = buffer.alloca<workgroup> align(16) %scores_bytes : buffer
  %score_view = buffer.view %scores[%zero] : buffer -> view<4096xf32>
  %partial_bytes = index.constant 4096 : offset
  %partials = buffer.alloca<workgroup> align(16) %partial_bytes : buffer
  %partial_view = buffer.view %partials[%zero] : buffer -> view<8x32x4xf32>
  %sub_value = index.div %local, %c32 : index
  %sub = index.assume %sub_value [range(%sub_value, 0, 7)] : index
  %lane_value = index.rem %local, %c32 : index
  %lane = index.assume %lane_value [range(%lane_value, 0, 31)] : index
  scf.if %live {
    %row_bound = scalar.assume %row32 [range(%row32, 0, 2147483646)] : i32
    %row = index.cast %row_bound : i32 to index
    %position_bound = scalar.assume %position32 [range(%position32, 0, 4095)] : i32
    %position = index.cast %position_bound : i32 to index
    %padded = index.add %context, %c15 : index
    %blocks = index.div %padded, %c16 : index
    %kv_value = index.div %head, %c8 : index
    %kv_head = index.assume %kv_value [range(%kv_value, 0, 3)] : index
    %k_plane = index.mul %layer, %c2 : index
    %v_plane = index.add %k_plane, %c1 : index
    %is_sliding = scalar.cmpi ne, %sliding, %c0_i32 : i32
    %far = index.cmp ugt, %position, %c512 : index
    %use_window = scalar.andi %is_sliding, %far : i1
    %window_start = index.sub %position, %c512 : index
    %window_low = scf.select %use_window, %window_start, %c0 : index
    %end = index.add %position, %c1 : index
    %visible_value = index.sub %end, %window_low : index
    %visible = index.assume %visible_value [range(%visible_value, 1, 4096)] : index
    %q_view = buffer.view %q[%zero] : buffer -> view<[%tokens]x32x4x32xf32>
    %scale = scalar.constant 0.08838834764831845 : f32
    %neg_inf = scalar.constant -3.0e38 : f32
    %q0 = vector.load %q_view[%token, %head, %c0, %c0] : view<[%tokens]x32x4x32xf32> -> vector<32xf32>
    %q1 = vector.load %q_view[%token, %head, %c1, %c0] : view<[%tokens]x32x4x32xf32> -> vector<32xf32>
    %c3 = index.constant 3 : index
    %q2 = vector.load %q_view[%token, %head, %c2, %c0] : view<[%tokens]x32x4x32xf32> -> vector<32xf32>
    %q3 = vector.load %q_view[%token, %head, %c3, %c0] : view<[%tokens]x32x4x32xf32> -> vector<32xf32>
    // Phase 1: one visible position per lane per iteration.
    %local_max = scf.for %j = [%local to %visible step %c256](%m = %neg_inf : f32) -> (f32) {
      %key_position = index.add %window_low, %j : index
      %k_offset = func.call @flint_kv_offset(%origins, %row, %key_position, %blocks, %k_plane, %pool) : (buffer, index, index, index, index, index) -> (offset)
      %k_cache = buffer.view %arena[%k_offset] : buffer -> view<4x4x32xf32>
      %k0 = vector.load %k_cache[%kv_head, %c0, %c0] : view<4x4x32xf32> -> vector<32xf32>
      %k1 = vector.load %k_cache[%kv_head, %c1, %c0] : view<4x4x32xf32> -> vector<32xf32>
      %k2 = vector.load %k_cache[%kv_head, %c2, %c0] : view<4x4x32xf32> -> vector<32xf32>
      %k3 = vector.load %k_cache[%kv_head, %c3, %c0] : view<4x4x32xf32> -> vector<32xf32>
      %p0 = vector.mulf %q0, %k0 : vector<32xf32>
      %p1 = vector.fmaf %q1, %k1, %p0 : vector<32xf32>
      %p2 = vector.fmaf %q2, %k2, %p1 : vector<32xf32>
      %p3 = vector.fmaf %q3, %k3, %p2 : vector<32xf32>
      %dot = vector.reduce<addf> %p3, %zero_f : vector<32xf32>, f32
      %score = scalar.mulf %dot, %scale : f32
      %bounded_j = index.assume %j [lt(%j, %c4096)] : index
      view.store %score, %score_view[%bounded_j] : f32, view<4096xf32>
      %bigger = scalar.maxnumf %m, %score : f32
      scf.yield %bigger : f32
    }
    %sink_view = buffer.view %sinks[%zero] : buffer -> view<32xf32>
    %sink = view.load %sink_view[%head] : view<32xf32> -> f32
    %block_max = kernel.workgroup.reduce<maxnumf> %local_max : f32
    %maximum = scalar.maxnumf %block_max, %sink : f32
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    // Phase 2: exponentiate in place and reduce the denominator.
    %local_sum = scf.for %j = [%local to %visible step %c256](%s = %zero_f : f32) -> (f32) {
      %bounded_j = index.assume %j [lt(%j, %c4096)] : index
      %score = view.load %score_view[%bounded_j] : view<4096xf32> -> f32
      %shifted = scalar.subf %score, %maximum : f32
      %p = scalar.expf<afn> %shifted : f32
      view.store %p, %score_view[%bounded_j] : f32, view<4096xf32>
      %next = scalar.addf %s, %p : f32
      scf.yield %next : f32
    }
    %sum = kernel.workgroup.reduce<addf> %local_sum : f32
    %sink_shift = scalar.subf %sink, %maximum : f32
    %sink_weight = scalar.expf<afn> %sink_shift : f32
    %denominator = scalar.addf %sum, %sink_weight : f32
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    // Phase 3: subgroup s takes positions s, s+8, ...; lane l owns dims 4l..4l+3.
    %zero4 = vector.splat %zero_f : vector<4xf32>
    %weighted = scf.for %j = [%sub to %visible step %c8](%acc = %zero4 : vector<4xf32>) -> (vector<4xf32>) {
      %bounded_j = index.assume %j [lt(%j, %c4096)] : index
      %p = view.load %score_view[%bounded_j] : view<4096xf32> -> f32
      %key_position = index.add %window_low, %j : index
      %v_offset = func.call @flint_kv_offset(%origins, %row, %key_position, %blocks, %v_plane, %pool) : (buffer, index, index, index, index, index) -> (offset)
      %v_cache = buffer.view %arena[%v_offset] : buffer -> view<4x32x4xf32>
      %value = vector.load %v_cache[%kv_head, %lane, %c0] : view<4x32x4xf32> -> vector<4xf32>
      %ps = vector.splat %p : vector<4xf32>
      %next = vector.fmaf %ps, %value, %acc : vector<4xf32>
      scf.yield %next : vector<4xf32>
    }
    vector.store %weighted, %partial_view[%sub, %lane, %c0] : vector<4xf32>, view<8x32x4xf32>
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %first_sub = index.cmp eq, %sub, %c0 : index
    scf.if %first_sub {
      %total = scf.for %s = [%c0 to %c8 step %c1](%acc = %zero4 : vector<4xf32>) -> (vector<4xf32>) {
        %bounded_s = index.assume %s [range(%s, 0, 7)] : index
        %part = vector.load %partial_view[%bounded_s, %lane, %c0] : view<8x32x4xf32> -> vector<4xf32>
        %next = vector.addf %acc, %part : vector<4xf32>
        scf.yield %next : vector<4xf32>
      }
      %c1_f = scalar.constant 1.0 : f32
      %inv = scalar.divf %c1_f, %denominator : f32
      %invs = vector.splat %inv : vector<4xf32>
      %result = vector.mulf %total, %invs : vector<4xf32>
      vector.store %result, %out_view[%token, %head, %lane, %c0] : vector<4xf32>, view<[%tokens]x32x32x4xf32>
    }
  } else {
    %first_sub = index.cmp eq, %sub, %c0 : index
    scf.if %first_sub {
      %zero4 = vector.splat %zero_f : vector<4xf32>
      vector.store %zero4, %out_view[%token, %head, %lane, %c0] : vector<4xf32>, view<[%tokens]x32x32x4xf32>
    }
  }
  }
  kernel.return
}

kernel.def export("flint_attention_listed") @flint_attention_listed(%count_buffer: buffer) {
  %origin_c = index.constant 0 : offset
  %counts = buffer.view %count_buffer[%origin_c] : buffer -> view<1xi32>
  %word = view.load %counts[0] : view<1xi32> -> i32
  %bounded = scalar.assume %word [range(%word, 0, 8192)] : i32
  %count = index.cast %bounded : i32 to index
  %c1 = index.constant 1 : index
  %c32 = index.constant 32 : index
  %c256 = index.constant 256 : index
  kernel.launch.config workgroups(%count, %c32, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%tokens_arg: index, %layer_arg: index, %sliding: i32, %context_arg: index, %pool_arg: index, %list: buffer, %q: buffer, %sinks: buffer, %info: buffer, %origins: buffer, %arena: buffer, %out: buffer) {
  %tokens = index.assume %tokens_arg [range(%tokens_arg, 1, 8192)] : index
  %layer = index.assume %layer_arg [range(%layer_arg, 0, 48)] : index
  %context = index.assume %context_arg [range(%context_arg, 16, 4096)] : index
  %pool = index.assume %pool_arg [range(%pool_arg, 16, 1048576)] : index
