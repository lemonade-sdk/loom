  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c15 = index.constant 15 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c128 = index.constant 128 : index
  %c256 = index.constant 256 : index
  %c512 = index.constant 512 : index
  %c4096 = index.constant 4096 : index
  %c0_i32 = scalar.constant 0 : i32
  %zero_f = scalar.constant 0.0 : f32
  %info_view = buffer.view %info[%zero] : buffer -> view<[%tokens]x4xi32>
  %row32 = view.load %info_view[%token, 0] : view<[%tokens]x4xi32> -> i32
  %position32 = view.load %info_view[%token, 1] : view<[%tokens]x4xi32> -> i32
  %live32 = view.load %info_view[%token, 2] : view<[%tokens]x4xi32> -> i32
  %live = scalar.cmpi ne, %live32, %c0_i32 : i32
  %out_view = buffer.view %out[%zero] : buffer -> view<[%tokens]x32x32x4xf32>
  %scores_bytes = index.constant 16384 : offset
  %scores = buffer.alloca<workgroup> align(16) %scores_bytes : buffer
  %score_view = buffer.view %scores[%zero] : buffer -> view<4096xf32>
  %partial_bytes = index.constant 4096 : offset
  %partials = buffer.alloca<workgroup> align(16) %partial_bytes : buffer
  %partial_view = buffer.view %partials[%zero] : buffer -> view<8x32x4xf32>
  %sub_value = index.div %local, %c32 : index
  %sub = index.assume %sub_value [range(%sub_value, 0, 7)] : index
  %lane_value = index.rem %local, %c32 : index
  %lane = index.assume %lane_value [range(%lane_value, 0, 31)] : index
  scf.if %live {
    %row_bound = scalar.assume %row32 [range(%row32, 0, 2147483646)] : i32
    %row = index.cast %row_bound : i32 to index
    %position_bound = scalar.assume %position32 [range(%position32, 0, 4095)] : i32
    %position = index.cast %position_bound : i32 to index
    %padded = index.add %context, %c15 : index
    %blocks = index.div %padded, %c16 : index
    %kv_value = index.div %head, %c8 : index
    %kv_head = index.assume %kv_value [range(%kv_value, 0, 3)] : index
    %k_plane = index.mul %layer, %c2 : index
    %v_plane = index.add %k_plane, %c1 : index
    %is_sliding = scalar.cmpi ne, %sliding, %c0_i32 : i32
    %far = index.cmp ugt, %position, %c512 : index
    %use_window = scalar.andi %is_sliding, %far : i1
    %window_start = index.sub %position, %c512 : index
    %window_low = scf.select %use_window, %window_start, %c0 : index
    %end = index.add %position, %c1 : index
    %visible_value = index.sub %end, %window_low : index
    %visible = index.assume %visible_value [range(%visible_value, 1, 4096)] : index
    %q_view = buffer.view %q[%zero] : buffer -> view<[%tokens]x32x4x32xf32>
    %scale = scalar.constant 0.08838834764831845 : f32
    %neg_inf = scalar.constant -3.0e38 : f32
