kernel.def export("flint_attention_flash2") @flint_attention_flash2(%tokens: index) {
  %c1 = index.constant 1 : index
  %ckv = index.constant 4 : index
  %c16 = index.constant 16 : index
  %clanes = index.constant 256 : index
  %tiles = index.div %tokens, %c16 : index
  kernel.launch.config workgroups(%tiles, %ckv, %c1) workgroup_size(%clanes, %c1, %c1) : index
} launch(%tokens_arg: index, %layer_arg: index, %sliding: i32, %context_arg: index, %pool_arg: index, %q: buffer, %sinks: buffer, %info: buffer, %origins: buffer, %arena: buffer, %out: buffer) {
  %tokens = index.assume %tokens_arg [range(%tokens_arg, 16, 8192), multiple_of(%tokens_arg, 16)] : index
  %layer = index.assume %layer_arg [range(%layer_arg, 0, 48)] : index
  %context = index.assume %context_arg [range(%context_arg, 16, 262144)] : index
  %pool = index.assume %pool_arg [range(%pool_arg, 16, 1048576)] : index
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c8 = index.constant 8 : index
  %c15 = index.constant 15 : index
  %c16 = index.constant 16 : index
  %c31 = index.constant 31 : index
  %c32 = index.constant 32 : index
  %c128 = index.constant 128 : index
  %c0_i32 = scalar.constant 0 : i32
  %d0 = index.constant 0 : index
  %d1 = index.constant 16 : index
  %d2 = index.constant 32 : index
  %d3 = index.constant 48 : index
  %d4 = index.constant 64 : index
  %d5 = index.constant 80 : index
  %d6 = index.constant 96 : index
  %d7 = index.constant 112 : index
  %d0r = index.constant 0 : index
  %d16r = index.constant 16 : index
  %d32r = index.constant 32 : index
  %d48r = index.constant 48 : index
  %d64r = index.constant 64 : index
  %d80r = index.constant 80 : index
  %d96r = index.constant 96 : index
  %d112r = index.constant 112 : index
  %d0i = index.constant 0 : index
  %d1i = index.constant 1 : index
  %d2i = index.constant 2 : index
  %d3i = index.constant 3 : index
  %d4i = index.constant 4 : index
  %d5i = index.constant 5 : index
  %d6i = index.constant 6 : index
  %d7i = index.constant 7 : index
  %kb0_row = index.constant 0 : index
  %kb1_row = index.constant 16 : index
  %kbo0 = scalar.constant 0 : i32
  %kbo1 = scalar.constant 16 : i32
  %tile_count = index.div %tokens, %c16 : index
  %tile_id = kernel.workgroup.id<x> : index
  %tile = index.assume %tile_id [lt(%tile_id, %tile_count)] : index
  %kv_id = kernel.workgroup.id<y> : index
  %kv = index.assume %kv_id [range(%kv_id, 0, 3)] : index
  %first_token = index.mul %tile, %c16 : index
  %uniform, %row32, %pos0_32 = func.call @flint_tile_uniform(%info, %tokens, %first_token) : (buffer, index, index) -> (i1, i32, i32)
  scf.if %uniform {
  %workitem_id = kernel.workitem.id<x> : index
  %workitem = index.assume %workitem_id [range(%workitem_id, 0, 255)] : index
  %wave_id = kernel.subgroup.id : index
  %wave = index.assume %wave_id [range(%wave_id, 0, 7)] : index
  %lane_id = kernel.subgroup.lane.id : index
  %lane = index.assume %lane_id [range(%lane_id, 0, 31)] : index
  %lane_col = index.rem %lane, %c16 : index
  %lane_half = index.div %lane, %c16 : index
  %hi_half = index.cmp ne, %lane_half, %c0 : index
  %row_bound = scalar.assume %row32 [range(%row32, 0, 2147483646)] : i32
  %row = index.cast %row_bound : i32 to index
  %pos0_bound = scalar.assume %pos0_32 [range(%pos0_32, 0, 262128)] : i32
  %pos0 = index.cast %pos0_bound : i32 to index
  %pos_last = index.add %pos0, %c15 : index
  %padded = index.add %context, %c15 : index
  %blocks = index.div %padded, %c16 : index
  %k_plane = index.mul %layer, %c2 : index
  %v_plane = index.add %k_plane, %c1 : index
  %is_sliding = scalar.cmpi ne, %sliding, %c0_i32 : i32
  %window = index.constant 513 : index
  %window_less = index.constant 512 : index
  %far = index.cmp uge, %pos0, %window : index
  %use_window = scalar.andi %is_sliding, %far : i1
  %window_start = index.sub %pos0, %window_less : index
  %key_low = scf.select %use_window, %window_start, %c0 : index
  %key_span = index.sub %pos_last, %key_low : index
  %key_count_value = index.add %key_span, %c1 : index
  %key_count = index.assume %key_count_value [range(%key_count_value, 1, 262144)] : index
  %key_tiles_round = index.add %key_count, %c31 : index
  %key_tiles = index.div %key_tiles_round, %c32 : index
  %c16h = index.constant 8 : index
  %head_value = index.madd %kv, %c16h, %wave : index
  %head = index.assume %head_value [range(%head_value, 0, 31)] : index

  // K [32 keys x 128 dims] and V^T [128 dims x 32 keys] tiles (F16, padded rows).
  %k_bytes = index.constant 8704 : offset
  %k_tile = buffer.alloca<workgroup> align(16) %k_bytes : buffer
  %k_view = buffer.view %k_tile[%origin] : buffer -> view<32x136xf16>
  %vt_bytes = index.constant 10240 : offset
  %vt_tile = buffer.alloca<workgroup> align(16) %vt_bytes : buffer
  %vt_view = buffer.view %vt_tile[%origin] : buffer -> view<128x40xf16>

  // Q^T as MMA rhs: lane column = token lane%16, 16 dims per fragment.
  %q_view = buffer.view %q[%origin] : buffer -> view<[%tokens]x32x8x16xf32>
  %q_token_value = index.add %first_token, %lane_col : index
  %q_token = index.assume %q_token_value [lt(%q_token_value, %tokens)] : index
  %qc0 = index.constant 0 : index
  %qraw0 = vector.load %q_view[%q_token, %head, %qc0, %c0] : view<[%tokens]x32x8x16xf32> -> vector<16xf32>
  %qh0 = vector.fptrunc %qraw0 : vector<16xf32> to vector<16xf16>
  %qf0 = vector.fragment<rhs> %qh0 shape [%c16, %c16] : vector<16xf16>
  %qc1 = index.constant 1 : index
  %qraw1 = vector.load %q_view[%q_token, %head, %qc1, %c0] : view<[%tokens]x32x8x16xf32> -> vector<16xf32>
  %qh1 = vector.fptrunc %qraw1 : vector<16xf32> to vector<16xf16>
  %qf1 = vector.fragment<rhs> %qh1 shape [%c16, %c16] : vector<16xf16>
  %qc2 = index.constant 2 : index
  %qraw2 = vector.load %q_view[%q_token, %head, %qc2, %c0] : view<[%tokens]x32x8x16xf32> -> vector<16xf32>
  %qh2 = vector.fptrunc %qraw2 : vector<16xf32> to vector<16xf16>
  %qf2 = vector.fragment<rhs> %qh2 shape [%c16, %c16] : vector<16xf16>
  %qc3 = index.constant 3 : index
  %qraw3 = vector.load %q_view[%q_token, %head, %qc3, %c0] : view<[%tokens]x32x8x16xf32> -> vector<16xf32>
  %qh3 = vector.fptrunc %qraw3 : vector<16xf32> to vector<16xf16>
  %qf3 = vector.fragment<rhs> %qh3 shape [%c16, %c16] : vector<16xf16>
  %qc4 = index.constant 4 : index
  %qraw4 = vector.load %q_view[%q_token, %head, %qc4, %c0] : view<[%tokens]x32x8x16xf32> -> vector<16xf32>
  %qh4 = vector.fptrunc %qraw4 : vector<16xf32> to vector<16xf16>
  %qf4 = vector.fragment<rhs> %qh4 shape [%c16, %c16] : vector<16xf16>
  %qc5 = index.constant 5 : index
  %qraw5 = vector.load %q_view[%q_token, %head, %qc5, %c0] : view<[%tokens]x32x8x16xf32> -> vector<16xf32>
  %qh5 = vector.fptrunc %qraw5 : vector<16xf32> to vector<16xf16>
  %qf5 = vector.fragment<rhs> %qh5 shape [%c16, %c16] : vector<16xf16>
  %qc6 = index.constant 6 : index
  %qraw6 = vector.load %q_view[%q_token, %head, %qc6, %c0] : view<[%tokens]x32x8x16xf32> -> vector<16xf32>
  %qh6 = vector.fptrunc %qraw6 : vector<16xf32> to vector<16xf16>
  %qf6 = vector.fragment<rhs> %qh6 shape [%c16, %c16] : vector<16xf16>
  %qc7 = index.constant 7 : index
  %qraw7 = vector.load %q_view[%q_token, %head, %qc7, %c0] : view<[%tokens]x32x8x16xf32> -> vector<16xf32>
  %qh7 = vector.fptrunc %qraw7 : vector<16xf32> to vector<16xf16>
  %qf7 = vector.fragment<rhs> %qh7 shape [%c16, %c16] : vector<16xf16>
  %zero8 = vector.constant 0.0 : vector<8xf32>
  %init = vector.fragment<init> %zero8 shape [%c16, %c16] : vector<8xf32>
  %zero_f = scalar.constant 0.0 : f32
  %neg_big = scalar.constant -3.0e38 : f32
  %scale = scalar.constant 0.08838834764831845 : f32
  %scale_v = vector.splat %scale : vector<8xf32>
  %neg_v = vector.splat %neg_big : vector<8xf32>
  %zero_v8 = vector.constant 0.0 : vector<8xf32>
  %exchange = scalar.constant 16 : i32
  %width = scalar.constant 32 : i32
  %one_i32 = scalar.constant 1 : i32
  %two_i32 = scalar.constant 2 : i32
  %c2047_i32 = scalar.constant 512 : i32
  %true_const = scalar.constant true : i1
  %not_sliding = scalar.xori %is_sliding, %true_const : i1
  %ns_v = vector.splat %not_sliding : vector<8xi1>
  // This lane's query position and its keys' row offsets within a 16-key block.
  %query_pos = index.add %pos0, %lane_col : index
  %qp32 = index.cast %query_pos : index to i32
  %qp_v = vector.splat %qp32 : vector<8xi32>
  %low32 = scalar.subi %qp32, %c2047_i32 : i32
  %low_v = vector.splat %low32 : vector<8xi32>
  %half32 = index.cast %lane_half : index to i32
  %row_off = vector.iota %half32 step %two_i32 : vector<8xi32>

  // Staging: thread t loads key t/8, dims (t%8)*16.
  %ctpk = index.constant 8 : index
  %cdpt = index.constant 16 : index
  %st_key_value = index.div %workitem, %ctpk : index
  %st_key = index.assume %st_key_value [range(%st_key_value, 0, 31)] : index
  %st_seg = index.rem %workitem, %ctpk : index
  %st_dim_value = index.mul %st_seg, %cdpt : index
  %st_dim = index.assume %st_dim_value [range(%st_dim_value, 0, 112)] : index
  %kz = vector.constant 0.0 : vector<16xf16>

  %sinks_view = buffer.view %sinks[%origin] : buffer -> view<32xf32>
  %sink = view.load %sinks_view[%head] : view<32xf32> -> f32
  %one_init = scalar.constant 1.0 : f32
  %m_final, %l_final, %o0, %o1, %o2, %o3, %o4, %o5, %o6, %o7 = scf.for %kt = [%c0 to %key_tiles step %c1](%m = %sink : f32, %l = %one_init : f32, %a0 = %init : vector<8xf32>, %a1 = %init : vector<8xf32>, %a2 = %init : vector<8xf32>, %a3 = %init : vector<8xf32>, %a4 = %init : vector<8xf32>, %a5 = %init : vector<8xf32>, %a6 = %init : vector<8xf32>, %a7 = %init : vector<8xf32>) -> (f32, f32, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
    %tile_first = index.madd %kt, %c32, %key_low : index
    %key_pos = index.add %tile_first, %st_key : index
    %key_valid = index.cmp ule, %key_pos, %pos_last : index
    %kvals, %vvals = scf.if %key_valid -> (vector<16xf16>, vector<16xf16>) {
      %kp = index.assume %key_pos [range(%key_pos, 0, 262143)] : index
      %k_offset = func.call @flint_kv_offset(%origins, %row, %kp, %blocks, %k_plane, %pool) : (buffer, index, index, index, index, index) -> (offset)
      %v_offset = func.call @flint_kv_offset(%origins, %row, %kp, %blocks, %v_plane, %pool) : (buffer, index, index, index, index, index) -> (offset)
      %k_cache = buffer.view %arena[%k_offset] : buffer -> view<4x128xf16>
      %v_cache = buffer.view %arena[%v_offset] : buffer -> view<4x128xf16>
      %kh = vector.load %k_cache[%kv, %st_dim] : view<4x128xf16> -> vector<16xf16>
      %vh = vector.load %v_cache[%kv, %st_dim] : view<4x128xf16> -> vector<16xf16>
      scf.yield %kh, %vh : vector<16xf16>, vector<16xf16>
    } else {
      scf.yield %kz, %kz : vector<16xf16>, vector<16xf16>
    }
    vector.store %kvals, %k_view[%st_key, %st_dim] : vector<16xf16>, view<32x136xf16>
    scf.for %j = [%c0 to %cdpt step %c1] unroll {
      %vj = vector.extract %vvals[%j] : vector<16xf16> -> f16
      %vt_row_value = index.add %st_dim, %j : index
      %vt_row = index.assume %vt_row_value [range(%vt_row_value, 0, 127)] : index
      view.store %vj, %vt_view[%vt_row, %st_key] : f16, view<128x40xf16>
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %tf32 = index.cast %tile_first : index to i32
    %kl0_0 = vector.fragment.load<lhs> %k_view[%kb0_row, %d0] shape [%c16, %c16] : view<32x136xf16> -> vector<16xf16>
    %s0_0 = vector.mma %kl0_0, %qf0, %init : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kl0_1 = vector.fragment.load<lhs> %k_view[%kb0_row, %d1] shape [%c16, %c16] : view<32x136xf16> -> vector<16xf16>
    %s0_1 = vector.mma %kl0_1, %qf1, %s0_0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kl0_2 = vector.fragment.load<lhs> %k_view[%kb0_row, %d2] shape [%c16, %c16] : view<32x136xf16> -> vector<16xf16>
    %s0_2 = vector.mma %kl0_2, %qf2, %s0_1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kl0_3 = vector.fragment.load<lhs> %k_view[%kb0_row, %d3] shape [%c16, %c16] : view<32x136xf16> -> vector<16xf16>
    %s0_3 = vector.mma %kl0_3, %qf3, %s0_2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kl0_4 = vector.fragment.load<lhs> %k_view[%kb0_row, %d4] shape [%c16, %c16] : view<32x136xf16> -> vector<16xf16>
    %s0_4 = vector.mma %kl0_4, %qf4, %s0_3 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kl0_5 = vector.fragment.load<lhs> %k_view[%kb0_row, %d5] shape [%c16, %c16] : view<32x136xf16> -> vector<16xf16>
    %s0_5 = vector.mma %kl0_5, %qf5, %s0_4 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kl0_6 = vector.fragment.load<lhs> %k_view[%kb0_row, %d6] shape [%c16, %c16] : view<32x136xf16> -> vector<16xf16>
    %s0_6 = vector.mma %kl0_6, %qf6, %s0_5 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kl0_7 = vector.fragment.load<lhs> %k_view[%kb0_row, %d7] shape [%c16, %c16] : view<32x136xf16> -> vector<16xf16>
    %s0_7 = vector.mma %kl0_7, %qf7, %s0_6 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %sc0 = vector.mulf %s0_7, %scale_v : vector<8xf32>
    %base0 = scalar.addi %tf32, %kbo0 : i32
    %base0_v = vector.splat %base0 : vector<8xi32>
    %kpos0 = vector.addi %base0_v, %row_off : vector<8xi32>
    %causal0 = vector.cmpi sle, %kpos0, %qp_v : vector<8xi32> -> vector<8xi1>
    %inwin0 = vector.cmpi sge, %kpos0, %low_v : vector<8xi32> -> vector<8xi1>
    %winok0 = vector.ori %inwin0, %ns_v : vector<8xi1>
    %valid0 = vector.andi %causal0, %winok0 : vector<8xi1>
    %masked0 = vector.select %valid0, %sc0, %neg_v : vector<8xf32>
    %lmax0 = vector.reduce<maxnumf> %masked0, %neg_big : vector<8xf32>, f32
    %kl1_0 = vector.fragment.load<lhs> %k_view[%kb1_row, %d0] shape [%c16, %c16] : view<32x136xf16> -> vector<16xf16>
    %s1_0 = vector.mma %kl1_0, %qf0, %init : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kl1_1 = vector.fragment.load<lhs> %k_view[%kb1_row, %d1] shape [%c16, %c16] : view<32x136xf16> -> vector<16xf16>
    %s1_1 = vector.mma %kl1_1, %qf1, %s1_0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kl1_2 = vector.fragment.load<lhs> %k_view[%kb1_row, %d2] shape [%c16, %c16] : view<32x136xf16> -> vector<16xf16>
    %s1_2 = vector.mma %kl1_2, %qf2, %s1_1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kl1_3 = vector.fragment.load<lhs> %k_view[%kb1_row, %d3] shape [%c16, %c16] : view<32x136xf16> -> vector<16xf16>
    %s1_3 = vector.mma %kl1_3, %qf3, %s1_2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kl1_4 = vector.fragment.load<lhs> %k_view[%kb1_row, %d4] shape [%c16, %c16] : view<32x136xf16> -> vector<16xf16>
    %s1_4 = vector.mma %kl1_4, %qf4, %s1_3 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kl1_5 = vector.fragment.load<lhs> %k_view[%kb1_row, %d5] shape [%c16, %c16] : view<32x136xf16> -> vector<16xf16>
    %s1_5 = vector.mma %kl1_5, %qf5, %s1_4 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kl1_6 = vector.fragment.load<lhs> %k_view[%kb1_row, %d6] shape [%c16, %c16] : view<32x136xf16> -> vector<16xf16>
    %s1_6 = vector.mma %kl1_6, %qf6, %s1_5 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kl1_7 = vector.fragment.load<lhs> %k_view[%kb1_row, %d7] shape [%c16, %c16] : view<32x136xf16> -> vector<16xf16>
    %s1_7 = vector.mma %kl1_7, %qf7, %s1_6 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %sc1 = vector.mulf %s1_7, %scale_v : vector<8xf32>
    %base1 = scalar.addi %tf32, %kbo1 : i32
    %base1_v = vector.splat %base1 : vector<8xi32>
    %kpos1 = vector.addi %base1_v, %row_off : vector<8xi32>
    %causal1 = vector.cmpi sle, %kpos1, %qp_v : vector<8xi32> -> vector<8xi1>
    %inwin1 = vector.cmpi sge, %kpos1, %low_v : vector<8xi32> -> vector<8xi1>
    %winok1 = vector.ori %inwin1, %ns_v : vector<8xi1>
    %valid1 = vector.andi %causal1, %winok1 : vector<8xi1>
    %masked1 = vector.select %valid1, %sc1, %neg_v : vector<8xf32>
    %lmax1 = vector.reduce<maxnumf> %masked1, %neg_big : vector<8xf32>, f32
    %lmax = scalar.maxnumf %lmax0, %lmax1 : f32
    %omax, %omax_u = kernel.subgroup.shuffle<xor> %lmax, %exchange, %width : f32, i32, i32
    %tmax = scalar.maxnumf %lmax, %omax : f32
    %m_new = scalar.maxnumf %m, %tmax : f32
    %m_shift = scalar.subf %m, %m_new : f32
    %alpha = scalar.expf<afn> %m_shift : f32
    %m_new_v = vector.splat %m_new : vector<8xf32>
    %sh0 = vector.subf %masked0, %m_new_v : vector<8xf32>
    %pe0 = vector.expf<afn> %sh0 : vector<8xf32>
    %p0 = vector.select %valid0, %pe0, %zero_v8 : vector<8xf32>
    %ls0 = vector.reduce<addf> %p0, %zero_f : vector<8xf32>, f32
    %pi0_0 = vector.extract %p0[%d0i] : vector<8xf32> -> f32
    %po0_0, %pu0_0 = kernel.subgroup.shuffle<xor> %pi0_0, %exchange, %width : f32, i32, i32
    %pi0_1 = vector.extract %p0[%d1i] : vector<8xf32> -> f32
    %po0_1, %pu0_1 = kernel.subgroup.shuffle<xor> %pi0_1, %exchange, %width : f32, i32, i32
    %pi0_2 = vector.extract %p0[%d2i] : vector<8xf32> -> f32
    %po0_2, %pu0_2 = kernel.subgroup.shuffle<xor> %pi0_2, %exchange, %width : f32, i32, i32
    %pi0_3 = vector.extract %p0[%d3i] : vector<8xf32> -> f32
    %po0_3, %pu0_3 = kernel.subgroup.shuffle<xor> %pi0_3, %exchange, %width : f32, i32, i32
    %pi0_4 = vector.extract %p0[%d4i] : vector<8xf32> -> f32
    %po0_4, %pu0_4 = kernel.subgroup.shuffle<xor> %pi0_4, %exchange, %width : f32, i32, i32
    %pi0_5 = vector.extract %p0[%d5i] : vector<8xf32> -> f32
    %po0_5, %pu0_5 = kernel.subgroup.shuffle<xor> %pi0_5, %exchange, %width : f32, i32, i32
    %pi0_6 = vector.extract %p0[%d6i] : vector<8xf32> -> f32
    %po0_6, %pu0_6 = kernel.subgroup.shuffle<xor> %pi0_6, %exchange, %width : f32, i32, i32
    %pi0_7 = vector.extract %p0[%d7i] : vector<8xf32> -> f32
    %po0_7, %pu0_7 = kernel.subgroup.shuffle<xor> %pi0_7, %exchange, %width : f32, i32, i32
    %partner0 = vector.from_elements %po0_0, %po0_1, %po0_2, %po0_3, %po0_4, %po0_5, %po0_6, %po0_7 : vector<8xf32>
    %even0 = scf.select %hi_half, %partner0, %p0 : vector<8xf32>
    %odd0 = scf.select %hi_half, %p0, %partner0 : vector<8xf32>
    %pt0_f = vector.interleave<0> %even0, %odd0 : vector<8xf32>, vector<8xf32> -> vector<16xf32>
    %pt0_h = vector.fptrunc %pt0_f : vector<16xf32> to vector<16xf16>
    %pt0 = vector.fragment<rhs> %pt0_h shape [%c16, %c16] : vector<16xf16>
    %sh1 = vector.subf %masked1, %m_new_v : vector<8xf32>
    %pe1 = vector.expf<afn> %sh1 : vector<8xf32>
    %p1 = vector.select %valid1, %pe1, %zero_v8 : vector<8xf32>
    %ls1 = vector.reduce<addf> %p1, %zero_f : vector<8xf32>, f32
    %pi1_0 = vector.extract %p1[%d0i] : vector<8xf32> -> f32
    %po1_0, %pu1_0 = kernel.subgroup.shuffle<xor> %pi1_0, %exchange, %width : f32, i32, i32
    %pi1_1 = vector.extract %p1[%d1i] : vector<8xf32> -> f32
    %po1_1, %pu1_1 = kernel.subgroup.shuffle<xor> %pi1_1, %exchange, %width : f32, i32, i32
    %pi1_2 = vector.extract %p1[%d2i] : vector<8xf32> -> f32
    %po1_2, %pu1_2 = kernel.subgroup.shuffle<xor> %pi1_2, %exchange, %width : f32, i32, i32
    %pi1_3 = vector.extract %p1[%d3i] : vector<8xf32> -> f32
    %po1_3, %pu1_3 = kernel.subgroup.shuffle<xor> %pi1_3, %exchange, %width : f32, i32, i32
    %pi1_4 = vector.extract %p1[%d4i] : vector<8xf32> -> f32
    %po1_4, %pu1_4 = kernel.subgroup.shuffle<xor> %pi1_4, %exchange, %width : f32, i32, i32
    %pi1_5 = vector.extract %p1[%d5i] : vector<8xf32> -> f32
    %po1_5, %pu1_5 = kernel.subgroup.shuffle<xor> %pi1_5, %exchange, %width : f32, i32, i32
    %pi1_6 = vector.extract %p1[%d6i] : vector<8xf32> -> f32
    %po1_6, %pu1_6 = kernel.subgroup.shuffle<xor> %pi1_6, %exchange, %width : f32, i32, i32
    %pi1_7 = vector.extract %p1[%d7i] : vector<8xf32> -> f32
    %po1_7, %pu1_7 = kernel.subgroup.shuffle<xor> %pi1_7, %exchange, %width : f32, i32, i32
    %partner1 = vector.from_elements %po1_0, %po1_1, %po1_2, %po1_3, %po1_4, %po1_5, %po1_6, %po1_7 : vector<8xf32>
    %even1 = scf.select %hi_half, %partner1, %p1 : vector<8xf32>
    %odd1 = scf.select %hi_half, %p1, %partner1 : vector<8xf32>
    %pt1_f = vector.interleave<0> %even1, %odd1 : vector<8xf32>, vector<8xf32> -> vector<16xf32>
    %pt1_h = vector.fptrunc %pt1_f : vector<16xf32> to vector<16xf16>
    %pt1 = vector.fragment<rhs> %pt1_h shape [%c16, %c16] : vector<16xf16>
    %lsum = scalar.addf %ls0, %ls1 : f32
    %osum, %osum_u = kernel.subgroup.shuffle<xor> %lsum, %exchange, %width : f32, i32, i32
    %tsum = scalar.addf %lsum, %osum : f32
    %l_scaled = scalar.mulf %l, %alpha : f32
    %l_new = scalar.addf %l_scaled, %tsum : f32
    %alpha_v = vector.splat %alpha : vector<8xf32>
    %os0 = vector.mulf %a0, %alpha_v : vector<8xf32>
    %vl0_0 = vector.fragment.load<lhs> %vt_view[%d0r, %c0] shape [%c16, %c16] : view<128x40xf16> -> vector<16xf16>
    %vl0_1 = vector.fragment.load<lhs> %vt_view[%d0r, %c16] shape [%c16, %c16] : view<128x40xf16> -> vector<16xf16>
    %on0a = vector.mma %vl0_0, %pt0, %os0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %on0 = vector.mma %vl0_1, %pt1, %on0a : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %os1 = vector.mulf %a1, %alpha_v : vector<8xf32>
    %vl1_0 = vector.fragment.load<lhs> %vt_view[%d16r, %c0] shape [%c16, %c16] : view<128x40xf16> -> vector<16xf16>
    %vl1_1 = vector.fragment.load<lhs> %vt_view[%d16r, %c16] shape [%c16, %c16] : view<128x40xf16> -> vector<16xf16>
    %on1a = vector.mma %vl1_0, %pt0, %os1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %on1 = vector.mma %vl1_1, %pt1, %on1a : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %os2 = vector.mulf %a2, %alpha_v : vector<8xf32>
    %vl2_0 = vector.fragment.load<lhs> %vt_view[%d32r, %c0] shape [%c16, %c16] : view<128x40xf16> -> vector<16xf16>
    %vl2_1 = vector.fragment.load<lhs> %vt_view[%d32r, %c16] shape [%c16, %c16] : view<128x40xf16> -> vector<16xf16>
    %on2a = vector.mma %vl2_0, %pt0, %os2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %on2 = vector.mma %vl2_1, %pt1, %on2a : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %os3 = vector.mulf %a3, %alpha_v : vector<8xf32>
    %vl3_0 = vector.fragment.load<lhs> %vt_view[%d48r, %c0] shape [%c16, %c16] : view<128x40xf16> -> vector<16xf16>
    %vl3_1 = vector.fragment.load<lhs> %vt_view[%d48r, %c16] shape [%c16, %c16] : view<128x40xf16> -> vector<16xf16>
    %on3a = vector.mma %vl3_0, %pt0, %os3 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %on3 = vector.mma %vl3_1, %pt1, %on3a : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %os4 = vector.mulf %a4, %alpha_v : vector<8xf32>
    %vl4_0 = vector.fragment.load<lhs> %vt_view[%d64r, %c0] shape [%c16, %c16] : view<128x40xf16> -> vector<16xf16>
    %vl4_1 = vector.fragment.load<lhs> %vt_view[%d64r, %c16] shape [%c16, %c16] : view<128x40xf16> -> vector<16xf16>
    %on4a = vector.mma %vl4_0, %pt0, %os4 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %on4 = vector.mma %vl4_1, %pt1, %on4a : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %os5 = vector.mulf %a5, %alpha_v : vector<8xf32>
    %vl5_0 = vector.fragment.load<lhs> %vt_view[%d80r, %c0] shape [%c16, %c16] : view<128x40xf16> -> vector<16xf16>
    %vl5_1 = vector.fragment.load<lhs> %vt_view[%d80r, %c16] shape [%c16, %c16] : view<128x40xf16> -> vector<16xf16>
    %on5a = vector.mma %vl5_0, %pt0, %os5 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %on5 = vector.mma %vl5_1, %pt1, %on5a : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %os6 = vector.mulf %a6, %alpha_v : vector<8xf32>
    %vl6_0 = vector.fragment.load<lhs> %vt_view[%d96r, %c0] shape [%c16, %c16] : view<128x40xf16> -> vector<16xf16>
    %vl6_1 = vector.fragment.load<lhs> %vt_view[%d96r, %c16] shape [%c16, %c16] : view<128x40xf16> -> vector<16xf16>
    %on6a = vector.mma %vl6_0, %pt0, %os6 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %on6 = vector.mma %vl6_1, %pt1, %on6a : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %os7 = vector.mulf %a7, %alpha_v : vector<8xf32>
    %vl7_0 = vector.fragment.load<lhs> %vt_view[%d112r, %c0] shape [%c16, %c16] : view<128x40xf16> -> vector<16xf16>
    %vl7_1 = vector.fragment.load<lhs> %vt_view[%d112r, %c16] shape [%c16, %c16] : view<128x40xf16> -> vector<16xf16>
    %on7a = vector.mma %vl7_0, %pt0, %os7 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %on7 = vector.mma %vl7_1, %pt1, %on7a : vector<16xf16>, vector<16xf16>, vector<8xf32>
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    scf.yield %m_new, %l_new, %on0, %on1, %on2, %on3, %on4, %on5, %on6, %on7 : f32, f32, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
  }
  // O^T / l (lane-uniform), gate, and store through a transposed strided view:
  // element (dim row, token column) -> out[first_token + col, head*128 + row].
  %one_f = scalar.constant 1.0 : f32
  %inv_l = scalar.divf %one_f, %l_final : f32
  %inv_v = vector.splat %inv_l : vector<8xf32>
  %c4096 = index.constant 4096 : index
  %out_layout = encoding.layout.strided [%c1, %c4096] : encoding<layout>
  %out_first_a = index.mul %first_token, %c4096 : index
  %head_col = index.mul %head, %c128 : index
  %out_first = index.add %out_first_a, %head_col : index
  %four = index.constant 4 : offset
  %out_offset = index.scale %out_first, %four : index, offset -> offset
  %out_view = buffer.view %out[%out_offset] : buffer -> view<128x16xf32, %out_layout>
  %ou0 = vector.mulf %o0, %inv_v : vector<8xf32>
  %of0 = vector.addf %ou0, %zero_v8 : vector<8xf32>
  vector.fragment.store<result> %of0, %out_view[%d0r, %c0] shape [%c16, %c16] : vector<8xf32>, view<128x16xf32, %out_layout>
  %ou1 = vector.mulf %o1, %inv_v : vector<8xf32>
  %of1 = vector.addf %ou1, %zero_v8 : vector<8xf32>
  vector.fragment.store<result> %of1, %out_view[%d16r, %c0] shape [%c16, %c16] : vector<8xf32>, view<128x16xf32, %out_layout>
  %ou2 = vector.mulf %o2, %inv_v : vector<8xf32>
  %of2 = vector.addf %ou2, %zero_v8 : vector<8xf32>
  vector.fragment.store<result> %of2, %out_view[%d32r, %c0] shape [%c16, %c16] : vector<8xf32>, view<128x16xf32, %out_layout>
  %ou3 = vector.mulf %o3, %inv_v : vector<8xf32>
  %of3 = vector.addf %ou3, %zero_v8 : vector<8xf32>
  vector.fragment.store<result> %of3, %out_view[%d48r, %c0] shape [%c16, %c16] : vector<8xf32>, view<128x16xf32, %out_layout>
  %ou4 = vector.mulf %o4, %inv_v : vector<8xf32>
  %of4 = vector.addf %ou4, %zero_v8 : vector<8xf32>
  vector.fragment.store<result> %of4, %out_view[%d64r, %c0] shape [%c16, %c16] : vector<8xf32>, view<128x16xf32, %out_layout>
  %ou5 = vector.mulf %o5, %inv_v : vector<8xf32>
  %of5 = vector.addf %ou5, %zero_v8 : vector<8xf32>
  vector.fragment.store<result> %of5, %out_view[%d80r, %c0] shape [%c16, %c16] : vector<8xf32>, view<128x16xf32, %out_layout>
  %ou6 = vector.mulf %o6, %inv_v : vector<8xf32>
  %of6 = vector.addf %ou6, %zero_v8 : vector<8xf32>
  vector.fragment.store<result> %of6, %out_view[%d96r, %c0] shape [%c16, %c16] : vector<8xf32>, view<128x16xf32, %out_layout>
  %ou7 = vector.mulf %o7, %inv_v : vector<8xf32>
  %of7 = vector.addf %ou7, %zero_v8 : vector<8xf32>
  vector.fragment.store<result> %of7, %out_view[%d112r, %c0] shape [%c16, %c16] : vector<8xf32>, view<128x16xf32, %out_layout>
  }
  kernel.return
}
