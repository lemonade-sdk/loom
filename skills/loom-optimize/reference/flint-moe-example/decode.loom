// Splits for `visible` keys: about 32 keys each, at most 64.
func.def inline @flint_split_count(%visible: index) -> (index) {
  %c1 = index.constant 1 : index
  %c127 = index.constant 31 : index
  %c128 = index.constant 32 : index
  %cmax = index.constant 64 : index
  %padded = index.add %visible, %c127 : index
  %target = index.div %padded, %c128 : index
  %capped = index.min %target, %cmax : index
  %count_value = index.max %capped, %c1 : index
  %count = index.assume %count_value [range(%count_value, 1, 64)] : index
  func.return %count : index
}

// Decode attention (split-K / flash-decoding). One 256-lane workgroup per
// (token, KV head, key split); wave w handles query head 8*kv + w, so the 8
// query heads sharing a KV head read each K/V row once per workgroup. Lane l
// owns head dims 4l..4l+3. Each split writes an unnormalized partial
// (max, sum, acc[128]); flint_attention_combine folds the splits and the
// learned sink.

kernel.def export("flint_attention_split") @flint_attention_split(%tokens: index) {
  %c4 = index.constant 4 : index
  %c16 = index.constant 16 : index
  %c256 = index.constant 256 : index
  %c1 = index.constant 1 : index
