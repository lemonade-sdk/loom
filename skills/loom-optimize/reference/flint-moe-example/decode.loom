      %s12 = scf.select %ok12, %sr12, %neg_big : f32
      %prod13 = vector.mulf %q4, %k13 : vector<4xf32>
      %part13 = vector.reduce<addf> %prod13, %zero_f : vector<4xf32>, f32
      %sr13 = kernel.subgroup.reduce<addf> %part13 : f32
      %s13 = scf.select %ok13, %sr13, %neg_big : f32
      %prod14 = vector.mulf %q4, %k14 : vector<4xf32>
      %part14 = vector.reduce<addf> %prod14, %zero_f : vector<4xf32>, f32
      %sr14 = kernel.subgroup.reduce<addf> %part14 : f32
      %s14 = scf.select %ok14, %sr14, %neg_big : f32
      %prod15 = vector.mulf %q4, %k15 : vector<4xf32>
      %part15 = vector.reduce<addf> %prod15, %zero_f : vector<4xf32>, f32
      %sr15 = kernel.subgroup.reduce<addf> %part15 : f32
      %s15 = scf.select %ok15, %sr15, %neg_big : f32
      %mx0 = scalar.maxnumf %m, %s0 : f32
      %mx1 = scalar.maxnumf %mx0, %s1 : f32
      %mx2 = scalar.maxnumf %mx1, %s2 : f32
      %mx3 = scalar.maxnumf %mx2, %s3 : f32
      %mx4 = scalar.maxnumf %mx3, %s4 : f32
      %mx5 = scalar.maxnumf %mx4, %s5 : f32
      %mx6 = scalar.maxnumf %mx5, %s6 : f32
      %mx7 = scalar.maxnumf %mx6, %s7 : f32
      %mx8 = scalar.maxnumf %mx7, %s8 : f32
      %mx9 = scalar.maxnumf %mx8, %s9 : f32
      %mx10 = scalar.maxnumf %mx9, %s10 : f32
      %mx11 = scalar.maxnumf %mx10, %s11 : f32
      %mx12 = scalar.maxnumf %mx11, %s12 : f32
      %mx13 = scalar.maxnumf %mx12, %s13 : f32
      %mx14 = scalar.maxnumf %mx13, %s14 : f32
      %mx15 = scalar.maxnumf %mx14, %s15 : f32
      %m_shift = scalar.subf %m, %mx15 : f32
      %alpha = scalar.expf<afn> %m_shift : f32
      %l_scaled = scalar.mulf %l, %alpha : f32
      %alpha_v = vector.splat %alpha : vector<4xf32>
      %acc_s = vector.mulf %acc, %alpha_v : vector<4xf32>
      %d0 = scalar.subf %s0, %mx15 : f32
      %p0 = scalar.expf<afn> %d0 : f32
      %la0 = scalar.addf %l_scaled, %p0 : f32
      %pv0 = vector.splat %p0 : vector<4xf32>
      %aa0 = vector.fmaf %pv0, %v0, %acc_s : vector<4xf32>
      %d1 = scalar.subf %s1, %mx15 : f32
      %p1 = scalar.expf<afn> %d1 : f32
      %la1 = scalar.addf %la0, %p1 : f32
      %pv1 = vector.splat %p1 : vector<4xf32>
      %aa1 = vector.fmaf %pv1, %v1, %aa0 : vector<4xf32>
      %d2 = scalar.subf %s2, %mx15 : f32
      %p2 = scalar.expf<afn> %d2 : f32
      %la2 = scalar.addf %la1, %p2 : f32
      %pv2 = vector.splat %p2 : vector<4xf32>
      %aa2 = vector.fmaf %pv2, %v2, %aa1 : vector<4xf32>
      %d3 = scalar.subf %s3, %mx15 : f32
      %p3 = scalar.expf<afn> %d3 : f32
      %la3 = scalar.addf %la2, %p3 : f32
      %pv3 = vector.splat %p3 : vector<4xf32>
      %aa3 = vector.fmaf %pv3, %v3, %aa2 : vector<4xf32>
      %d4 = scalar.subf %s4, %mx15 : f32
      %p4 = scalar.expf<afn> %d4 : f32
      %la4 = scalar.addf %la3, %p4 : f32
      %pv4 = vector.splat %p4 : vector<4xf32>
      %aa4 = vector.fmaf %pv4, %v4, %aa3 : vector<4xf32>
      %d5 = scalar.subf %s5, %mx15 : f32
      %p5 = scalar.expf<afn> %d5 : f32
      %la5 = scalar.addf %la4, %p5 : f32
      %pv5 = vector.splat %p5 : vector<4xf32>
      %aa5 = vector.fmaf %pv5, %v5, %aa4 : vector<4xf32>
      %d6 = scalar.subf %s6, %mx15 : f32
      %p6 = scalar.expf<afn> %d6 : f32
      %la6 = scalar.addf %la5, %p6 : f32
      %pv6 = vector.splat %p6 : vector<4xf32>
      %aa6 = vector.fmaf %pv6, %v6, %aa5 : vector<4xf32>
      %d7 = scalar.subf %s7, %mx15 : f32
      %p7 = scalar.expf<afn> %d7 : f32
      %la7 = scalar.addf %la6, %p7 : f32
      %pv7 = vector.splat %p7 : vector<4xf32>
      %aa7 = vector.fmaf %pv7, %v7, %aa6 : vector<4xf32>
      %d8 = scalar.subf %s8, %mx15 : f32
      %p8 = scalar.expf<afn> %d8 : f32
      %la8 = scalar.addf %la7, %p8 : f32
      %pv8 = vector.splat %p8 : vector<4xf32>
      %aa8 = vector.fmaf %pv8, %v8, %aa7 : vector<4xf32>
      %d9 = scalar.subf %s9, %mx15 : f32
      %p9 = scalar.expf<afn> %d9 : f32
      %la9 = scalar.addf %la8, %p9 : f32
      %pv9 = vector.splat %p9 : vector<4xf32>
      %aa9 = vector.fmaf %pv9, %v9, %aa8 : vector<4xf32>
      %d10 = scalar.subf %s10, %mx15 : f32
      %p10 = scalar.expf<afn> %d10 : f32
      %la10 = scalar.addf %la9, %p10 : f32
      %pv10 = vector.splat %p10 : vector<4xf32>
      %aa10 = vector.fmaf %pv10, %v10, %aa9 : vector<4xf32>
      %d11 = scalar.subf %s11, %mx15 : f32
      %p11 = scalar.expf<afn> %d11 : f32
      %la11 = scalar.addf %la10, %p11 : f32
      %pv11 = vector.splat %p11 : vector<4xf32>
      %aa11 = vector.fmaf %pv11, %v11, %aa10 : vector<4xf32>
      %d12 = scalar.subf %s12, %mx15 : f32
      %p12 = scalar.expf<afn> %d12 : f32
      %la12 = scalar.addf %la11, %p12 : f32
      %pv12 = vector.splat %p12 : vector<4xf32>
      %aa12 = vector.fmaf %pv12, %v12, %aa11 : vector<4xf32>
      %d13 = scalar.subf %s13, %mx15 : f32
      %p13 = scalar.expf<afn> %d13 : f32
      %la13 = scalar.addf %la12, %p13 : f32
      %pv13 = vector.splat %p13 : vector<4xf32>
      %aa13 = vector.fmaf %pv13, %v13, %aa12 : vector<4xf32>
      %d14 = scalar.subf %s14, %mx15 : f32
      %p14 = scalar.expf<afn> %d14 : f32
      %la14 = scalar.addf %la13, %p14 : f32
      %pv14 = vector.splat %p14 : vector<4xf32>
      %aa14 = vector.fmaf %pv14, %v14, %aa13 : vector<4xf32>
      %d15 = scalar.subf %s15, %mx15 : f32
      %p15 = scalar.expf<afn> %d15 : f32
      %la15 = scalar.addf %la14, %p15 : f32
      %pv15 = vector.splat %p15 : vector<4xf32>
      %aa15 = vector.fmaf %pv15, %v15, %aa14 : vector<4xf32>
      scf.yield %mx15, %la15, %aa15 : f32, f32, vector<4xf32>

    }
    %acc_view = buffer.view %part_acc[%zero] : buffer -> view<[%tokens]x32x16x32x4xf32>
    vector.store %acc_final, %acc_view[%token, %bounded_head, %split, %lane, %c0] : vector<4xf32>, view<[%tokens]x32x16x32x4xf32>
    %first = index.cmp eq, %lane, %c0 : index
    scf.if %first {
      %ml_view = buffer.view %part_ml[%zero] : buffer -> view<[%tokens]x32x16x2xf32>
      view.store %m_final, %ml_view[%token, %bounded_head, %split, 0] : f32, view<[%tokens]x32x16x2xf32>
      view.store %l_final, %ml_view[%token, %bounded_head, %split, 1] : f32, view<[%tokens]x32x16x2xf32>
    }
    }
  }
  kernel.return
}

kernel.def export("flint16_attention_combine_listed") @flint16_attention_combine_listed(%count_buffer: buffer) {
  %origin_c = index.constant 0 : offset
  %counts = buffer.view %count_buffer[%origin_c] : buffer -> view<1xi32>
  %word = view.load %counts[0] : view<1xi32> -> i32
  %bounded = scalar.assume %word [range(%word, 0, 8192)] : i32
  %count = index.cast %bounded : i32 to index
  %c1 = index.constant 1 : index
  %c32 = index.constant 32 : index
  kernel.launch.config workgroups(%count, %c32, %c1) workgroup_size(%c32, %c1, %c1) : index
} launch(%tokens_arg: index, %list: buffer, %sliding: i32, %sinks: buffer, %info: buffer, %part_acc: buffer, %part_ml: buffer, %out: buffer) {
  %tokens = index.assume %tokens_arg [range(%tokens_arg, 1, 8192)] : index
  %slot = kernel.workgroup.id<x> : index
  %zero_l = index.constant 0 : offset
  %list_view = buffer.view %list[%zero_l] : buffer -> view<[%tokens]xi32>
  %bounded_slot = index.assume %slot [lt(%slot, %tokens)] : index
  %token32 = view.load %list_view[%bounded_slot] : view<[%tokens]xi32> -> i32
  %token_bound = scalar.assume %token32 [range(%token32, 0, 8191)] : i32
  %token_value = index.cast %token_bound : i32 to index
  %token = index.assume %token_value [lt(%token_value, %tokens)] : index
  %head_id = kernel.workgroup.id<y> : index
  %head = index.assume %head_id [range(%head_id, 0, 31)] : index
  %lane_id = kernel.workitem.id<x> : index
  %lane = index.assume %lane_id [range(%lane_id, 0, 31)] : index
  %zero = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %cSc = index.constant 16 : index
  %c0_i32 = scalar.constant 0 : i32
  %zero_f = scalar.constant 0.0 : f32
  %zero4 = vector.splat %zero_f : vector<4xf32>
  %info_view = buffer.view %info[%zero] : buffer -> view<[%tokens]x4xi32>
  %live32 = view.load %info_view[%token, 2] : view<[%tokens]x4xi32> -> i32
  %live = scalar.cmpi ne, %live32, %c0_i32 : i32
  %out_view = buffer.view %out[%zero] : buffer -> view<[%tokens]x32x32x4xf32>
  scf.if %live {
    %position32 = view.load %info_view[%token, 1] : view<[%tokens]x4xi32> -> i32
    %position_bound = scalar.assume %position32 [range(%position32, 0, 262143)] : i32
    %position = index.cast %position_bound : i32 to index
    %c512w = index.constant 512 : index
    %is_sliding = scalar.cmpi ne, %sliding, %c0_i32 : i32
    %far = index.cmp ugt, %position, %c512w : index
    %use_window = scalar.andi %is_sliding, %far : i1
    %window_start = index.sub %position, %c512w : index
    %window_low = scf.select %use_window, %window_start, %c0 : index
    %end = index.add %position, %c1 : index
    %visible_value = index.sub %end, %window_low : index
    %visible = index.assume %visible_value [range(%visible_value, 1, 262144)] : index
    %s_eff = func.call @flint16_split_count(%visible) : (index) -> (index)
    %sink_view = buffer.view %sinks[%zero] : buffer -> view<32xf32>
    %sink = view.load %sink_view[%head] : view<32xf32> -> f32
    %ml_view = buffer.view %part_ml[%zero] : buffer -> view<[%tokens]x32x16x2xf32>
    %acc_view = buffer.view %part_acc[%zero] : buffer -> view<[%tokens]x32x16x32x4xf32>
    %maximum = scf.for %s = [%c0 to %s_eff step %c1](%mx = %sink : f32) -> (f32) {
      %bs = index.assume %s [range(%s, 0, 15)] : index
      %ms = view.load %ml_view[%token, %head, %bs, 0] : view<[%tokens]x32x16x2xf32> -> f32
      %next = scalar.maxnumf %mx, %ms : f32
      scf.yield %next : f32
    }
    %sink_shift = scalar.subf %sink, %maximum : f32
    %sink_weight = scalar.expf<afn> %sink_shift : f32
    %den, %total = scf.for %s = [%c0 to %s_eff step %c1](%d = %sink_weight : f32, %acc = %zero4 : vector<4xf32>) -> (f32, vector<4xf32>) {
      %bs = index.assume %s [range(%s, 0, 15)] : index
      %ms = view.load %ml_view[%token, %head, %bs, 0] : view<[%tokens]x32x16x2xf32> -> f32
      %ls = view.load %ml_view[%token, %head, %bs, 1] : view<[%tokens]x32x16x2xf32> -> f32
      %shift = scalar.subf %ms, %maximum : f32
      %w = scalar.expf<afn> %shift : f32
      %wl = scalar.mulf %w, %ls : f32
      %d_next = scalar.addf %d, %wl : f32
      %part = vector.load %acc_view[%token, %head, %bs, %lane, %c0] : view<[%tokens]x32x16x32x4xf32> -> vector<4xf32>
      %w_v = vector.splat %w : vector<4xf32>
      %acc_next = vector.fmaf %w_v, %part, %acc : vector<4xf32>
      scf.yield %d_next, %acc_next : f32, vector<4xf32>
    }
    %one = scalar.constant 1.0 : f32
    %inv = scalar.divf %one, %den : f32
    %inv_v = vector.splat %inv : vector<4xf32>
    %result = vector.mulf %total, %inv_v : vector<4xf32>
    vector.store %result, %out_view[%token, %head, %lane, %c0] : vector<4xf32>, view<[%tokens]x32x32x4xf32>
  } else {
    vector.store %zero4, %out_view[%token, %head, %lane, %c0] : vector<4xf32>, view<[%tokens]x32x32x4xf32>
  }
  kernel.return
}
