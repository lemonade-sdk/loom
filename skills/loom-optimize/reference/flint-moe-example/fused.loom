// Routed-expert gate/up (rows 0-3071: slot x 512) and shared-expert gate/up
// (rows 3072-4095) with SwiGLU, in one launch.
kernel.def export("flint_moe_gate_up") @flint_moe_gate_up(%tokens: index) {
  %c1 = index.constant 1 : index
  %c32 = index.constant 32 : index
