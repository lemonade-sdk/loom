// FFN norm + router logits; workgroup 0 also publishes the normalized
// activations h for the expert kernels.
kernel.def export("flint_norm_router") @flint_norm_router(%tokens: index) {
  %c1 = index.constant 1 : index
  %c8 = index.constant 8 : index
  %c256 = index.constant 256 : index
  %c32g = index.constant 32 : index
  kernel.launch.config workgroups(%c32g, %tokens, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%tokens_arg: index, %x: buffer, %norm: buffer, %w: buffer, %h: buffer, %logits: buffer) {
  %tokens = index.assume %tokens_arg [range(%tokens_arg, 1, 8192)] : index
