// x[t, r] += sum_slot weight * (down_e[r] . act[t, slot]) + (down_shared[r] . shared[t]).
kernel.def export("flint_moe_down") @flint_moe_down(%tokens: index) {
  %c1 = index.constant 1 : index
  %c32 = index.constant 32 : index
  %c2048 = index.constant 2048 : index
  kernel.launch.config workgroups(%c2048, %tokens, %c1) workgroup_size(%c32, %c1, %c1) : index
} launch(%tokens_arg: index, %act: buffer, %ids: buffer, %weights: buffer, %down: buffer, %shared: buffer, %down_shared: buffer, %x: buffer) {
  %tokens = index.assume %tokens_arg [range(%tokens_arg, 1, 8192)] : index
  %row_id = kernel.workgroup.id<x> : index
  %row = index.assume %row_id [range(%row_id, 0, 2047)] : index
  %token_id = kernel.workgroup.id<y> : index
  %token = index.assume %token_id [lt(%token_id, %tokens)] : index
  %lane = kernel.workitem.id<x> : index
  %lanes = kernel.workgroup.size<x> : index
  %zero = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c6 = index.constant 6 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %zero_f = scalar.constant 0.0 : f32
  %c0_i32 = scalar.constant 0 : i32
  %c255_i32 = scalar.constant 255 : i32
  %ids_view = buffer.view %ids[%zero] : buffer -> view<[%tokens]x8xi32>
  %weights_view = buffer.view %weights[%zero] : buffer -> view<[%tokens]x8xf32>
  %slots = index.mul %tokens, %c6 : index
  %act_view = buffer.view %act[%zero] : buffer -> view<[%slots]x[%c16]x32xf32>
  %expert_bytes = index.constant 589824 : offset
  %row_bytes = index.constant 288 : offset
  %row_add = index.scale %row, %row_bytes : index, offset -> offset
  %routed = scf.for %slot = [%c0 to %c6 step %c1](%acc = %zero_f : f32) -> (f32) {
    %bounded_slot = index.assume %slot [range(%slot, 0, 5)] : index
    %expert32 = view.load %ids_view[%token, %bounded_slot] : view<[%tokens]x8xi32> -> i32
    %weight = view.load %weights_view[%token, %bounded_slot] : view<[%tokens]x8xf32> -> f32
    %expert_low = scalar.maxsi %expert32, %c0_i32 : i32
    %expert_clamped = scalar.minsi %expert_low, %c255_i32 : i32
    %expert_bound = scalar.assume %expert_clamped [range(%expert_clamped, 0, 255)] : i32
    %expert = index.cast %expert_bound : i32 to index
    %expert_origin = index.scale %expert, %expert_bytes : index, offset -> offset
    %row_origin = index.add %expert_origin, %row_add : offset
    %slot_row_value = index.madd %token, %c6, %bounded_slot : index
    %slot_row = index.assume %slot_row_value [lt(%slot_row_value, %slots)] : index
    %part = func.call @flint_q4_k_row_dot(%down, %row_origin, %act_view, %slots, %c16, %slot_row, %lane, %lanes) : (buffer, offset, view<[%slots]x[%c16]x32xf32>, index, index, index, index, index) -> (f32)
    %next = scalar.fmaf %weight, %part, %acc : f32
    scf.yield %next : f32
  }
  %shared_bytes = index.constant 1088 : offset
  %shared_origin = index.scale %row, %shared_bytes : index, offset -> offset
  %shared_view = buffer.view %shared[%zero] : buffer -> view<[%tokens]x[%c32]x32xf32>
  %shared_part = func.call @flint_q8_0_row_dot(%down_shared, %shared_origin, %shared_view, %tokens, %c32, %token, %lane, %lanes) : (buffer, offset, view<[%tokens]x[%c32]x32xf32>, index, index, index, index, index) -> (f32)
  %lane_total = scalar.addf %routed, %shared_part : f32
  %total = kernel.workgroup.reduce<addf> %lane_total : f32
  %first = index.cmp eq, %lane, %c0 : index
  scf.if %first {
    %c2048 = index.constant 2048 : index
    %one = scalar.constant 1 : i32
    func.call @flint_store_row(%x, %tokens, %c2048, %token, %row, %total, %one) : (buffer, index, index, index, index, f32, i32)
  }
  kernel.return
}

// Partial Q8_0 row dot with x scaled elementwise by a norm weight:
// sum_k W[k] * x[k] * g[k] over this lane's 32-value blocks.
func.def inline @flint_q8_0_row_dot_scaled(%w: buffer, %row_origin: offset, %x_view: view<[%tokens]x[%groups]x32xf32>, %g_view: view<[%groups]x32xf32>, %tokens: index, %groups: index, %token: index, %lane: index, %lanes: index) -> (f32) {
  %c0 = index.constant 0 : index
  %two = index.constant 2 : offset
  %block_bytes = index.constant 34 : offset
  %zero_f = scalar.constant 0.0 : f32
  %bounded_token = index.assume %token [lt(%token, %tokens)] : index
  %partial = scf.for %block = [%lane to %groups step %lanes](%sum = %zero_f : f32) -> (f32) {
    %block_add = index.scale %block, %block_bytes : index, offset -> offset
    %block_origin = index.add %row_origin, %block_add : offset
    %code_origin = index.add %block_origin, %two : offset
    %scale_view = buffer.view %w[%block_origin] : buffer -> view<1xf16>
    %code_view = buffer.view %w[%code_origin] : buffer -> view<32xi8>
    %scale_half = view.load %scale_view[0] : view<1xf16> -> f16
    %scale = scalar.extf %scale_half : f16 to f32
    %codes = vector.load %code_view[0] : view<32xi8> -> vector<32xi8>
    %values = vector.sitofp %codes : vector<32xi8> to vector<32xf32>
    %inputs = vector.load %x_view[%bounded_token, %block, %c0] : view<[%tokens]x[%groups]x32xf32> -> vector<32xf32>
    %gains = vector.load %g_view[%block, %c0] : view<[%groups]x32xf32> -> vector<32xf32>
    %normed = vector.mulf %inputs, %gains : vector<32xf32>
    %products = vector.mulf %values, %normed : vector<32xf32>
    %dot = vector.reduce<addf> %products, %zero_f : vector<32xf32>, f32
    %next = scalar.fmaf %dot, %scale, %sum : f32
    scf.yield %next : f32
  }
  func.return %partial : f32
}

// 1 / rms(x[token]) over 2048 channels with a 256-lane workgroup.
func.def inline @flint_inverse_rms(%x: buffer, %tokens: index, %token: index, %lane: index) -> (f32) {
  %zero = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %zero_f = scalar.constant 0.0 : f32
  %bounded_token = index.assume %token [lt(%token, %tokens)] : index
  %bounded_lane = index.assume %lane [range(%lane, 0, 255)] : index
  %x_view = buffer.view %x[%zero] : buffer -> view<[%tokens]x256x8xf32>
  %values = vector.load %x_view[%bounded_token, %bounded_lane, %c0] : view<[%tokens]x256x8xf32> -> vector<8xf32>
  %squares = vector.mulf %values, %values : vector<8xf32>
  %local = vector.reduce<addf> %squares, %zero_f : vector<8xf32>, f32
  %sum = kernel.workgroup.reduce<addf> %local : f32
  %count = scalar.constant 2048.0 : f32
  %eps = scalar.constant 1.0e-6 : f32
  %mean = scalar.divf %sum, %count : f32
  %stable = scalar.addf %mean, %eps : f32
  %inverse = scalar.rsqrtf %stable : f32
  func.return %inverse : f32
}

// Attention norm + Q/K/V projection + per-head Q/K norm + NeoX RoPE + KV store.
// Workgroup (head, token) with 256 lanes: heads 0-31 are Q, 32-35 K, 36-39 V.
// Eight 32-lane subgroups each project 16 of the head's 128 rows.
kernel.def export("flint_qkv_rope") @flint_qkv_rope(%tokens: index) {
  %c1 = index.constant 1 : index
  %c40 = index.constant 40 : index
  %c256 = index.constant 256 : index
  kernel.launch.config workgroups(%c40, %tokens, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%tokens_arg: index, %layer_arg: index, %rope: i32, %context_arg: index, %pool_arg: index, %x: buffer, %norm: buffer, %wq: buffer, %wk: buffer, %wv: buffer, %q_norm: buffer, %k_norm: buffer, %q: buffer, %info: buffer, %origins: buffer, %arena: buffer) {
  %tokens = index.assume %tokens_arg [range(%tokens_arg, 1, 8192)] : index
  %layer = index.assume %layer_arg [range(%layer_arg, 0, 48)] : index
  %context = index.assume %context_arg [range(%context_arg, 16, 262144)] : index
  %pool = index.assume %pool_arg [range(%pool_arg, 16, 1048576)] : index
