  %h_tok = index.div %t, %c4 : index
  %h_kq = index.rem %t, %c4 : index
  %h_k = index.mul %h_kq, %c4 : index
  %h_row_value = index.add %row0, %h_tok : index
  %h_row = index.assume %h_row_value [lt(%h_row_value, %tokens)] : index
  %zero_f = scalar.constant 0.0 : f32
  %zero8v = vector.splat %zero_f : vector<8xf32>
  %k_steps = index.constant 128 : index
  %acc0, %acc1, %acc2, %acc3, %acc4, %acc5, %acc6, %acc7 = scf.for %step = [%c0 to %k_steps step %c1](%a0 = %zero8v : vector<8xf32>, %a1 = %zero8v : vector<8xf32>, %a2 = %zero8v : vector<8xf32>, %a3 = %zero8v : vector<8xf32>, %a4 = %zero8v : vector<8xf32>, %a5 = %zero8v : vector<8xf32>, %a6 = %zero8v : vector<8xf32>, %a7 = %zero8v : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
    %k0 = index.mul %step, %c16 : index
    %hk = index.add %k0, %h_k : index
    %hv = vector.load %h_view[%h_row, %hk] : view<[%tokens]x2048xf32> -> vector<4xf32>
    scf.for %j = [%c0 to %c4 step %c1] unroll {
      %bj = index.assume %j [range(%j, 0, 3)] : index
      %e = vector.extract %hv[%bj] : vector<4xf32> -> f32
      %kk_value = index.add %h_k, %bj : index
      %kk = index.assume %kk_value [range(%kk_value, 0, 15)] : index
      %bt = index.assume %h_tok [range(%h_tok, 0, 63)] : index
      view.store %e, %hs[%kk, %bt] : f32, view<16x68xf32>
    }
    %wv = vector.load %w_view[%t, %k0] : view<256x2048xf32> -> vector<16xf32>
    scf.for %j = [%c0 to %c16 step %c1] unroll {
      %bj = index.assume %j [range(%j, 0, 15)] : index
      %e = vector.extract %wv[%bj] : vector<16xf32> -> f32
      view.store %e, %ws[%bj, %t] : f32, view<16x272xf32>
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %n0, %n1, %n2, %n3, %n4, %n5, %n6, %n7 = scf.for %kk = [%c0 to %c16 step %c1](%b0 = %a0 : vector<8xf32>, %b1 = %a1 : vector<8xf32>, %b2 = %a2 : vector<8xf32>, %b3 = %a3 : vector<8xf32>, %b4 = %a4 : vector<8xf32>, %b5 = %a5 : vector<8xf32>, %b6 = %a6 : vector<8xf32>, %b7 = %a7 : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) unroll {
      %bk = index.assume %kk [range(%kk, 0, 15)] : index
      %hr = vector.load %hs[%bk, %token0] : view<16x68xf32> -> vector<8xf32>
      %wr = vector.load %ws[%bk, %expert0] : view<16x272xf32> -> vector<8xf32>
      %h0 = vector.extract %hr[0] : vector<8xf32> -> f32
      %hs0 = vector.splat %h0 : vector<8xf32>
      %u0 = vector.fmaf %hs0, %wr, %b0 : vector<8xf32>
      %h1 = vector.extract %hr[1] : vector<8xf32> -> f32
      %hs1 = vector.splat %h1 : vector<8xf32>
      %u1 = vector.fmaf %hs1, %wr, %b1 : vector<8xf32>
      %h2 = vector.extract %hr[2] : vector<8xf32> -> f32
      %hs2 = vector.splat %h2 : vector<8xf32>
      %u2 = vector.fmaf %hs2, %wr, %b2 : vector<8xf32>
      %h3 = vector.extract %hr[3] : vector<8xf32> -> f32
      %hs3 = vector.splat %h3 : vector<8xf32>
      %u3 = vector.fmaf %hs3, %wr, %b3 : vector<8xf32>
      %h4 = vector.extract %hr[4] : vector<8xf32> -> f32
      %hs4 = vector.splat %h4 : vector<8xf32>
      %u4 = vector.fmaf %hs4, %wr, %b4 : vector<8xf32>
      %h5 = vector.extract %hr[5] : vector<8xf32> -> f32
      %hs5 = vector.splat %h5 : vector<8xf32>
      %u5 = vector.fmaf %hs5, %wr, %b5 : vector<8xf32>
      %h6 = vector.extract %hr[6] : vector<8xf32> -> f32
      %hs6 = vector.splat %h6 : vector<8xf32>
      %u6 = vector.fmaf %hs6, %wr, %b6 : vector<8xf32>
      %h7 = vector.extract %hr[7] : vector<8xf32> -> f32
      %hs7 = vector.splat %h7 : vector<8xf32>
      %u7 = vector.fmaf %hs7, %wr, %b7 : vector<8xf32>
      scf.yield %u0, %u1, %u2, %u3, %u4, %u5, %u6, %u7 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    scf.yield %n0, %n1, %n2, %n3, %n4, %n5, %n6, %n7 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
  }
  %out = buffer.view %logits[%zero] : buffer -> view<[%tokens]x256xf32>
  %tok_base = index.add %row0, %token0 : index
  %tok0_c = index.constant 0 : index
  %tok0_v = index.add %tok_base, %tok0_c : index
  %tok0 = index.assume %tok0_v [lt(%tok0_v, %tokens)] : index
  vector.store %acc0, %out[%tok0, %expert0] : vector<8xf32>, view<[%tokens]x256xf32>
  %tok1_c = index.constant 1 : index
  %tok1_v = index.add %tok_base, %tok1_c : index
  %tok1 = index.assume %tok1_v [lt(%tok1_v, %tokens)] : index
  vector.store %acc1, %out[%tok1, %expert0] : vector<8xf32>, view<[%tokens]x256xf32>
  %tok2_c = index.constant 2 : index
  %tok2_v = index.add %tok_base, %tok2_c : index
  %tok2 = index.assume %tok2_v [lt(%tok2_v, %tokens)] : index
  vector.store %acc2, %out[%tok2, %expert0] : vector<8xf32>, view<[%tokens]x256xf32>
  %tok3_c = index.constant 3 : index
  %tok3_v = index.add %tok_base, %tok3_c : index
  %tok3 = index.assume %tok3_v [lt(%tok3_v, %tokens)] : index
  vector.store %acc3, %out[%tok3, %expert0] : vector<8xf32>, view<[%tokens]x256xf32>
  %tok4_c = index.constant 4 : index
  %tok4_v = index.add %tok_base, %tok4_c : index
  %tok4 = index.assume %tok4_v [lt(%tok4_v, %tokens)] : index
  vector.store %acc4, %out[%tok4, %expert0] : vector<8xf32>, view<[%tokens]x256xf32>
  %tok5_c = index.constant 5 : index
  %tok5_v = index.add %tok_base, %tok5_c : index
  %tok5 = index.assume %tok5_v [lt(%tok5_v, %tokens)] : index
  vector.store %acc5, %out[%tok5, %expert0] : vector<8xf32>, view<[%tokens]x256xf32>
  %tok6_c = index.constant 6 : index
  %tok6_v = index.add %tok_base, %tok6_c : index
  %tok6 = index.assume %tok6_v [lt(%tok6_v, %tokens)] : index
  vector.store %acc6, %out[%tok6, %expert0] : vector<8xf32>, view<[%tokens]x256xf32>
  %tok7_c = index.constant 7 : index
  %tok7_v = index.add %tok_base, %tok7_c : index
  %tok7 = index.assume %tok7_v [lt(%tok7_v, %tokens)] : index
  vector.store %acc7, %out[%tok7, %expert0] : vector<8xf32>, view<[%tokens]x256xf32>
  kernel.return
}

// GEMM A operand: x16[r] = f16(x[r] * scale[r]).
kernel.def export("flint_row_scale_f16k") @flint_row_scale_f16k(%rows: index) {
  %c1 = index.constant 1 : index
  %c256 = index.constant 256 : index
  kernel.launch.config workgroups(%rows, %c1, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%rows_arg: index, %k_arg: index, %info: buffer, %x: buffer, %scales: buffer, %x16: buffer) {
  %rows = index.assume %rows_arg [range(%rows_arg, 1, 2097152)] : index
  %k = index.assume %k_arg [range(%k_arg, 256, 65536), multiple_of(%k_arg, 256)] : index
  %row_id = kernel.workgroup.id<x> : index
  %row = index.assume %row_id [lt(%row_id, %rows)] : index
  %lane = kernel.workitem.id<x> : index
  %zero = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c256 = index.constant 256 : index
  %zero_f = scalar.constant 0.0 : f32
  %x_view = buffer.view %x[%zero] : buffer -> view<[%rows]x[%k]xf32>
  %h_view = buffer.view %x16[%zero] : buffer -> view<[%rows]x[%k]xf16>
  %local = scf.for %c = [%lane to %k step %c256](%m = %zero_f : f32) -> (f32) {
    %bc = index.assume %c [lt(%c, %k)] : index
    %v = view.load %x_view[%row, %bc] : view<[%rows]x[%k]xf32> -> f32
    %a = scalar.absf %v : f32
    %n = scalar.maxnumf %m, %a : f32
    scf.yield %n : f32
  }
  %maximum = kernel.workgroup.reduce<maxnumf> %local : f32
  %bits = scalar.bitcast %maximum : f32 to i32
  %c23 = scalar.constant 23 : i32
  %c255 = scalar.constant 255 : i32
  %shifted = scalar.shrui %bits, %c23 : i32
  %biased = scalar.andi %shifted, %c255 : i32
  %c127 = scalar.constant 127 : i32
  %c13 = scalar.constant 13 : i32
  %c0_i32 = scalar.constant 0 : i32
  %c100 = scalar.constant 100 : i32
  %unbiased = scalar.subi %biased, %c127 : i32
  %raw_e = scalar.subi %unbiased, %c13 : i32
  %positive = scalar.maxsi %raw_e, %c0_i32 : i32
  %e = scalar.minsi %positive, %c100 : i32
  %scale_exp = scalar.subi %c127, %e : i32
  %inverse_exp = scalar.addi %c127, %e : i32
  %scale_bits = scalar.shli %scale_exp, %c23 : i32
  %inverse_bits = scalar.shli %inverse_exp, %c23 : i32
  %scale_raw = scalar.bitcast %scale_bits : i32 to f32
  %inverse_raw = scalar.bitcast %inverse_bits : i32 to f32
  // Padding rows (not live) get scale 0, which GEMM row tiles skip on.
  %info_view = buffer.view %info[%zero] : buffer -> view<[%rows]x4xi32>
  %c2_info = index.constant 2 : index
  %live32 = view.load %info_view[%row, %c2_info] : view<[%rows]x4xi32> -> i32
  %c0_live = scalar.constant 0 : i32
  %live = scalar.cmpi ne, %live32, %c0_live : i32
  %scale = scf.select %live, %scale_raw, %zero_f : f32
  %inverse = scf.select %live, %inverse_raw, %zero_f : f32
  scf.for %c = [%lane to %k step %c256] {
    %bc = index.assume %c [lt(%c, %k)] : index
    %v = view.load %x_view[%row, %bc] : view<[%rows]x[%k]xf32> -> f32
    %sv = scalar.mulf %v, %scale : f32
    %sv_live = scf.select %live, %sv, %zero_f : f32
    %hv = scalar.fptrunc %sv_live : f32 to f16
    view.store %hv, %h_view[%row, %bc] : f16, view<[%rows]x[%k]xf16>
  }
  %first = index.cmp eq, %lane, %c0 : index
  scf.if %first {
    %s_view = buffer.view %scales[%zero] : buffer -> view<[%rows]x2xf32>
    view.store %scale, %s_view[%row, %c0] : f32, view<[%rows]x2xf32>
    view.store %inverse, %s_view[%row, %c1] : f32, view<[%rows]x2xf32>
  }
  kernel.return
}

// rmsnorm (eps 1e-6) writing h (F32) and, for prefill GEMMs, the per-row
// power-of-two scale and the scaled F16 row (padding rows get scale 0).
kernel.def export("flint_rmsnorm_f16") @flint_rmsnorm_f16(%tokens: index) {
  %c1 = index.constant 1 : index
  %c256 = index.constant 256 : index
  kernel.launch.config workgroups(%tokens, %c1, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%tokens_arg: index, %info: buffer, %x: buffer, %w: buffer, %y: buffer, %scales: buffer, %y16: buffer) {
  %tokens = index.assume %tokens_arg [range(%tokens_arg, 1, 8192)] : index
  %token_id = kernel.workgroup.id<x> : index
  %token = index.assume %token_id [lt(%token_id, %tokens)] : index
  %lane_id = kernel.workitem.id<x> : index
  %lane = index.assume %lane_id [range(%lane_id, 0, 255)] : index
  %zero = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1i = index.constant 1 : index
  %zero_f = scalar.constant 0.0 : f32
  %x_view = buffer.view %x[%zero] : buffer -> view<[%tokens]x256x8xf32>
  %w_view = buffer.view %w[%zero] : buffer -> view<256x8xf32>
  %y_view = buffer.view %y[%zero] : buffer -> view<[%tokens]x256x8xf32>
  %values = vector.load %x_view[%token, %lane, %c0] : view<[%tokens]x256x8xf32> -> vector<8xf32>
  %squares = vector.mulf %values, %values : vector<8xf32>
  %local = vector.reduce<addf> %squares, %zero_f : vector<8xf32>, f32
  %sum = kernel.workgroup.reduce<addf> %local : f32
  %count = scalar.constant 2048.0 : f32
  %eps = scalar.constant 1.0e-6 : f32
  %mean = scalar.divf %sum, %count : f32
  %stable = scalar.addf %mean, %eps : f32
  %inverse_rms = scalar.rsqrtf %stable : f32
  %inverses = vector.splat %inverse_rms : vector<8xf32>
  %weights = vector.load %w_view[%lane, %c0] : view<256x8xf32> -> vector<8xf32>
  %normalized = vector.mulf %values, %inverses : vector<8xf32>
  %result = vector.mulf %normalized, %weights : vector<8xf32>
  vector.store %result, %y_view[%token, %lane, %c0] : vector<8xf32>, view<[%tokens]x256x8xf32>
  %a = vector.absf %result : vector<8xf32>
  %lmax = vector.reduce<maxnumf> %a, %zero_f : vector<8xf32>, f32
  %maximum = kernel.workgroup.reduce<maxnumf> %lmax : f32
  %bits = scalar.bitcast %maximum : f32 to i32
  %c23 = scalar.constant 23 : i32
  %c255 = scalar.constant 255 : i32
  %shifted = scalar.shrui %bits, %c23 : i32
  %biased = scalar.andi %shifted, %c255 : i32
  %c127 = scalar.constant 127 : i32
  %c13 = scalar.constant 13 : i32
  %c0_i32 = scalar.constant 0 : i32
  %c100 = scalar.constant 100 : i32
  %unbiased = scalar.subi %biased, %c127 : i32
  %raw_e = scalar.subi %unbiased, %c13 : i32
  %positive = scalar.maxsi %raw_e, %c0_i32 : i32
  %e = scalar.minsi %positive, %c100 : i32
  %scale_exp = scalar.subi %c127, %e : i32
  %inverse_exp = scalar.addi %c127, %e : i32
  %scale_bits = scalar.shli %scale_exp, %c23 : i32
  %inverse_bits = scalar.shli %inverse_exp, %c23 : i32
  %scale_raw = scalar.bitcast %scale_bits : i32 to f32
  %inverse_raw = scalar.bitcast %inverse_bits : i32 to f32
  %info_view = buffer.view %info[%zero] : buffer -> view<[%tokens]x4xi32>
  %c2_info = index.constant 2 : index
  %live32 = view.load %info_view[%token, %c2_info] : view<[%tokens]x4xi32> -> i32
  %live = scalar.cmpi ne, %live32, %c0_i32 : i32
  %scale = scf.select %live, %scale_raw, %zero_f : f32
  %inverse = scf.select %live, %inverse_raw, %zero_f : f32
  %scale_v = vector.splat %scale : vector<8xf32>
  %scaled = vector.mulf %result, %scale_v : vector<8xf32>
  %half = vector.fptrunc %scaled : vector<8xf32> to vector<8xf16>
  %y16_view = buffer.view %y16[%zero] : buffer -> view<[%tokens]x256x8xf16>
  vector.store %half, %y16_view[%token, %lane, %c0] : vector<8xf16>, view<[%tokens]x256x8xf16>
  %first = index.cmp eq, %lane, %c0 : index
  scf.if %first {
    %s_view = buffer.view %scales[%zero] : buffer -> view<[%tokens]x2xf32>
    view.store %scale, %s_view[%token, %c0] : f32, view<[%tokens]x2xf32>
    view.store %inverse, %s_view[%token, %c1i] : f32, view<[%tokens]x2xf32>
  }
  kernel.return
}
