    %row = index.assume %row_value [range(%row_value, 0, 1023)] : index
    %row_bytes = index.constant 2176 : offset
    %origin = index.scale %row, %row_bytes : index, offset -> offset
    %gp = func.call @flint_q8_0_row_dot(%gate_shared, %origin, %x_view, %tokens, %c64, %token, %lane, %lanes) : (buffer, offset, view<[%tokens]x[%c64]x32xf32>, index, index, index, index, index) -> (f32)
    %upp = func.call @flint_q8_0_row_dot(%up_shared, %origin, %x_view, %tokens, %c64, %token, %lane, %lanes) : (buffer, offset, view<[%tokens]x[%c64]x32xf32>, index, index, index, index, index) -> (f32)
    %g = kernel.workgroup.reduce<addf> %gp : f32
    %u = kernel.workgroup.reduce<addf> %upp : f32
    scf.if %first {
      %value = func.call @flint_silu_mul(%g, %u) : (f32, f32) -> (f32)
