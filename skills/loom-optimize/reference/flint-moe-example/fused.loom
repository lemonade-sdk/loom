  %g_view = buffer.view %norm[%zero] : buffer -> view<32x64xf32>
  %w_view = buffer.view %w[%zero] : buffer -> view<256x32x64xf32>
  %out = buffer.view %logits[%zero] : buffer -> view<[%tokens]x256xf32>
  %xv = vector.load %x_view[%token, %lane, %c0] : view<[%tokens]x32x64xf32> -> vector<64xf32>
  %gv = vector.load %g_view[%lane, %c0] : view<32x64xf32> -> vector<64xf32>
