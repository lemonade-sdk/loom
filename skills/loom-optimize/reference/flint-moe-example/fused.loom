  %group = index.assume %group_id [range(%group_id, 0, 31)] : index
  %token_id = kernel.workgroup.id<y> : index
  %token = index.assume %token_id [lt(%token_id, %tokens)] : index
  %local = kernel.workitem.id<x> : index
  %bounded_local = index.assume %local [range(%local, 0, 255)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
