// Fused decode-oriented kernels: fewer launches and coalesced router reads.

// Router logits: 8 workgroups x 8 subgroups x 4 experts per token. Each
// 32-lane subgroup reads one contiguous 8 KiB expert row (64 values per lane).
kernel.def export("flint_router_logits") @flint_router_logits(%tokens: index) {
  %c1 = index.constant 1 : index
  %c8 = index.constant 8 : index
  %c256 = index.constant 256 : index
  kernel.launch.config workgroups(%c8, %tokens, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%tokens_arg: index, %h: buffer, %w: buffer, %logits: buffer) {
  %tokens = index.assume %tokens_arg [range(%tokens_arg, 1, 8192)] : index
  %group_id = kernel.workgroup.id<x> : index
  %group = index.assume %group_id [range(%group_id, 0, 7)] : index
  %token_id = kernel.workgroup.id<y> : index
  %token = index.assume %token_id [lt(%token_id, %tokens)] : index
  %local = kernel.workitem.id<x> : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %c32 = index.constant 32 : index
  %zero = index.constant 0 : offset
  %zero_f = scalar.constant 0.0 : f32
  %sub_value = index.div %local, %c32 : index
  %sub = index.assume %sub_value [range(%sub_value, 0, 7)] : index
  %lane_value = index.rem %local, %c32 : index
  %lane = index.assume %lane_value [range(%lane_value, 0, 31)] : index
  %h_view = buffer.view %h[%zero] : buffer -> view<[%tokens]x32x64xf32>
  %w_view = buffer.view %w[%zero] : buffer -> view<256x32x64xf32>
  %out = buffer.view %logits[%zero] : buffer -> view<[%tokens]x256xf32>
  %hv = vector.load %h_view[%token, %lane, %c0] : view<[%tokens]x32x64xf32> -> vector<64xf32>
  %base_a = index.mul %group, %c32 : index
  %sub4 = index.mul %sub, %c4 : index
  %base = index.add %base_a, %sub4 : index
  scf.for %i = [%c0 to %c4 step %c1] {
    %expert_value = index.add %base, %i : index
    %expert = index.assume %expert_value [range(%expert_value, 0, 255)] : index
    %wv = vector.load %w_view[%expert, %lane, %c0] : view<256x32x64xf32> -> vector<64xf32>
    %prod = vector.mulf %hv, %wv : vector<64xf32>
    %part = vector.reduce<addf> %prod, %zero_f : vector<64xf32>, f32
    %logit = kernel.subgroup.reduce<addf> %part : f32
    %first = index.cmp eq, %lane, %c0 : index
    scf.if %first {
      view.store %logit, %out[%token, %expert] : f32, view<[%tokens]x256xf32>
    }
  }
  kernel.return
}

// Sigmoid top-6 with renormalization over precomputed router logits.
kernel.def export("flint_router_topk") @flint_router_topk(%tokens: index) {
  %c1 = index.constant 1 : index
  %c256 = index.constant 256 : index
  kernel.launch.config workgroups(%tokens, %c1, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%tokens_arg: index, %logits: buffer, %ids: buffer, %weights: buffer) {
  %tokens = index.assume %tokens_arg [range(%tokens_arg, 1, 8192)] : index
  %token_id = kernel.workgroup.id<x> : index
  %token = index.assume %token_id [lt(%token_id, %tokens)] : index
  %lane_id = kernel.workitem.id<x> : index
  %lane = index.assume %lane_id [range(%lane_id, 0, 255)] : index
  %zero = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c6 = index.constant 6 : index
  %zero_f = scalar.constant 0.0 : f32
  %one_f = scalar.constant 1.0 : f32
  %in = buffer.view %logits[%zero] : buffer -> view<[%tokens]x256xf32>
  %logit = view.load %in[%token, %lane] : view<[%tokens]x256xf32> -> f32
  %negated = scalar.negf %logit : f32
  %exp = scalar.expf<afn> %negated : f32
  %denominator = scalar.addf %one_f, %exp : f32
  %probability = scalar.divf %one_f, %denominator : f32
  %ids_view = buffer.view %ids[%zero] : buffer -> view<[%tokens]x8xi32>
  %weights_view = buffer.view %weights[%zero] : buffer -> view<[%tokens]x8xf32>
  %lane32 = index.cast %lane : index to i32
  %removed = scalar.constant -1.0 : f32
  %big_id = scalar.constant 1000000 : i32
  %remaining, %total = scf.for %round = [%c0 to %c6 step %c1](%p = %probability : f32, %sum = %zero_f : f32) -> (f32, f32) {
    %best = kernel.workgroup.reduce<maxnumf> %p : f32
    %is_best = scalar.cmpf oeq, %p, %best : f32
    %candidate = scf.select %is_best, %lane32, %big_id : i32
    %winner = kernel.workgroup.reduce<minsi> %candidate : i32
    %won = scalar.cmpi eq, %winner, %lane32 : i32
    %bounded_round = index.assume %round [range(%round, 0, 5)] : index
    scf.if %won {
      view.store %lane32, %ids_view[%token, %bounded_round] : i32, view<[%tokens]x8xi32>
      view.store %p, %weights_view[%token, %bounded_round] : f32, view<[%tokens]x8xf32>
    }
    %next_p = scf.select %won, %removed, %p : f32
    %next_sum = scalar.addf %sum, %best : f32
    scf.yield %next_p, %next_sum : f32, f32
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %first = index.cmp ult, %lane, %c6 : index
  scf.if %first {
    %bounded = index.assume %lane [range(%lane, 0, 5)] : index
    %w0 = view.load %weights_view[%token, %bounded] : view<[%tokens]x8xf32> -> f32
    %normalized = scalar.divf %w0, %total : f32
    view.store %normalized, %weights_view[%token, %bounded] : f32, view<[%tokens]x8xf32>
  }
  kernel.return
}

// Q, K and V projections in one launch: rows [0, 4096) are Q, [4096, 4608)
// K and [4608, 5120) V.
kernel.def export("flint_qkv_q8_0") @flint_qkv_q8_0(%tokens: index) {
  %c1 = index.constant 1 : index
  %c32 = index.constant 32 : index
  %c5120 = index.constant 5120 : index
  kernel.launch.config workgroups(%c5120, %tokens, %c1) workgroup_size(%c32, %c1, %c1) : index
} launch(%tokens_arg: index, %x: buffer, %wq: buffer, %wk: buffer, %wv: buffer, %q: buffer, %k: buffer, %v: buffer) {
  %tokens = index.assume %tokens_arg [range(%tokens_arg, 1, 8192)] : index
  %row_id = kernel.workgroup.id<x> : index
  %row = index.assume %row_id [range(%row_id, 0, 5119)] : index
  %token_id = kernel.workgroup.id<y> : index
  %token = index.assume %token_id [lt(%token_id, %tokens)] : index
  %lane = kernel.workitem.id<x> : index
  %lanes = kernel.workgroup.size<x> : index
  %c0 = index.constant 0 : index
  %c64 = index.constant 64 : index
  %c512 = index.constant 512 : index
  %c4096 = index.constant 4096 : index
  %c4608 = index.constant 4608 : index
  %zero = index.constant 0 : offset
  %zero_i32 = scalar.constant 0 : i32
  %row_bytes = index.constant 2176 : offset
  %x_view = buffer.view %x[%zero] : buffer -> view<[%tokens]x[%c64]x32xf32>
  %is_q = index.cmp ult, %row, %c4096 : index
  %first = index.cmp eq, %lane, %c0 : index
  scf.if %is_q {
    %origin = index.scale %row, %row_bytes : index, offset -> offset
    %part = func.call @flint_q8_0_row_dot(%wq, %origin, %x_view, %tokens, %c64, %token, %lane, %lanes) : (buffer, offset, view<[%tokens]x[%c64]x32xf32>, index, index, index, index, index) -> (f32)
    %total = kernel.workgroup.reduce<addf> %part : f32
    scf.if %first {
      func.call @flint_store_row(%q, %tokens, %c4096, %token, %row, %total, %zero_i32) : (buffer, index, index, index, index, f32, i32)
    }
  } else {
    %is_k = index.cmp ult, %row, %c4608 : index
    %local_k = index.sub %row, %c4096 : index
    %local_v = index.sub %row, %c4608 : index
    %local = scf.select %is_k, %local_k, %local_v : index
    %bounded = index.assume %local [range(%local, 0, 511)] : index
    %origin = index.scale %bounded, %row_bytes : index, offset -> offset
    scf.if %is_k {
      %part = func.call @flint_q8_0_row_dot(%wk, %origin, %x_view, %tokens, %c64, %token, %lane, %lanes) : (buffer, offset, view<[%tokens]x[%c64]x32xf32>, index, index, index, index, index) -> (f32)
      %total = kernel.workgroup.reduce<addf> %part : f32
      scf.if %first {
        func.call @flint_store_row(%k, %tokens, %c512, %token, %bounded, %total, %zero_i32) : (buffer, index, index, index, index, f32, i32)
      }
    } else {
      %part = func.call @flint_q8_0_row_dot(%wv, %origin, %x_view, %tokens, %c64, %token, %lane, %lanes) : (buffer, offset, view<[%tokens]x[%c64]x32xf32>, index, index, index, index, index) -> (f32)
      %total = kernel.workgroup.reduce<addf> %part : f32
      scf.if %first {
        func.call @flint_store_row(%v, %tokens, %c512, %token, %bounded, %total, %zero_i32) : (buffer, index, index, index, index, f32, i32)
      }
    }
  }
  kernel.return
}

func.def inline @flint_silu_mul(%g: f32, %u: f32) -> (f32) {
  %one = scalar.constant 1.0 : f32
  %neg = scalar.negf %g : f32
  %e = scalar.expf<afn> %neg : f32
  %den = scalar.addf %one, %e : f32
  %silu = scalar.divf %g, %den : f32
  %value = scalar.mulf %silu, %u : f32
  func.return %value : f32
}

// out[t, j] = silu(gate[j] . x[t]) * (up[j] . x[t]) for Q8_0 rows of 2048.
kernel.def export("flint_gate_up_q8_0") @flint_gate_up_q8_0(%n: index, %tokens: index) {
  %c1 = index.constant 1 : index
  %c32 = index.constant 32 : index
  kernel.launch.config workgroups(%n, %tokens, %c1) workgroup_size(%c32, %c1, %c1) : index
} launch(%n_arg: index, %tokens_arg: index, %x: buffer, %gate: buffer, %up: buffer, %out: buffer) {
  %n = index.assume %n_arg [range(%n_arg, 1, 65536)] : index
  %tokens = index.assume %tokens_arg [range(%tokens_arg, 1, 8192)] : index
  %row_id = kernel.workgroup.id<x> : index
  %row = index.assume %row_id [lt(%row_id, %n)] : index
  %token_id = kernel.workgroup.id<y> : index
  %token = index.assume %token_id [lt(%token_id, %tokens)] : index
  %lane = kernel.workitem.id<x> : index
  %lanes = kernel.workgroup.size<x> : index
  %c0 = index.constant 0 : index
  %c64 = index.constant 64 : index
  %zero = index.constant 0 : offset
  %zero_i32 = scalar.constant 0 : i32
  %row_bytes = index.constant 2176 : offset
  %origin = index.scale %row, %row_bytes : index, offset -> offset
  %x_view = buffer.view %x[%zero] : buffer -> view<[%tokens]x[%c64]x32xf32>
  %gp = func.call @flint_q8_0_row_dot(%gate, %origin, %x_view, %tokens, %c64, %token, %lane, %lanes) : (buffer, offset, view<[%tokens]x[%c64]x32xf32>, index, index, index, index, index) -> (f32)
  %upp = func.call @flint_q8_0_row_dot(%up, %origin, %x_view, %tokens, %c64, %token, %lane, %lanes) : (buffer, offset, view<[%tokens]x[%c64]x32xf32>, index, index, index, index, index) -> (f32)
  %g = kernel.workgroup.reduce<addf> %gp : f32
  %u = kernel.workgroup.reduce<addf> %upp : f32
  %first = index.cmp eq, %lane, %c0 : index
  scf.if %first {
    %value = func.call @flint_silu_mul(%g, %u) : (f32, f32) -> (f32)
    func.call @flint_store_row(%out, %tokens, %n, %token, %row, %value, %zero_i32) : (buffer, index, index, index, index, f32, i32)
  }
  kernel.return
}

// Same as flint_gate_up_q8_0 for the dense Q4_K FFN (rows of 2048).
kernel.def export("flint_gate_up_q4_k") @flint_gate_up_q4_k(%n: index, %tokens: index) {
  %c1 = index.constant 1 : index
  %c32 = index.constant 32 : index
  kernel.launch.config workgroups(%n, %tokens, %c1) workgroup_size(%c32, %c1, %c1) : index
} launch(%n_arg: index, %tokens_arg: index, %x: buffer, %gate: buffer, %up: buffer, %out: buffer) {
  %n = index.assume %n_arg [range(%n_arg, 1, 65536)] : index
  %tokens = index.assume %tokens_arg [range(%tokens_arg, 1, 8192)] : index
  %row_id = kernel.workgroup.id<x> : index
  %row = index.assume %row_id [lt(%row_id, %n)] : index
  %token_id = kernel.workgroup.id<y> : index
  %token = index.assume %token_id [lt(%token_id, %tokens)] : index
  %lane = kernel.workitem.id<x> : index
  %lanes = kernel.workgroup.size<x> : index
  %c0 = index.constant 0 : index
  %c64 = index.constant 64 : index
  %zero = index.constant 0 : offset
  %zero_i32 = scalar.constant 0 : i32
  %row_bytes = index.constant 1152 : offset
  %origin = index.scale %row, %row_bytes : index, offset -> offset
  %x_view = buffer.view %x[%zero] : buffer -> view<[%tokens]x[%c64]x32xf32>
  %gp = func.call @flint_q4_k_row_dot(%gate, %origin, %x_view, %tokens, %c64, %token, %lane, %lanes) : (buffer, offset, view<[%tokens]x[%c64]x32xf32>, index, index, index, index, index) -> (f32)
  %upp = func.call @flint_q4_k_row_dot(%up, %origin, %x_view, %tokens, %c64, %token, %lane, %lanes) : (buffer, offset, view<[%tokens]x[%c64]x32xf32>, index, index, index, index, index) -> (f32)
  %g = kernel.workgroup.reduce<addf> %gp : f32
  %u = kernel.workgroup.reduce<addf> %upp : f32
  %first = index.cmp eq, %lane, %c0 : index
  scf.if %first {
    %value = func.call @flint_silu_mul(%g, %u) : (f32, f32) -> (f32)
    func.call @flint_store_row(%out, %tokens, %n, %token, %row, %value, %zero_i32) : (buffer, index, index, index, index, f32, i32)
  }
  kernel.return
