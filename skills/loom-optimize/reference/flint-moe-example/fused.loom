  vector.store %half, %x16_view[%row, %lane, %c0] : vector<8xf16>, view<[%rows]x256x8xf16>
  %first = index.cmp eq, %lane, %c0 : index
  scf.if %first {
    %s_view = buffer.view %scales[%zero] : buffer -> view<[%rows]x2xf32>
    view.store %scale, %s_view[%row, %c0] : f32, view<[%rows]x2xf32>
    %c1 = index.constant 1 : index
    view.store %inverse, %s_view[%row, %c1] : f32, view<[%rows]x2xf32>
  }
  kernel.return
}

// Prefill router logits as a tiled F32 GEMM: workgroup = 64 tokens x 256
// experts; thread t computes tokens (t/32)*8..+8 x experts (t%32)*8..+8.
// K advances 16 at a time through workgroup memory. F32 keeps expert
// selection identical to the per-token path.
kernel.def export("flint_router_gemm") @flint_router_gemm(%tokens: index) {
  %c1 = index.constant 1 : index
  %c64 = index.constant 64 : index
  %c256 = index.constant 256 : index
  %tiles = index.div %tokens, %c64 : index
  kernel.launch.config workgroups(%tiles, %c1, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%tokens_arg: index, %h: buffer, %w: buffer, %logits: buffer) {
  %tokens = index.assume %tokens_arg [range(%tokens_arg, 64, 8192), multiple_of(%tokens_arg, 64)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c64 = index.constant 64 : index
  %c128 = index.constant 128 : index
  %zero = index.constant 0 : offset
  %tile_count = index.div %tokens, %c64 : index
  %tile_id = kernel.workgroup.id<x> : index
  %tile = index.assume %tile_id [lt(%tile_id, %tile_count)] : index
  %t_id = kernel.workitem.id<x> : index
  %t = index.assume %t_id [range(%t_id, 0, 255)] : index
  %token_group = index.div %t, %c32 : index
  %expert_group = index.rem %t, %c32 : index
  %token0 = index.mul %token_group, %c8 : index
  %expert0 = index.mul %expert_group, %c8 : index
  %h_view = buffer.view %h[%zero] : buffer -> view<[%tokens]x2048xf32>
  %w_view = buffer.view %w[%zero] : buffer -> view<256x2048xf32>
  %h_bytes = index.constant 4352 : offset
  %w_bytes = index.constant 17408 : offset
  %h_stage = buffer.alloca<workgroup> align(16) %h_bytes : buffer
  %w_stage = buffer.alloca<workgroup> align(16) %w_bytes : buffer
  %hs = buffer.view %h_stage[%zero] : buffer -> view<16x68xf32>
  %ws = buffer.view %w_stage[%zero] : buffer -> view<16x272xf32>
