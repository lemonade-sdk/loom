      %dq1_shifted = vector.shrui %dq1_packed, %dq1_shift : vector<4xi32>
      %dq1_masked = vector.andi %dq1_shifted, %nibble_mask : vector<4xi32>
      %dq1_bytes = vector.bitcast %dq1_masked : vector<4xi32> to vector<16xi8>
      %dq1_codes = vector.uitofp %dq1_bytes : vector<16xi8> to vector<16xf16>
      %dq1_scale_h = scalar.fptrunc %dq1_scale : f32 to f16
      %dq1_neg_min = scalar.negf %dq1_minimum : f32
      %dq1_neg_min_h = scalar.fptrunc %dq1_neg_min : f32 to f16
      %dq1_scales = vector.splat %dq1_scale_h : vector<16xf16>
      %dq1_minima = vector.splat %dq1_neg_min_h : vector<16xf16>
      %dq1 = vector.fmaf %dq1_codes, %dq1_scales, %dq1_minima : vector<16xf16>
    vector.store %dq0, %w_stage_view[%stage_row, %stage_col] : vector<16xf16>, view<64x72xf16>
    vector.store %dq1, %w2_stage_view[%stage_row, %stage_col] : vector<16xf16>, view<64x72xf16>
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %fk0 = index.constant 0 : index
    %lhs0 = vector.fragment.load<lhs> %a_stage_view[%wave_row, %fk0] shape [%c16, %c16] : view<32x72xf16> -> vector<16xf16>
    %fr0_0_c = index.constant 0 : index
    %fr0_0_a = index.add %wave_col, %fr0_0_c : index
    %fr0_0 = index.add %fr0_0_a, %lane_row : index
    %gv0_0 = vector.load %w_stage_view[%fr0_0, %fk0] : view<64x72xf16> -> vector<16xf16>
    %uv0_0 = vector.load %w2_stage_view[%fr0_0, %fk0] : view<64x72xf16> -> vector<16xf16>
    %gf0_0 = vector.fragment<rhs> %gv0_0 shape [%c16, %c16] : vector<16xf16>
    %uf0_0 = vector.fragment<rhs> %uv0_0 shape [%c16, %c16] : vector<16xf16>
    %mg0_0 = vector.mma %lhs0, %gf0_0, %xg0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %mu0_0 = vector.mma %lhs0, %uf0_0, %xu0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %fk1 = index.constant 16 : index
    %lhs1 = vector.fragment.load<lhs> %a_stage_view[%wave_row, %fk1] shape [%c16, %c16] : view<32x72xf16> -> vector<16xf16>
    %fr0_1_c = index.constant 0 : index
    %fr0_1_a = index.add %wave_col, %fr0_1_c : index
    %fr0_1 = index.add %fr0_1_a, %lane_row : index
    %gv0_1 = vector.load %w_stage_view[%fr0_1, %fk1] : view<64x72xf16> -> vector<16xf16>
    %uv0_1 = vector.load %w2_stage_view[%fr0_1, %fk1] : view<64x72xf16> -> vector<16xf16>
    %gf0_1 = vector.fragment<rhs> %gv0_1 shape [%c16, %c16] : vector<16xf16>
    %uf0_1 = vector.fragment<rhs> %uv0_1 shape [%c16, %c16] : vector<16xf16>
    %mg0_1 = vector.mma %lhs1, %gf0_1, %mg0_0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %mu0_1 = vector.mma %lhs1, %uf0_1, %mu0_0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %fk2 = index.constant 32 : index
    %lhs2 = vector.fragment.load<lhs> %a_stage_view[%wave_row, %fk2] shape [%c16, %c16] : view<32x72xf16> -> vector<16xf16>
    %fr0_2_c = index.constant 0 : index
    %fr0_2_a = index.add %wave_col, %fr0_2_c : index
    %fr0_2 = index.add %fr0_2_a, %lane_row : index
    %gv0_2 = vector.load %w_stage_view[%fr0_2, %fk2] : view<64x72xf16> -> vector<16xf16>
    %uv0_2 = vector.load %w2_stage_view[%fr0_2, %fk2] : view<64x72xf16> -> vector<16xf16>
    %gf0_2 = vector.fragment<rhs> %gv0_2 shape [%c16, %c16] : vector<16xf16>
    %uf0_2 = vector.fragment<rhs> %uv0_2 shape [%c16, %c16] : vector<16xf16>
    %mg0_2 = vector.mma %lhs2, %gf0_2, %mg0_1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %mu0_2 = vector.mma %lhs2, %uf0_2, %mu0_1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %fk3 = index.constant 48 : index
    %lhs3 = vector.fragment.load<lhs> %a_stage_view[%wave_row, %fk3] shape [%c16, %c16] : view<32x72xf16> -> vector<16xf16>
    %fr0_3_c = index.constant 0 : index
    %fr0_3_a = index.add %wave_col, %fr0_3_c : index
    %fr0_3 = index.add %fr0_3_a, %lane_row : index
    %gv0_3 = vector.load %w_stage_view[%fr0_3, %fk3] : view<64x72xf16> -> vector<16xf16>
    %uv0_3 = vector.load %w2_stage_view[%fr0_3, %fk3] : view<64x72xf16> -> vector<16xf16>
    %gf0_3 = vector.fragment<rhs> %gv0_3 shape [%c16, %c16] : vector<16xf16>
    %uf0_3 = vector.fragment<rhs> %uv0_3 shape [%c16, %c16] : vector<16xf16>
    %mg0_3 = vector.mma %lhs3, %gf0_3, %mg0_2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %mu0_3 = vector.mma %lhs3, %uf0_3, %mu0_2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    scf.yield %mg0_3, %mu0_3 : vector<8xf32>, vector<8xf32>
  }
  %inv_bytes = index.constant 2048 : offset
  %inv_tile = buffer.alloca<workgroup> align(16) %inv_bytes : buffer
  %inv_view = buffer.view %inv_tile[%origin] : buffer -> view<32x16xf32>
  %writer = index.cmp ult, %workitem, %cR : index
  scf.if %writer {
    %bw = index.assume %workitem [range(%workitem, 0, 31)] : index
    %ir_value = index.add %tile_row0, %bw : index
    %ir = index.assume %ir_value [lt(%ir_value, %padded_rows)] : index
    %ia = view.load %rowmap_view[%ir] : view<[%padded_rows]xi32> -> i32
    %iv = scalar.cmpi sge, %ia, %c0_i32 : i32
    %ic = scalar.maxsi %ia, %c0_i32 : i32
    %ib = scalar.assume %ic [range(%ic, 0, 49151)] : i32
    %ii = index.cast %ib : i32 to index
    %it_value = index.div %ii, %c6 : index
    %it = index.assume %it_value [lt(%it_value, %tokens)] : index
    %iraw = view.load %s_view[%it, %c1] : view<[%tokens]x2xf32> -> f32
    %one = scalar.constant 1.0 : f32
    %inverse = scf.select %iv, %iraw, %one : f32
    %inverse16 = vector.splat %inverse : vector<16xf32>
    vector.store %inverse16, %inv_view[%bw, %c0] : vector<16xf32>, view<32x16xf32>
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %inv_frag = vector.fragment.load<result> %inv_view[%wave_row, %c0] shape [%c16, %c16] : view<32x16xf32> -> vector<8xf32>
  %y_layout = encoding.layout.strided [%n, %c1] : encoding<layout>
  %tile_first = index.mul %tile_row0, %n : index
  %tile_offset = index.scale %tile_first, %four : index, offset -> offset
  %y_view = buffer.view %y[%tile_offset] : buffer -> view<32x512xf32, %y_layout>
  %gs0 = vector.mulf %rg0, %inv_frag : vector<8xf32>
  %us0 = vector.mulf %ru0, %inv_frag : vector<8xf32>
  %sg0 = vector.siluf<afn> %gs0 : vector<8xf32>
  %out0 = vector.mulf %sg0, %us0 : vector<8xf32>
  %oc0_c = index.constant 0 : index
  %oc0_p = index.add %oc0_c, %part_origin : index
  %oc0 = index.add %oc0_p, %wave_col : index
  vector.fragment.store<result> %out0, %y_view[%wave_row, %oc0] shape [%c16, %c16] : vector<8xf32>, view<32x512xf32, %y_layout>
  }
  kernel.return
}

kernel.def export("flint_moe_down_grouped") @flint_moe_down_grouped(%max_tiles: index) {
  %c1 = index.constant 1 : index
  %c256 = index.constant 256 : index
  %out_tiles = index.constant 2 : index
  kernel.launch.config workgroups(%max_tiles, %out_tiles, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%max_tiles_arg: index, %tokens_arg: index, %a: buffer, %scales: buffer, %tile_info: buffer, %rowmap: buffer, %w: buffer, %y: buffer) {
  %max_tiles = index.assume %max_tiles_arg [range(%max_tiles_arg, 1, 65536)] : index
  %tokens = index.assume %tokens_arg [range(%tokens_arg, 1, 8192)] : index
  %origin = index.constant 0 : offset
  %sixteen = index.constant 16 : offset
  %four = index.constant 4 : offset
  %block_bytes = index.constant 144 : offset
  %expert_bytes = index.constant 589824 : offset
  %w_row_bytes = index.constant 288 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c64 = index.constant 64 : index
  %c128 = index.constant 128 : index
  %c256 = index.constant 256 : index
  %n = index.constant 2048 : index
  %c0_i32 = scalar.constant 0 : i32
  %nibble_mask = vector.constant 252645135 : vector<4xi32>
  %tile_id = kernel.workgroup.id<x> : index
  %tile = index.assume %tile_id [lt(%tile_id, %max_tiles)] : index
  %out_part_id = kernel.workgroup.id<y> : index
  %out_part = index.assume %out_part_id [range(%out_part_id, 0, 1)] : index
  %info_view = buffer.view %tile_info[%origin] : buffer -> view<[%max_tiles]x2xi32>
  %expert32 = view.load %info_view[%tile, %c0] : view<[%max_tiles]x2xi32> -> i32
  %live = scalar.cmpi sge, %expert32, %c0_i32 : i32
  scf.if %live {
  %expert_bound = scalar.assume %expert32 [range(%expert32, 0, 255)] : i32
  %expert = index.cast %expert_bound : i32 to index
  %expert_origin = index.scale %expert, %expert_bytes : index, offset -> offset
  %workitem_id = kernel.workitem.id<x> : index
  %workitem = index.assume %workitem_id [range(%workitem_id, 0, 255)] : index
  %subgroup = kernel.subgroup.id : index
  %bounded_subgroup = index.assume %subgroup [range(%subgroup, 0, 7)] : index
  %lane = kernel.subgroup.lane.id : index
  %lane_row = index.rem %lane, %c16 : index
  %wave_row_group = index.div %bounded_subgroup, %c4 : index
  %wave_col_group = index.rem %bounded_subgroup, %c4 : index
  %wave_row_value = index.mul %wave_row_group, %c16 : index
  %wave_row = index.assume %wave_row_value [range(%wave_row_value, 0, 16)] : index
  %wave_col_value = index.mul %wave_col_group, %c32 : index
  %wave_col = index.assume %wave_col_value [range(%wave_col_value, 0, 96)] : index
  %w_frag_row0 = index.add %wave_col, %lane_row : index
  %w_frag_row1 = index.add %w_frag_row0, %c16 : index
  %padded_rows = index.mul %max_tiles, %c32 : index
  %tile_row0 = index.mul %tile, %c32 : index
  %a_view = buffer.view %a[%origin] : buffer -> view<[%padded_rows]x512xf32>
  %s_view = buffer.view %scales[%origin] : buffer -> view<[%padded_rows]x2xf32>
  %a_bytes = index.constant 33280 : offset
  %a_stage = buffer.alloca<workgroup> align(16) %a_bytes : buffer
  %a_stage_view = buffer.view %a_stage[%origin] : buffer -> view<32x520xf16>
  %w_bytes = index.constant 18432 : offset
  %w_stage = buffer.alloca<workgroup> align(16) %w_bytes : buffer
  %w_stage_view = buffer.view %w_stage[%origin] : buffer -> view<128x72xf16>
  // Stage the whole A tile: thread t takes row t/8, columns (t%8)*64.
  %a_row_value = index.div %workitem, %c8 : index
  %a_row = index.assume %a_row_value [range(%a_row_value, 0, 31)] : index
  %a_seg = index.rem %workitem, %c8 : index
  %a_col = index.mul %a_seg, %c64 : index
  %a_row_global_value = index.add %tile_row0, %a_row : index
  %a_row_global = index.assume %a_row_global_value [lt(%a_row_global_value, %padded_rows)] : index
  %a_raw = vector.load %a_view[%a_row_global, %a_col] : view<[%padded_rows]x512xf32> -> vector<64xf32>
  %sc = view.load %s_view[%a_row_global, %c0] : view<[%padded_rows]x2xf32> -> f32
  %scv = vector.splat %sc : vector<64xf32>
  %a_scaled = vector.mulf %a_raw, %scv : vector<64xf32>
  %a_half = vector.fptrunc %a_scaled : vector<64xf32> to vector<64xf16>
  vector.store %a_half, %a_stage_view[%a_row, %a_col] : vector<64xf16>, view<32x520xf16>
  %inv_bytes = index.constant 2048 : offset
  %inv_tile = buffer.alloca<workgroup> align(16) %inv_bytes : buffer
  %group_count = index.constant 8 : index
  %group_base = index.mul %out_part, %group_count : index
  scf.for %og = [%c0 to %group_count step %c1] {
  %out_group_value = index.add %group_base, %og : index
  %out_group = index.assume %out_group_value [range(%out_group_value, 0, 15)] : index
  %out_origin = index.mul %out_group, %c128 : index
  // W staging: thread t dequantizes output row t/2, 32 columns at (t%2)*32.
  %stage_row = index.div %workitem, %c2 : index
  %stage_half = index.rem %workitem, %c2 : index
  %stage_col = index.mul %stage_half, %c32 : index
  %stage_col_b = index.add %stage_col, %c16 : index
  %w_out_row = index.add %out_origin, %stage_row : index
  %w_row_add = index.scale %w_out_row, %w_row_bytes : index, offset -> offset
  %w_row_origin = index.add %expert_origin, %w_row_add : offset
  %zero8 = vector.constant 0.0 : vector<8xf32>
  %init = vector.fragment<init> %zero8 shape [%c16, %c16] : vector<8xf32>
  %k_steps = index.constant 8 : index
  %acc0, %acc1 = scf.for %step = [%c0 to %k_steps step %c1](%x0 = %init : vector<8xf32>, %x1 = %init : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>) {
    %k_origin = index.mul %step, %c64 : index
    %w_col = index.add %k_origin, %stage_col : index

      %deqa_super = index.div %w_col, %c256 : index
      %deqa_within = index.rem %w_col, %c256 : index
      %deqa_group_value = index.div %deqa_within, %c32 : index
      %deqa_group = index.assume %deqa_group_value [range(%deqa_group_value, 0, 7)] : index
      %deqa_in_group = index.rem %deqa_within, %c32 : index
      %deqa_half = index.div %deqa_in_group, %c16 : index
      %deqa_block_add = index.scale %deqa_super, %block_bytes : index, offset -> offset
      %deqa_block_origin = index.add %w_row_origin, %deqa_block_add : offset
      %deqa_header_view = buffer.view %w[%deqa_block_origin] : buffer -> view<4xi32>
      %deqa_header = vector.load %deqa_header_view[0] : view<4xi32> -> vector<4xi32>
      %deqa_scale, %deqa_minimum = func.call @flint_q4_k_scaled_metadata(%deqa_header, %deqa_group) : (vector<4xi32>, index) -> (f32, f32)
      %deqa_page = index.div %deqa_group, %c2 : index
      %deqa_nibble = index.rem %deqa_group, %c2 : index
      %deqa_word_page = index.mul %deqa_page, %c8 : index
      %deqa_word_half = index.mul %deqa_half, %c4 : index
      %deqa_word = index.add %deqa_word_page, %deqa_word_half : index
      %deqa_payload = index.add %deqa_block_origin, %sixteen : offset
      %deqa_words = buffer.view %w[%deqa_payload] : buffer -> view<32xi32>
      %deqa_packed = vector.load %deqa_words[%deqa_word] : view<32xi32> -> vector<4xi32>
      %deqa_shift_bits = index.mul %deqa_nibble, %c4 : index
      %deqa_shift_i32 = index.cast %deqa_shift_bits : index to i32
      %deqa_shift = vector.splat %deqa_shift_i32 : vector<4xi32>
      %deqa_shifted = vector.shrui %deqa_packed, %deqa_shift : vector<4xi32>
      %deqa_masked = vector.andi %deqa_shifted, %nibble_mask : vector<4xi32>
      %deqa_bytes = vector.bitcast %deqa_masked : vector<4xi32> to vector<16xi8>
      %deqa_codes = vector.uitofp %deqa_bytes : vector<16xi8> to vector<16xf16>
      %deqa_scale_h = scalar.fptrunc %deqa_scale : f32 to f16
      %deqa_neg_min = scalar.negf %deqa_minimum : f32
      %deqa_neg_min_h = scalar.fptrunc %deqa_neg_min : f32 to f16
      %deqa_scales = vector.splat %deqa_scale_h : vector<16xf16>
      %deqa_minima = vector.splat %deqa_neg_min_h : vector<16xf16>
      %deqa = vector.fmaf %deqa_codes, %deqa_scales, %deqa_minima : vector<16xf16>
    vector.store %deqa, %w_stage_view[%stage_row, %stage_col] : vector<16xf16>, view<128x72xf16>
    %w_col_b = index.add %k_origin, %stage_col_b : index

      %deqb_super = index.div %w_col_b, %c256 : index
      %deqb_within = index.rem %w_col_b, %c256 : index
      %deqb_group_value = index.div %deqb_within, %c32 : index
      %deqb_group = index.assume %deqb_group_value [range(%deqb_group_value, 0, 7)] : index
      %deqb_in_group = index.rem %deqb_within, %c32 : index
      %deqb_half = index.div %deqb_in_group, %c16 : index
      %deqb_block_add = index.scale %deqb_super, %block_bytes : index, offset -> offset
      %deqb_block_origin = index.add %w_row_origin, %deqb_block_add : offset
      %deqb_header_view = buffer.view %w[%deqb_block_origin] : buffer -> view<4xi32>
      %deqb_header = vector.load %deqb_header_view[0] : view<4xi32> -> vector<4xi32>
      %deqb_scale, %deqb_minimum = func.call @flint_q4_k_scaled_metadata(%deqb_header, %deqb_group) : (vector<4xi32>, index) -> (f32, f32)
      %deqb_page = index.div %deqb_group, %c2 : index
      %deqb_nibble = index.rem %deqb_group, %c2 : index
      %deqb_word_page = index.mul %deqb_page, %c8 : index
      %deqb_word_half = index.mul %deqb_half, %c4 : index
      %deqb_word = index.add %deqb_word_page, %deqb_word_half : index
      %deqb_payload = index.add %deqb_block_origin, %sixteen : offset
      %deqb_words = buffer.view %w[%deqb_payload] : buffer -> view<32xi32>
      %deqb_packed = vector.load %deqb_words[%deqb_word] : view<32xi32> -> vector<4xi32>
      %deqb_shift_bits = index.mul %deqb_nibble, %c4 : index
      %deqb_shift_i32 = index.cast %deqb_shift_bits : index to i32
      %deqb_shift = vector.splat %deqb_shift_i32 : vector<4xi32>
      %deqb_shifted = vector.shrui %deqb_packed, %deqb_shift : vector<4xi32>
      %deqb_masked = vector.andi %deqb_shifted, %nibble_mask : vector<4xi32>
      %deqb_bytes = vector.bitcast %deqb_masked : vector<4xi32> to vector<16xi8>
      %deqb_codes = vector.uitofp %deqb_bytes : vector<16xi8> to vector<16xf16>
      %deqb_scale_h = scalar.fptrunc %deqb_scale : f32 to f16
      %deqb_neg_min = scalar.negf %deqb_minimum : f32
      %deqb_neg_min_h = scalar.fptrunc %deqb_neg_min : f32 to f16
      %deqb_scales = vector.splat %deqb_scale_h : vector<16xf16>
      %deqb_minima = vector.splat %deqb_neg_min_h : vector<16xf16>
      %deqb = vector.fmaf %deqb_codes, %deqb_scales, %deqb_minima : vector<16xf16>
    vector.store %deqb, %w_stage_view[%stage_row, %stage_col_b] : vector<16xf16>, view<128x72xf16>
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %fk0 = index.constant 0 : index
    %ak0 = index.add %k_origin, %fk0 : index
    %lhs0 = vector.fragment.load<lhs> %a_stage_view[%wave_row, %ak0] shape [%c16, %c16] : view<32x520xf16> -> vector<16xf16>
    %ra0 = vector.load %w_stage_view[%w_frag_row0, %fk0] : view<128x72xf16> -> vector<16xf16>
    %rb0 = vector.load %w_stage_view[%w_frag_row1, %fk0] : view<128x72xf16> -> vector<16xf16>
    %fa0 = vector.fragment<rhs> %ra0 shape [%c16, %c16] : vector<16xf16>
    %fb0 = vector.fragment<rhs> %rb0 shape [%c16, %c16] : vector<16xf16>
    %m0_0 = vector.mma %lhs0, %fa0, %x0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %m1_0 = vector.mma %lhs0, %fb0, %x1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %fk1 = index.constant 16 : index
    %ak1 = index.add %k_origin, %fk1 : index
    %lhs1 = vector.fragment.load<lhs> %a_stage_view[%wave_row, %ak1] shape [%c16, %c16] : view<32x520xf16> -> vector<16xf16>
    %ra1 = vector.load %w_stage_view[%w_frag_row0, %fk1] : view<128x72xf16> -> vector<16xf16>
    %rb1 = vector.load %w_stage_view[%w_frag_row1, %fk1] : view<128x72xf16> -> vector<16xf16>
    %fa1 = vector.fragment<rhs> %ra1 shape [%c16, %c16] : vector<16xf16>
    %fb1 = vector.fragment<rhs> %rb1 shape [%c16, %c16] : vector<16xf16>
    %m0_1 = vector.mma %lhs1, %fa1, %m0_0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %m1_1 = vector.mma %lhs1, %fb1, %m1_0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %fk2 = index.constant 32 : index
    %ak2 = index.add %k_origin, %fk2 : index
    %lhs2 = vector.fragment.load<lhs> %a_stage_view[%wave_row, %ak2] shape [%c16, %c16] : view<32x520xf16> -> vector<16xf16>
    %ra2 = vector.load %w_stage_view[%w_frag_row0, %fk2] : view<128x72xf16> -> vector<16xf16>
    %rb2 = vector.load %w_stage_view[%w_frag_row1, %fk2] : view<128x72xf16> -> vector<16xf16>
    %fa2 = vector.fragment<rhs> %ra2 shape [%c16, %c16] : vector<16xf16>
    %fb2 = vector.fragment<rhs> %rb2 shape [%c16, %c16] : vector<16xf16>
    %m0_2 = vector.mma %lhs2, %fa2, %m0_1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %m1_2 = vector.mma %lhs2, %fb2, %m1_1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %fk3 = index.constant 48 : index
    %ak3 = index.add %k_origin, %fk3 : index
    %lhs3 = vector.fragment.load<lhs> %a_stage_view[%wave_row, %ak3] shape [%c16, %c16] : view<32x520xf16> -> vector<16xf16>
    %ra3 = vector.load %w_stage_view[%w_frag_row0, %fk3] : view<128x72xf16> -> vector<16xf16>
    %rb3 = vector.load %w_stage_view[%w_frag_row1, %fk3] : view<128x72xf16> -> vector<16xf16>
    %fa3 = vector.fragment<rhs> %ra3 shape [%c16, %c16] : vector<16xf16>
    %fb3 = vector.fragment<rhs> %rb3 shape [%c16, %c16] : vector<16xf16>
    %m0_3 = vector.mma %lhs3, %fa3, %m0_2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %m1_3 = vector.mma %lhs3, %fb3, %m1_2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    scf.yield %m0_3, %m1_3 : vector<8xf32>, vector<8xf32>
  }
  %inv_view = buffer.view %inv_tile[%origin] : buffer -> view<32x16xf32>
  %writer = index.cmp ult, %workitem, %c32 : index
  scf.if %writer {
    %bw = index.assume %workitem [range(%workitem, 0, 31)] : index
    %ir_value = index.add %tile_row0, %bw : index
    %ir = index.assume %ir_value [lt(%ir_value, %padded_rows)] : index
    %inverse = view.load %s_view[%ir, %c1] : view<[%padded_rows]x2xf32> -> f32
    %inverse16 = vector.splat %inverse : vector<16xf32>
    vector.store %inverse16, %inv_view[%bw, %c0] : vector<16xf32>, view<32x16xf32>
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %inv_frag = vector.fragment.load<result> %inv_view[%wave_row, %c0] shape [%c16, %c16] : view<32x16xf32> -> vector<8xf32>
  %r0 = vector.mulf %acc0, %inv_frag : vector<8xf32>
  %r1 = vector.mulf %acc1, %inv_frag : vector<8xf32>
  %y_layout = encoding.layout.strided [%n, %c1] : encoding<layout>
  %tile_first = index.madd %tile_row0, %n, %out_origin : index
  %tile_offset = index.scale %tile_first, %four : index, offset -> offset
  %y_view = buffer.view %y[%tile_offset] : buffer -> view<32x128xf32, %y_layout>
  %wave_col1 = index.add %wave_col, %c16 : index
  vector.fragment.store<result> %r0, %y_view[%wave_row, %wave_col] shape [%c16, %c16] : vector<8xf32>, view<32x128xf32, %y_layout>
  vector.fragment.store<result> %r1, %y_view[%wave_row, %wave_col1] shape [%c16, %c16] : vector<8xf32>, view<32x128xf32, %y_layout>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  }
  }
  kernel.return
}
